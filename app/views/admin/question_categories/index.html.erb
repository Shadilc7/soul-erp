<div class="container-fluid px-4 py-4">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
      <h2 class="h3 font-weight-bold text-dark mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-journal-bookmark text-primary"></i> Question Categories
      </h2>
      <p class="text-muted mb-0">Manage category modules inside Question Banks and split questions into dynamic section bundles.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <%= link_to admin_question_banks_path, class: "btn btn-outline-secondary rounded-3 px-3 py-2" do %>
        <i class="bi bi-bank me-1"></i> Manage Question Banks
      <% end %>
      <%= link_to new_admin_question_category_path(question_bank_id: params[:question_bank_id]), class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Create Category</span>
      <% end %>
    </div>
  </div>

  <!-- KPI Metrics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center">
          <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-folder2-open fs-4"></i>
          </div>
          <div>
            <span class="text-muted small fw-medium d-block">Total Categories</span>
            <span class="h4 mb-0 font-weight-bold text-dark"><%= @total_categories_count %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center">
          <div class="rounded-3 bg-success-subtle text-success p-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-check-circle fs-4"></i>
          </div>
          <div>
            <span class="text-muted small fw-medium d-block">Active Categories</span>
            <span class="h4 mb-0 font-weight-bold text-dark"><%= @active_categories_count %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center">
          <div class="rounded-3 bg-info-subtle text-info p-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-question-circle fs-4"></i>
          </div>
          <div>
            <span class="text-muted small fw-medium d-block">Bank Questions</span>
            <span class="h4 mb-0 font-weight-bold text-dark"><%= @total_questions_count %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center">
          <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-layers fs-4"></i>
          </div>
          <div>
            <span class="text-muted small fw-medium d-block">Custom Bundles</span>
            <span class="h4 mb-0 font-weight-bold text-dark"><%= @total_bundles_count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Toolbar -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3">
      <%= form_with url: admin_question_categories_path, method: :get, class: "row g-3 align-items-center" do |f| %>
        <div class="col-12 col-md-4">
          <%= f.select :question_bank_id, options_from_collection_for_select(@question_banks, :id, :name, params[:question_bank_id]), { prompt: "All Question Banks" }, { class: "form-select bg-light", onchange: "this.form.submit()" } %>
        </div>
        <div class="col-12 col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <%= f.text_field :search, value: params[:search], class: "form-control bg-light border-start-0 ps-0", placeholder: "Search category name or description..." %>
          </div>
        </div>
        <div class="col-12 col-md-3 d-flex justify-content-md-end gap-2">
          <% if params[:search].present? || params[:question_bank_id].present? %>
            <%= link_to admin_question_categories_path, class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 rounded-3" do %>
              <i class="bi bi-x-circle"></i> Clear Filter
            <% end %>
          <% end %>
          <button type="submit" class="btn btn-secondary btn-sm px-3 rounded-3">Search</button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Categories Table Card -->
  <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
      <h5 class="card-title font-weight-bold mb-0 text-dark">
        <% if @selected_bank %>
          Categories in "<%= @selected_bank.name %>"
        <% else %>
          All Question Categories
        <% end %>
      </h5>
      <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2"><%= @categories.size %> total</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light border-bottom">
          <tr>
            <th class="ps-4" style="width: 50px;">#</th>
            <th>Question Bank</th>
            <th>Category Name</th>
            <th>Duration</th>
            <th>Questions</th>
            <th>Custom Bundles</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @categories.any? %>
            <% @categories.each_with_index do |cat, index| %>
              <tr>
                <td class="ps-4 text-muted small fw-semibold"><%= index + 1 %></td>
                <td>
                  <span class="badge bg-light text-dark border px-2.5 py-1">
                    <i class="bi bi-bank me-1 text-primary"></i> <%= cat.question_bank&.name || "Default" %>
                  </span>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= cat.name %></div>
                  <% if cat.description.present? %>
                    <div class="text-muted small text-truncate" style="max-width: 320px;"><%= cat.description %></div>
                  <% end %>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 fw-semibold">
                    <i class="bi bi-clock-history me-1"></i> <%= cat.duration_days %> days
                  </span>
                </td>
                <td>
                  <span class="badge bg-info-subtle text-info fw-semibold rounded-pill px-2.5 py-1">
                    <i class="bi bi-question-circle me-1"></i> <%= @questions_count_by_category_id[cat.id] || 0 %> questions
                  </span>
                </td>
                <td>
                  <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold rounded-pill px-2.5 py-1">
                    <i class="bi bi-layers me-1"></i> <%= @bundles_count_by_category_id[cat.id] || 0 %> bundles
                  </span>
                </td>
                <td>
                  <% if cat.active? %>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1"><i class="bi bi-dot"></i> Active</span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1"><i class="bi bi-dot"></i> Inactive</span>
                  <% end %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1">
                    <%= link_to builder_admin_question_category_path(cat), class: "btn btn-sm btn-primary d-inline-flex align-items-center gap-1 rounded-3" do %>
                      <i class="bi bi-kanban"></i> <span>Open Builder</span>
                    <% end %>
                    <%= link_to edit_admin_question_category_path(cat), class: "btn btn-sm btn-outline-secondary rounded-3 px-2", title: "Edit Category" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= button_to admin_question_category_path(cat), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete this Category and all its questions/bundles?" }, style: "display: inline-block;" }, class: "btn btn-sm btn-outline-danger rounded-3 px-2", title: "Delete Category" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2 opacity-50"></i>
                <p class="mb-2 fw-medium">No Question Categories found.</p>
                <p class="small text-muted mb-3">Get started by creating your first Question Category.</p>
                <%= link_to new_admin_question_category_path(question_bank_id: params[:question_bank_id]), class: "btn btn-sm btn-primary rounded-3 px-3 py-2" do %>
                  <i class="bi bi-plus-lg me-1"></i> Create Category
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
