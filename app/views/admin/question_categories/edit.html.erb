<div class="container-fluid px-4 py-4" style="max-width: 800px;">
  <div class="mb-4">
    <%= link_to admin_question_categories_path, class: "text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2" do %>
      <i class="bi bi-arrow-left"></i> Back to Question Categories
    <% end %>
    <h2 class="h3 font-weight-bold text-dark mb-1">Edit Question Category</h2>
    <p class="text-muted small">Update settings or date range for <strong><%= @category.name %></strong>.</p>
  </div>

  <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <%= render "form", category: @category %>
  </div>
</div>
