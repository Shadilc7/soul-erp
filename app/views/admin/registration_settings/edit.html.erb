<% content_for :styles do %>
  <style>
    .registration-settings-card {
      background: #ffffff;
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      overflow: hidden;
    }
    .settings-body {
      padding: 2rem;
    }
    .form-section {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
    }
    .form-label-custom {
      font-weight: 700;
      color: #0f172a;
      font-size: 1.05rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .institute-selection-container {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 1.25rem;
      max-height: 420px;
      overflow-y: auto;
    }
    .institute-selection-container::-webkit-scrollbar {
      width: 6px;
    }
    .institute-selection-container::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 10px;
    }
    .institute-selection-container::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    .institute-check-item {
      background: #f8fafc;
      border-radius: 10px;
      padding: 0.85rem 1.15rem;
      margin-bottom: 0.6rem;
      border: 1px solid #e2e8f0;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .institute-check-item:hover {
      background: #ffffff;
      border-color: #3b82f6;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
    }
    .form-check-input-custom {
      width: 20px;
      height: 20px;
      border: 2px solid #cbd5e1;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }
    .form-check-input-custom:checked {
      background-color: #3b82f6;
      border-color: #3b82f6;
    }
    .form-check-label-custom {
      font-size: 0.92rem;
      color: #334155;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      flex-grow: 1;
    }
    .institute-check-item:hover .form-check-label-custom {
      color: #1d4ed8;
    }
    .help-text {
      color: #64748b;
      font-size: 0.875rem;
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      background: #f1f5f9;
      border-radius: 10px;
      border-left: 4px solid #3b82f6;
    }
    .btn-save-settings {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      border: none;
      border-radius: 10px;
      padding: 0.75rem 2rem;
      font-weight: 600;
      font-size: 0.95rem;
      color: white;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    }
    .btn-save-settings:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
      color: white;
    }
    .alert-custom-danger {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .alert-custom-danger h6 {
      color: #dc2626;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    .alert-custom-danger ul {
      margin-bottom: 0;
      padding-left: 1.25rem;
    }
    .alert-custom-danger li {
      color: #b91c1c;
      font-size: 0.875rem;
    }
  </style>
<% end %>

<div class="container-fluid p-0">

  <!-- BREADCRUMB HEADER -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-transparent p-0 mb-0 align-items-center" style="font-size: 0.85rem;">
      <li class="breadcrumb-item"><%= link_to "Dashboard", admin_root_path, class: "text-muted text-decoration-none" %></li>
      <li class="breadcrumb-item text-primary fw-semibold active" aria-current="page">Registration Settings</li>
    </ol>
  </nav>

  <!-- STANDARD PAGE HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
    <div>
      <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-gear-wide-connected text-primary"></i>
        <span>Registration Settings</span>
      </h3>
      <p class="text-muted small mb-0">Configure multi-tenant institute availability for public user registration.</p>
    </div>
  </div>

  <!-- MAIN SETTINGS CARD -->
  <div class="registration-settings-card">
    <div class="settings-body">
    <div class="row">
      <div class="col-md-10 col-lg-9 mx-auto">
        <%= form_with(model: @registration_setting, url: admin_registration_setting_path, method: :patch, local: true) do |f| %>
          <% if @registration_setting.errors.any? %>
            <div class="alert-custom-danger">
              <h6><i class="bi bi-exclamation-triangle me-2"></i>Please fix the following errors:</h6>
              <ul>
                <% @registration_setting.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-section">
            <label class="form-label-custom">
              <i class="bi bi-buildings"></i>
              Select Institutes for Registration
            </label>
            
            <div class="institute-selection-container">
              <% @institutes.each do |institute| %>
                <div class="institute-check-item">
                  <%= check_box_tag 'registration_setting[enabled_institutes][]',
                      institute.id,
                      @registration_setting.enabled_institute_ids.include?(institute.id),
                      class: 'form-check-input-custom',
                      id: "institute_#{institute.id}" %>
                  <%= label_tag "institute_#{institute.id}", 
                      institute.name, 
                      class: 'form-check-label-custom' %>
                </div>
              <% end %>
            </div>
            
            <div class="help-text">
              <i class="bi bi-info-circle me-2"></i>
              Select the institutes that should appear in the registration form for new users
            </div>
          </div>

          <div class="d-flex justify-content-end">
            <%= f.submit "Save Settings", class: "btn btn-save-settings" %>
          </div>
        <% end if @registration_setting.present? %>
      </div>
    </div>
  </div> 
</div>
</div>
