<div class="container-fluid p-0">

  <!-- STANDARD PAGE HEADER (Title on left, CTA Top Right) -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
    <div>
      <h3 class="fw-bold text-dark mb-1">Institutes Directory</h3>
      <p class="text-muted small mb-0">Manage multi-tenant institutes, tenant codes, and administrative access.</p>
    </div>
    <div class="header-actions">
      <%= link_to new_admin_institute_path, class: "btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 shadow-sm fw-medium px-3 py-2 rounded-3 w-100 w-sm-auto" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Register New Institute</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Institutes</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @institutes.count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-buildings"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Institutes</div>
          <div class="h4 fw-bold mb-0 text-success"><%= @institutes.count(&:active?) %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-check-circle"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Inactive / Suspended</div>
          <div class="h4 fw-bold mb-0 text-warning"><%= @institutes.count { |i| !i.active? } %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-pause-circle"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Institute Types</div>
          <div class="h4 fw-bold mb-0 text-info"><%= @institutes.map(&:institution_type).reject(&:blank?).uniq.count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-diagram-3"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN TABLE CARD -->
  <div class="table-card">
    <!-- Header Toolbar: Search & Filter -->
    <div class="table-card-header d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3">
      <div class="search-group">
        <i class="bi bi-search"></i>
        <input type="text" id="instituteSearchInput" class="form-control" placeholder="Search institute by name or code..." onkeyup="filterInstitutesTable()">
      </div>

      <div class="d-flex align-items-center gap-2 status-filter-wrapper">
        <span class="text-muted small fw-medium d-none d-sm-inline">Status:</span>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-secondary active" onclick="setStatusFilter('all', this)">All</button>
          <button type="button" class="btn btn-outline-success" onclick="setStatusFilter('active', this)">Active</button>
          <button type="button" class="btn btn-outline-danger" onclick="setStatusFilter('inactive', this)">Inactive</button>
        </div>
      </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive">
      <table class="table institutes-table align-middle" id="institutesTable">
        <thead>
          <tr>
            <th>Institute</th>
            <th>Tenant Code</th>
            <th>Type</th>
            <th>Contact</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @institutes.empty? %>
            <tr>
              <td colspan="6" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-buildings fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Institutes Found</h6>
                <p class="text-muted small mb-3">Get started by creating your first institute.</p>
                <%= link_to new_admin_institute_path, class: "btn btn-primary btn-sm rounded-2 px-3" do %>
                  <i class="bi bi-plus-lg me-1"></i> Add Institute
                <% end %>
              </td>
            </tr>
          <% else %>
            <% @institutes.each do |institute| %>
              <tr class="institute-row" data-name="<%= institute.name.downcase %>" data-code="<%= (institute.code || '').downcase %>" data-status="<%= institute.active? ? 'active' : 'inactive' %>">
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <div class="institute-avatar">
                      <%= institute.name.presence ? institute.name.strip.first.upcase : 'I' %>
                    </div>
                    <div>
                      <div class="fw-semibold text-dark mb-0" style="font-size: 0.9rem;"><%= institute.name %></div>
                      <div class="text-muted small"><%= institute.email.presence || 'No email provided' %></div>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="code-pill"><%= institute.code %></span>
                </td>

                <td>
                  <% if institute.institution_type.present? %>
                    <span class="badge bg-light text-secondary border px-2 py-1 font-monospace" style="font-size: 0.75rem;">
                      <%= institute.institution_type.titleize %>
                    </span>
                  <% else %>
                    <span class="text-muted small">—</span>
                  <% end %>
                </td>

                <td>
                  <div class="small text-dark fw-medium">
                    <%= institute.contact_number.presence || 'N/A' %>
                  </div>
                  <% if institute.owner_name.present? %>
                    <div class="text-muted extra-small" style="font-size: 0.75rem;">
                      Owner: <%= institute.owner_name %>
                    </div>
                  <% end %>
                </td>

                <td>
                  <% if institute.active? %>
                    <span class="status-badge-active">
                      <i class="bi bi-check-circle-fill"></i> Active
                    </span>
                  <% else %>
                    <span class="status-badge-inactive">
                      <i class="bi bi-x-circle-fill"></i> Inactive
                    </span>
                  <% end %>
                </td>

                <td class="text-end pe-4">
                  <div class="d-flex align-items-center justify-content-end gap-1">
                    <!-- Login as Admin -->
                    <%= link_to login_as_institute_admin_admin_institute_path(institute), 
                                data: { turbo_method: :post, bs_toggle: "tooltip" }, 
                                class: "action-icon-link impersonate", 
                                title: "Login as Institute Admin" do %>
                      <i class="bi bi-box-arrow-in-right"></i>
                    <% end %>

                    <!-- View -->
                    <%= link_to admin_institute_path(institute), 
                                data: { bs_toggle: "tooltip" }, 
                                class: "action-icon-link", 
                                title: "View Details" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <!-- Edit -->
                    <%= link_to edit_admin_institute_path(institute), 
                                data: { bs_toggle: "tooltip" }, 
                                class: "action-icon-link", 
                                title: "Edit Institute" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Filter JavaScript -->
<script>
  let currentStatusFilter = 'all';

  function filterInstitutesTable() {
    const searchVal = document.getElementById('instituteSearchInput').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.institute-row');

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const code = row.getAttribute('data-code') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesSearch = name.includes(searchVal) || code.includes(searchVal);
      const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);

      row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
    });
  }

  function setStatusFilter(status, btnElement) {
    currentStatusFilter = status;
    const btnGroup = btnElement.parentElement;
    btnGroup.querySelectorAll('.btn').forEach(btn => btn.classList.remove('active'));
    btnElement.classList.add('active');
    filterInstitutesTable();
  }
</script>
 