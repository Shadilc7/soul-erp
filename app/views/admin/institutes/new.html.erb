<div class="card card-custom">
  <div class="card-header card-header-custom">
    <h5 class="mb-0">Add New Institute</h5>
  </div>
  
  <div class="card-body">
    <%= form_with(model: [:admin, @institute], local: true, multipart: true) do |f| %>
      <% if @institute.errors.any? %>
        <div class="alert alert-danger">
          <h6>Please fix the following errors:</h6>
          <ul>
            <% @institute.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "Enter institute name" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :code, class: "form-label" %>
            <%= f.text_field :code, class: "form-control", placeholder: "Enter unique code" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "Enter email address" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :contact_number, class: "form-label" %>
            <%= f.text_field :contact_number, class: "form-control", placeholder: "Enter contact number" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :institution_type, "Institution Type" %>
            <%= f.select :institution_type, options_for_select([['School', 'School'], ['Hospital', 'Hospital'], ['Business firm', 'Business firm'], ['Other', 'Other']]), {}, { class: 'form-select' } %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :registered_poc, "Registered POC", class: "form-label" %>
            <%= f.text_field :registered_poc, class: "form-control", placeholder: "Enter point of contact name" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :owner_name, "Owner Name", class: "form-label" %>
            <%= f.text_field :owner_name, class: "form-control", placeholder: "Enter owner name" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :service_started_on, "Service Started On", class: "form-label" %>
            <%= f.date_field :service_started_on, class: "form-control", id: "admin_service_started_on" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :age_of_service, "Age of Service", class: "form-label" %>
            <%= f.text_field :age_of_service, class: "form-control", id: "admin_age_of_service", readonly: true, placeholder: "Auto-calculated from start date" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :billing_type, "Billing Type", class: "form-label" %>
            <%= f.text_field :billing_type, class: "form-control", placeholder: "Enter billing type" %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :expiry_date, "Expiry Date", class: "form-label" %>
            <%= f.date_field :expiry_date, class: "form-control" %>
          </div>
        </div>

        <div class="col-12 mb-3">
          <div class="form-group">
            <%= f.label :address, class: "form-label" %>
            <%= f.text_area :address, class: "form-control", rows: 3, placeholder: "Enter full address" %>
          </div>
        </div>

        <div class="col-12 mb-3">
          <div class="form-group">
            <%= f.label :description, class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "Enter institute description" %>
          </div>
        </div>

        <div class="col-12 mb-3">
          <div class="form-group">
            <%= f.label :other_details, "Other Details", class: "form-label" %>
            <%= f.text_area :other_details, class: "form-control", rows: 3, placeholder: "Enter any additional details" %>
          </div>
        </div>

        <div class="col-12 mb-3">
          <div class="form-group">
            <%= f.label :logo, "Institute Logo", class: "form-label" %>
            <%= f.file_field :logo, class: "form-control", accept: "image/png,image/jpeg,image/gif,image/webp" %>
            <div class="form-text">PNG, JPG or GIF &middot; max 2 MB &middot; Recommended: transparent background &middot; Recommended size: 200&times;200 px</div>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <div class="form-group">
            <%= f.label :active, "Active" %>
            <%= f.check_box :active, { checked: true }, true, false %>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <%= f.submit "Create Institute", class: "btn btn-custom-primary" %>
        <%= link_to "Cancel", admin_institutes_path, class: "btn btn-outline-custom ms-2" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    function calcAgeOfService() {
      var startInput = document.getElementById('admin_service_started_on');
      var ageInput   = document.getElementById('admin_age_of_service');
      if (!startInput || !ageInput || !startInput.value) { ageInput.value = ''; return; }
      var start = new Date(startInput.value);
      var now   = new Date();
      var years  = now.getFullYear()  - start.getFullYear();
      var months = now.getMonth()     - start.getMonth();
      var days   = now.getDate()      - start.getDate();
      if (days   < 0) { months--; days   += new Date(now.getFullYear(), now.getMonth(), 0).getDate(); }
      if (months < 0) { years--;  months += 12; }
      ageInput.value = years + ' yr' + (years !== 1 ? 's' : '') + ' ' + months + ' mo' + (months !== 1 ? 's' : '') + ' ' + days + ' day' + (days !== 1 ? 's' : '');
    }
    var startEl = document.getElementById('admin_service_started_on');
    if (startEl) {
      startEl.addEventListener('change', calcAgeOfService);
      calcAgeOfService();
    }
  })();
</script>