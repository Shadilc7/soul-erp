<% message = local_assigns[:message] %>
<% type = local_assigns[:type] || "success" %>
<div class="toast align-items-center text-bg-<%= type %> border-0 show mb-2" role="alert">
  <div class="d-flex">
    <div class="toast-body d-flex align-items-center gap-2">
      <i class="bi <%= type == 'success' ? 'bi-check-circle-fill' : (type == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-x-circle-fill') %> fs-5"></i>
      <span><%= message %></span>
    </div>
    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
  </div>
  <script>
    (function() {
      const el = document.currentScript.parentElement;
      setTimeout(() => {
        el.classList.remove('show');
        setTimeout(() => el.remove(), 300);
      }, 3500);
    })();
  </script>
</div>
