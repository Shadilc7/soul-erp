<div class="container-fluid px-4 py-4" style="max-width: 900px;">
  <div class="mb-4">
    <%= link_to builder_admin_question_category_path(@category), class: "text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2" do %>
      <i class="bi bi-arrow-left"></i> Back to Builder (<%= @category.name %>)
    <% end %>
    <h2 class="h3 font-weight-bold text-dark mb-1">Create Question in <%= @category.name %></h2>
    <p class="text-muted small">Add a new question to this master category bank.</p>
  </div>

  <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <%= render "form", category: @category, question: @question %>
  </div>
</div>
