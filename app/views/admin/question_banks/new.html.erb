<div class="container px-4 py-4" style="max-width: 720px;">
  <div class="mb-3">
    <%= link_to admin_question_banks_path, class: "text-decoration-none text-muted d-inline-flex align-items-center gap-1.5 fw-medium" do %>
      <i class="bi bi-arrow-left"></i> Back to Question Banks
    <% end %>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom p-4 rounded-top-4">
      <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-bank text-primary"></i> Create Question Bank
      </h4>
      <p class="text-muted small mb-0 mt-1">Add a new container for organizing question categories.</p>
    </div>
    <div class="card-body p-4">
      <%= render "form", question_bank: @question_bank %>
    </div>
  </div>
</div>
