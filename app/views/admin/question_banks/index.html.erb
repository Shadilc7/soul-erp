<% content_for :styles do %>
  <style>
    .action-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .action-btn {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    .action-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.4s, height 0.4s;
    }
    .action-btn:hover::before {
      width: 100px;
      height: 100px;
    }
    .action-btn i {
      font-size: 16px;
      position: relative;
      z-index: 1;
    }
    .btn-view {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .btn-view:hover {
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
      transform: translateY(-2px);
      color: white;
    }
    .btn-edit {
      background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
      color: white;
    }
    .btn-edit:hover {
      box-shadow: 0 4px 14px rgba(234, 2, 233, 0.45);
      transform: translateY(-2px);
      color: white;
    }
    .btn-delete {
      background: linear-gradient(135deg, #ff6b6b 0%, #c92a2a 100%);
      color: white;
    }
    .btn-delete:hover {
      box-shadow: 0 4px 12px rgba(255, 107, 107, 0.4);
      transform: translateY(-2px);
      color: white;
    }
  </style>
<% end %>

<div class="container-fluid px-4 py-4">
  <!-- Page Header -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
      <h1 class="h3 font-weight-bold text-dark mb-1">Question Banks</h1>
      <p class="text-muted small mb-0">Organize master questions into separate banks and categories.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <%= link_to new_admin_question_bank_path, class: "btn btn-primary rounded-3 d-inline-flex align-items-center gap-2 shadow-sm" do %>
        <i class="bi bi-plus-lg"></i> Create Question Bank
      <% end %>
    </div>
  </div>

  <!-- KPI Cards Row -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-3 p-3 bg-primary-subtle text-primary">
            <i class="bi bi-bank fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Question Banks</div>
            <div class="fs-4 fw-bold text-dark"><%= @total_banks_count %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-3 p-3 bg-success-subtle text-success">
            <i class="bi bi-check-circle fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Active Question Banks</div>
            <div class="fs-4 fw-bold text-dark"><%= @active_banks_count %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-3 p-3 bg-info-subtle text-info">
            <i class="bi bi-folder2-open fs-4"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Categories</div>
            <div class="fs-4 fw-bold text-dark"><%= @total_categories_count %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search Filter Bar -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <%= form_with url: admin_question_banks_path, method: :get, local: true, class: "row g-2 align-items-center" do |f| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <%= f.text_field :search, value: params[:search], class: "form-control bg-light border-start-0 ps-0", placeholder: "Search question banks..." %>
          </div>
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
          <%= f.submit "Search", class: "btn btn-dark rounded-3 px-4" %>
          <% if params[:search].present? %>
            <%= link_to "Clear", admin_question_banks_path, class: "btn btn-outline-secondary rounded-3" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Question Banks Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if @question_banks.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-4">Bank Name</th>
                <th>Categories</th>
                <th>Status</th>
                <th>Created Date</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @question_banks.each do |bank| %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-bold text-dark"><%= bank.name %></div>
                    <% if bank.description.present? %>
                      <div class="text-muted small"><%= truncate(bank.description, length: 70) %></div>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to admin_question_categories_path(question_bank_id: bank.id), class: "badge bg-primary-subtle text-primary fw-semibold rounded-pill px-3 py-1.5 text-decoration-none" do %>
                      <i class="bi bi-folder2-open me-1"></i> <%= @categories_count_by_bank_id[bank.id] || 0 %> categories
                    <% end %>
                  </td>
                  <td>
                    <% if bank.active? %>
                      <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1"><i class="bi bi-dot"></i> Active</span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1"><i class="bi bi-dot"></i> Inactive</span>
                    <% end %>
                  </td>
                  <td class="text-muted small"><%= bank.created_at.strftime("%d %b %Y") %></td>
                  <td class="text-end pe-4">
                    <div class="action-buttons justify-content-end">
                      <%= link_to admin_question_categories_path(question_bank_id: bank.id), class: "action-btn btn-view", title: "View Categories" do %>
                        <i class="bi bi-folder2-open"></i>
                      <% end %>
                      <%= link_to edit_admin_question_bank_path(bank), class: "action-btn btn-edit", title: "Edit Bank" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                      <%= button_to admin_question_bank_path(bank), method: :delete, form: { class: "d-inline" }, data: { turbo_confirm: "Are you sure you want to delete Question Bank '#{bank.name}'?" }, class: "action-btn btn-delete", title: "Delete Bank" do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-bank fs-1 text-muted d-block mb-2"></i>
          <h5 class="fw-bold text-dark">No Question Banks Found</h5>
          <p class="text-muted small mb-3">Create your first Question Bank to organize question categories.</p>
          <%= link_to new_admin_question_bank_path, class: "btn btn-primary rounded-3" do %>
            <i class="bi bi-plus-lg me-1"></i> Create Question Bank
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
