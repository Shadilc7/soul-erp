<div class="container py-4 trainer-feedbacks-show">
  <div class="page-header-card mb-4">
    <div class="header-icon">
      <i class="bi bi-chat-square-text"></i>
    </div>
    <div>
      <h4 class="header-title">Feedbacks</h4>
      <p class="header-subtitle"><%= @training_program.title %></p>
    </div>
    <div class="ms-auto">
      <%= link_to trainer_portal_training_program_feedbacks_path, class: "btn-back" do %>
        <i class="bi bi-arrow-left"></i> Back to Programs
      <% end %>
    </div>
  </div>

  <% if @feedbacks.any? %>
    <!-- RATING OVERVIEW & HORIZONTAL DISTRIBUTION CARD -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden rating-analytics-card">
      <div class="card-body p-4">
        <div class="row g-4 align-items-center">
          <!-- Left: Overall Rating Hero -->
          <div class="col-12 col-lg-4 text-center border-lg-end pe-lg-4">
            <div class="rating-hero-wrapper py-2">
              <div class="text-uppercase text-muted fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Overall Rating</div>
              <div class="display-3 fw-bold text-dark mb-1 rating-hero-score"><%= @avg_rating %></div>
              <div class="d-flex justify-content-center align-items-center gap-1 text-warning fs-4 mb-2">
                <% @avg_rating.floor.times do %>
                  <i class="bi bi-star-fill"></i>
                <% end %>
                <% if @avg_rating - @avg_rating.floor >= 0.5 %>
                  <i class="bi bi-star-half"></i>
                  <% (4 - @avg_rating.floor).times do %>
                    <i class="bi bi-star text-light-emphasis"></i>
                  <% end %>
                <% else %>
                  <% (5 - @avg_rating.floor).times do %>
                    <i class="bi bi-star text-light-emphasis"></i>
                  <% end %>
                <% end %>
              </div>
              <div class="text-muted small fw-medium mb-3">
                Based on <strong class="text-dark"><%= @total_feedbacks_count %></strong> <%= "review".pluralize(@total_feedbacks_count) %>
              </div>
              <% if @positive_rating_pct > 0 %>
                <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 bg-success bg-opacity-10 text-success rounded-pill small fw-semibold">
                  <i class="bi bi-patch-check-fill"></i>
                  <span><%= @positive_rating_pct %>% Positive Reviews (4-5 ★)</span>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Right: Horizontal Breakdown Bars (5 to 1 Stars) -->
          <div class="col-12 col-lg-8 ps-lg-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-line-fill text-primary fs-5"></i>
                <h6 class="fw-bold text-dark mb-0">Feedback Rating Distribution</h6>
              </div>
            </div>

            <div class="rating-breakdown-list d-flex flex-column gap-2.5">
              <% @rating_distribution.each do |item| %>
                <% 
                  bar_color_class = case item[:stars]
                                    when 5 then "rating-bar-5"
                                    when 4 then "rating-bar-4"
                                    when 3 then "rating-bar-3"
                                    when 2 then "rating-bar-2"
                                    when 1 then "rating-bar-1"
                                    end
                %>
                <div class="rating-breakdown-row d-flex align-items-center gap-3 p-2 rounded-3">
                  <!-- Star Label -->
                  <div class="rating-star-label d-flex align-items-center gap-1 fw-bold text-secondary flex-shrink-0" style="width: 75px; font-size: 0.875rem;">
                    <span><%= item[:stars] %></span>
                    <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                    <span class="text-muted fw-normal" style="font-size: 0.75rem;"><%= item[:stars] == 1 ? 'star' : 'stars' %></span>
                  </div>

                  <!-- Horizontal Progress Bar -->
                  <div class="progress flex-grow-1 rating-progress-track" style="height: 12px; background-color: #f1f5f9; border-radius: 999px; overflow: hidden; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
                    <div class="progress-bar <%= bar_color_class %>" 
                         role="progressbar" 
                         style="width: <%= item[:percentage] %>%; border-radius: 999px; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);" 
                         aria-valuenow="<%= item[:percentage] %>" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                    </div>
                  </div>

                  <!-- Count and Percentage -->
                  <div class="rating-count-label text-end text-nowrap flex-shrink-0" style="width: 100px;">
                    <span class="fw-bold text-dark small"><%= item[:count] %></span>
                    <span class="text-muted small ms-1" style="font-size: 0.75rem;">(<%= item[:percentage] %>%)</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="table-card">
    <div class="table-card-header">
      <div>
        <h5>Participant Feedbacks</h5>
        <p class="table-subtitle">All feedback submissions for this program</p>
      </div>
      <span class="table-chip"><%= pluralize(@feedbacks.count, "feedback") %></span>
    </div>

    <% if @feedbacks.any? %>
      <div class="table-responsive">
        <table class="table table-hover modern-table">
          <thead>
            <tr>
              <th>Participant</th>
              <th>Rating</th>
              <th>Feedback</th>
              <th>Submitted On</th>
            </tr>
          </thead>
          <tbody>
            <% @feedbacks.each do |feedback| %>
              <tr>
                <td>
                  <div class="participant-cell">
                    <div class="participant-avatar">
                      <%= feedback.participant.user.first_name&.first&.upcase || feedback.participant.user.email.first.upcase %>
                    </div>
                    <div>
                      <div class="participant-name"><%= feedback.participant.user.full_name %></div>
                      <div class="participant-meta"><%= feedback.participant.user.email %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="rating-inline">
                    <span class="rating-score"><%= feedback.rating %>/5</span>
                    <span class="rating-stars">
                      <% feedback.rating.times do %>
                        <i class="bi bi-star-fill"></i>
                      <% end %>
                      <% (5 - feedback.rating).times do %>
                        <i class="bi bi-star"></i>
                      <% end %>
                    </span>
                  </div>
                </td>
                <td>
                  <span class="feedback-text"><%= feedback.content %></span>
                </td>
                <td>
                  <span class="date-text"><%= feedback.created_at.strftime("%b %d, %Y %I:%M %p") %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i class="bi bi-chat-square-text"></i>
        </div>
        <h5 class="empty-title">No Feedbacks Yet</h5>
        <p class="empty-text">Feedback submissions will appear here once participants respond.</p>
      </div>
    <% end %>
  </div>
</div>

<% content_for :styles do %>
  <style>
    .trainer-feedbacks-show {
      max-width: 1400px;
    }
    .page-header-card {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(148, 163, 184, 0.1);
      padding: 1.75rem 2rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .header-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(129, 140, 248, 0.1));
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6366f1;
      font-size: 1.75rem;
      flex-shrink: 0;
    }
    .header-title {
      font-weight: 700;
      color: #1e293b;
      margin: 0;
      font-size: 1.75rem;
      letter-spacing: -0.02em;
    }
    .header-subtitle {
      font-size: 0.95rem;
      color: #94a3b8;
      margin: 0.25rem 0 0;
    }
    .btn-back {
      background: #ffffff;
      border: 1px solid rgba(148, 163, 184, 0.4);
      color: #475569;
      padding: 0.6rem 1.1rem;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    .btn-back:hover {
      border-color: #6366f1;
      color: #6366f1;
      box-shadow: 0 6px 18px rgba(99, 102, 241, 0.12);
      transform: translateY(-2px);
    }

    .table-card {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid rgba(148, 163, 184, 0.1);
      box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
      overflow: hidden;
    }
    .table-card-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(148, 163, 184, 0.1);
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.03), rgba(168, 85, 247, 0.03));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .table-card-header h5 {
      margin: 0;
      font-weight: 700;
      color: #1e293b;
    }
    .table-subtitle {
      margin: 0.25rem 0 0;
      color: #94a3b8;
      font-size: 0.85rem;
    }
    .table-chip {
      background: rgba(99, 102, 241, 0.12);
      color: #4f46e5;
      border-radius: 999px;
      padding: 0.3rem 0.9rem;
      font-weight: 600;
      font-size: 0.8rem;
    }

    .modern-table thead th {
      background: #f8fafc;
      color: #475569;
      font-weight: 600;
      border-bottom: 1px solid rgba(148, 163, 184, 0.2);
      padding: 1rem 1.25rem;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .modern-table tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgba(148, 163, 184, 0.12);
      vertical-align: middle;
      color: #1e293b;
    }
    .modern-table tbody tr:hover {
      background: rgba(99, 102, 241, 0.04);
    }

    .participant-cell {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }
    .participant-avatar {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(99, 102, 241, 0.12);
      color: #4f46e5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .participant-name {
      font-weight: 600;
      color: #0f172a;
    }
    .participant-meta {
      color: #94a3b8;
      font-size: 0.85rem;
    }
    .rating-inline {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .rating-score {
      font-weight: 600;
      color: #0f172a;
    }
    .rating-stars {
      display: inline-flex;
      gap: 0.15rem;
      color: #f59e0b;
      font-size: 0.95rem;
    }
    .rating-stars .bi-star {
      color: #cbd5f5;
    }
    .feedback-text {
      color: #475569;
      display: block;
      max-width: 420px;
      white-space: normal;
    }
    .date-text {
      color: #64748b;
      font-size: 0.9rem;
    }

    .empty-state {
      background: #ffffff;
      border-radius: 20px;
      padding: 4rem 2rem;
      text-align: center;
    }
    .empty-icon {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(168, 85, 247, 0.1));
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }
    .empty-icon i {
      font-size: 3rem;
      color: #94a3b8;
    }
    .empty-title {
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 0.75rem;
    }
    .empty-text {
      color: #64748b;
      margin: 0;
      font-size: 0.95rem;
    }

    @media (max-width: 768px) {
      .page-header-card {
        padding: 1.5rem;
        gap: 0.875rem;
      }
      .header-icon {
        width: 48px;
        height: 48px;
        font-size: 1.5rem;
      }
      .header-title {
        font-size: 1.25rem;
      }
      .btn-back {
        width: 100%;
        justify-content: center;
      }
    }

    .rating-analytics-card {
      background: #ffffff;
      border: 1px solid rgba(148, 163, 184, 0.15) !important;
      box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04) !important;
    }

    .rating-hero-score {
      font-size: clamp(2.75rem, 4.5vw, 3.5rem);
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .border-lg-end {
      border-right: 1px solid rgba(148, 163, 184, 0.15);
    }

    @media (max-width: 991.98px) {
      .border-lg-end {
        border-right: none;
        border-bottom: 1px solid rgba(148, 163, 184, 0.15);
        padding-bottom: 1.5rem;
      }
    }

    .rating-breakdown-row {
      transition: all 0.2s ease;
    }

    .rating-breakdown-row:hover {
      background: rgba(99, 102, 241, 0.05);
      transform: translateX(3px);
    }

    .rating-bar-5 {
      background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    }

    .rating-bar-4 {
      background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
    }

    .rating-bar-3 {
      background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
    }

    .rating-bar-2 {
      background: linear-gradient(90deg, #f97316 0%, #ea580c 100%);
    }

    .rating-bar-1 {
      background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
    }
  </style>
<% end %>
