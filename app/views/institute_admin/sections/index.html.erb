<% 
  total_sections = @sections.size 
  active_sections = @sections.select { |s| s.active? }.size
  total_capacity = @sections.sum { |s| s.capacity || 0 }
  total_participants = @sections.sum { |s| s.participants_count.to_i }
%>

<% content_for :styles do %>
  <style>
    .action-btn {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      transition: all 0.3s ease;
      border: none;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    
    .action-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }
    
    .action-btn:hover::before {
      width: 100px;
      height: 100px;
    }
    
    .action-btn i {
      font-size: 16px;
      position: relative;
      z-index: 1;
    }
    
    .btn-view {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);
    }
    
    .btn-view:hover {
      background: linear-gradient(135deg, #5568d3 0%, #5a3a7f 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(102, 126, 234, 0.4);
      color: white;
    }
    
    .btn-edit {
      background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
      color: white;
      box-shadow: 0 4px 6px rgba(234, 2, 233, 0.3);
    }
    
    .btn-edit:hover {
      background: linear-gradient(135deg, #141c2f 0%, #ea02e9 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(234, 2, 233, 0.4);
      color: white;
    }

    .btn-copy {
      background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
      color: white;
      box-shadow: 0 4px 6px rgba(67, 233, 123, 0.3);
    }
    
    .btn-copy:hover {
      background: linear-gradient(135deg, #38d96a 0%, #2de0c0 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(67, 233, 123, 0.4);
      color: white;
    }

    .btn-reassign {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
      box-shadow: 0 4px 6px rgba(245, 158, 11, 0.3);
    }
    
    .btn-reassign:hover {
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(245, 158, 11, 0.4);
      color: white;
    }
    
    .btn-delete {
      background: linear-gradient(135deg, #ff6b6b 0%, #c92a2a 100%);
      color: white;
      box-shadow: 0 4px 6px rgba(255, 107, 107, 0.3);
    }
    
    .btn-delete:hover {
      background: linear-gradient(135deg, #ee5a5a 0%, #b81919 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(255, 107, 107, 0.4);
      color: white;
    }
    
    .action-btn:active {
      transform: translateY(0);
    }

    td:last-child {
      white-space: nowrap;
    }
    
    /* Modern UI Components */
    .inst-kpi-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 16px;
      padding: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    
    .inst-kpi-icon {
      width: 45px;
      height: 45px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    
    .inst-kpi-icon-primary { background: #e0e7ff; color: #4f46e5; }
    .inst-kpi-icon-success { background: #dcfce7; color: #16a34a; }
    .inst-kpi-icon-info { background: #e0f2fe; color: #0284c7; }
    .inst-kpi-icon-warning { background: #fef3c7; color: #d97706; }
    
    .table-card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      overflow: hidden;
      border: 1px solid rgba(0,0,0,0.05);
    }
    
    .table-card-header {
      padding: 1.25rem;
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    
    .breadcrumb-custom .breadcrumb-item a { color: #6c757d; text-decoration: none; }
  </style>
<% end %>

<div class="container-fluid px-4 py-4">
  <!-- PAGE HEADER & BREADCRUMBS -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom mb-1">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door me-1"></i>Home<% end %></li>
          <li class="breadcrumb-item"><%= link_to "Settings", institute_admin_settings_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Sections</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0">Sections & Batches</h3>
    </div>
    <div class="header-actions d-flex flex-wrap align-items-center gap-2">
      <%= link_to institute_admin_settings_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Settings</span>
      <% end %>

      <%= link_to new_institute_admin_section_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Add Section</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Sections</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= total_sections %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-diagram-3-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Batches</div>
          <div class="h4 fw-bold mb-0 text-success"><%= active_sections %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-check-circle-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Capacity</div>
          <div class="h4 fw-bold mb-0 text-info"><%= total_capacity %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-person-workspace"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Enrolled Participants</div>
          <div class="h4 fw-bold mb-0 text-warning"><%= total_participants %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-people-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN DATA TABLE CARD -->
  <div class="table-card">
    <div class="table-card-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-grid-3x3 text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Section Directory</h6>
      </div>
      <span class="badge bg-light text-secondary border px-2.5 py-1">
        Total <%= @sections.size %> Sections
      </span>
    </div>

    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">#</th>
            <th style="min-width: 140px;">Code</th>
            <th style="min-width: 200px;">Section Name</th>
            <th style="min-width: 120px;">Capacity</th>
            <th style="min-width: 150px;">Participants</th>
            <th style="min-width: 120px;">Status</th>
            <th style="min-width: 180px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @sections.empty? %>
            <tr>
              <td colspan="7" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Sections Found</h6>
                <p class="text-muted small mb-0">Click "Add Section" above to create your first institute batch or section.</p>
              </td>
            </tr>
          <% else %>
            <% @sections.each_with_index do |section, index| %>
              <tr>
                <td class="text-center fw-semibold text-secondary" style="font-size: 0.85rem;"><%= index + 1 %></td>
                <td>
                  <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle font-monospace px-2.5 py-1" style="font-size: 0.78rem;">
                    <%= section.code.presence || 'N/A' %>
                  </span>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= section.name %></div>
                  <% if section.description.present? %>
                    <div class="text-muted small text-truncate" style="max-width: 250px;"><%= section.description %></div>
                  <% end %>
                </td>
                <td>
                  <span class="fw-semibold text-dark"><%= section.capacity || 'Unlimited' %></span>
                </td>
                <td>
                  <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1 fw-semibold">
                    <i class="bi bi-person me-1"></i> <%= pluralize(section.participants_count.to_i, 'Participant') %>
                  </span>
                </td>
                <td>
                  <% if section.active? %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-check-circle-fill me-1"></i> Active
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-exclamation-circle-fill me-1"></i> Inactive
                    </span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="d-flex align-items-center justify-content-center gap-2">
                    <%= link_to institute_admin_section_path(section), class: "btn action-btn btn-view", title: "View Details" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <%= link_to edit_institute_admin_section_path(section), class: "btn action-btn btn-edit", title: "Edit Section" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>

                    <%= button_to duplicate_institute_admin_section_path(section),
                        method: :post,
                        class: "btn action-btn btn-copy",
                        form: { style: 'display: inline-block' },
                        title: "Duplicate Section" do %>
                      <i class="bi bi-copy"></i>
                    <% end %>

                    <% if section.participants_count.to_i > 0 %>
                      <%= link_to reassign_users_institute_admin_section_path(section), 
                          class: "btn action-btn btn-reassign",
                          title: "Reassign Participants" do %>
                        <i class="bi bi-people-fill"></i>
                      <% end %>
                    <% end %>

                    <%= button_to institute_admin_section_path(section),
                        method: :delete,
                        class: "btn action-btn btn-delete",
                        form: { style: 'display: inline-block' },
                        title: "Delete Section",
                        data: { turbo_confirm: "Are you sure you want to delete this section?" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>