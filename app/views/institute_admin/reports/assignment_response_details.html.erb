<div class="container-fluid px-0 pt-3 pb-4">
  <!-- BREADCRUMB & HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb breadcrumb-modern mb-0">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door-fill"></i><% end %></li>
          <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
          <li class="breadcrumb-item"><%= link_to "Assignment Reports", assignment_reports_institute_admin_reports_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Submission Details</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.3px;">Participant Submission Details</h3>
      <p class="text-muted small mb-0 mt-1">Reviewing recorded answers submitted for <%= @selected_date.strftime("%B %d, %Y") %></p>
    </div>
    <div>
      <%= link_to assignment_reports_institute_admin_reports_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Reports</span>
      <% end %>
    </div>
  </div>

  <!-- METADATA CARDS ROW -->
  <div class="row g-3 mb-4">
    <!-- Participant Card -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
          <div class="p-3 rounded-3 bg-primary-subtle text-primary fs-3">
            <i class="bi bi-person-bounding-box"></i>
          </div>
          <div>
            <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.5px;">Participant</div>
            <h6 class="fw-bold text-dark mb-1"><%= @participant.full_name %></h6>
            <div class="text-muted small mb-1"><%= @participant.email %></div>
            <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
              <i class="bi bi-people me-1 text-muted"></i><%= @participant.section&.name || "N/A" %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Assignment Card -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
          <div class="p-3 rounded-3 bg-indigo-subtle text-indigo fs-3">
            <i class="bi bi-journal-check"></i>
          </div>
          <div>
            <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.5px;">Assignment</div>
            <h6 class="fw-bold text-dark mb-1"><%= @assignment.title %></h6>
            <div class="text-muted small">
              <%= @assignment.start_date.strftime("%b %d") %> – <%= @assignment.end_date.strftime("%b %d, %Y") %>
            </div>
            <div class="small text-secondary fw-semibold mt-1">
              Total Duration: <%= @assignment.total_days %> days
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Submission Metrics Card -->
    <div class="col-12 col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
          <div class="p-3 rounded-3 bg-success-subtle text-success fs-3">
            <i class="bi bi-calendar-check-fill"></i>
          </div>
          <div>
            <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.5px;">Submission Info</div>
            <h6 class="fw-bold text-success mb-1">
              <i class="bi bi-check-circle-fill me-1"></i>Submitted
            </h6>
            <div class="fw-semibold text-dark small"><%= @selected_date.strftime("%B %d, %Y") %></div>
            <div class="text-muted small mt-1">
              <strong><%= @answered_count %></strong> of <strong><%= @total_questions_count %></strong> scheduled questions answered
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- QUESTIONS & RECORDED RESPONSES -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-card-checklist text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Submitted Responses Breakdown</h6>
      </div>
      <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">
        <%= @selected_date.strftime("%b %d, %Y") %>
      </span>
    </div>

    <div class="card-body p-4">
      <% if @grouped_questions.present? %>
        <% question_number = 0 %>
        <% @grouped_questions.each do |bundle_name, questions| %>
          <div class="bundle-group mb-4">
            <div class="bundle-header d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
              <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle px-3 py-2 rounded-pill fw-bold fs-6">
                <i class="bi bi-folder2-open me-1"></i><%= bundle_name %>
              </span>
              <span class="text-muted small ms-auto"><%= pluralize(questions.size, 'Question') %></span>
            </div>

            <div class="questions-list d-flex flex-column gap-3">
              <% questions.each do |question| %>
                <% question_number += 1 %>
                <% response = @responses[question.id] %>
                
                <div class="question-detail-card p-3 border rounded-3 bg-white shadow-sm">
                  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge bg-secondary-subtle text-secondary fw-bold">#<%= question_number %></span>
                      <h6 class="mb-0 fw-bold text-dark"><%= question.title %></h6>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold">
                        <i class="bi bi-clock-history me-1"></i><%= question.day_range_text %>
                      </span>
                      <span class="badge bg-light text-secondary border fw-normal text-capitalize">
                        <%= question.question_type.to_s.humanize %>
                      </span>
                    </div>
                  </div>

                  <% if question.description.present? %>
                    <p class="text-muted small mb-2"><%= question.description %></p>
                  <% end %>

                  <!-- Options Preview if present -->
                  <% if question.options.present? %>
                    <div class="options-preview my-2 pt-2 border-top">
                      <small class="text-muted fw-semibold d-block mb-1">Configured Options:</small>
                      <div class="d-flex flex-wrap gap-1.5">
                        <% question.options.each do |option| %>
                          <% opt_text = option.is_a?(Option) ? option.text : option.to_s %>
                          <span class="badge bg-light text-dark border px-2 py-1"><%= opt_text %></span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <!-- Participant's Submitted Answer Box -->
                  <div class="mt-3 p-3 rounded-3 <%= response.present? ? 'bg-success-subtle border border-success-subtle' : 'bg-light border' %>">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                      <div class="d-flex align-items-center gap-1.5 fw-bold small <%= response.present? ? 'text-success' : 'text-muted' %>">
                        <i class="bi <%= response.present? ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"></i>
                        <span>Participant Recorded Answer:</span>
                      </div>
                      <% if response&.submitted_at.present? %>
                        <small class="text-muted" style="font-size: 0.75rem;">
                          Submitted: <%= response.submitted_at.strftime("%I:%M %p") %>
                        </small>
                      <% end %>
                    </div>

                    <div class="text-dark fw-semibold fs-6 ms-3">
                      <% if response.present? %>
                        <% answer_text = response.answer.presence || response.selected_options.join(", ") %>
                        <% if question.question_type == 'rating' %>
                          <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="fs-5 text-warning">
                              <% rating_val = answer_text.to_i %>
                              <% (1..5).each do |star| %>
                                <i class="bi <%= star <= rating_val ? 'bi-star-fill' : 'bi-star' %>"></i>
                              <% end %>
                            </span>
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace px-2 py-1">
                              <%= answer_text %> / 5 Stars
                            </span>
                          </div>
                        <% else %>
                          <div class="p-2 rounded bg-white border border-success-subtle text-dark font-monospace">
                            <%= answer_text %>
                          </div>
                        <% end %>
                      <% else %>
                        <span class="text-muted fst-italic">No response recorded for this question on <%= @selected_date.strftime("%b %d, %Y") %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
          <p class="mb-0">No active questions found for <%= @selected_date.strftime("%B %d, %Y") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :styles do %>
  <style>
    .bg-indigo-subtle { background-color: rgba(99, 102, 241, 0.1) !important; }
    .text-indigo { color: #6366f1 !important; }
    .border-indigo-subtle { border-color: rgba(99, 102, 241, 0.2) !important; }
  </style>
<% end %>
