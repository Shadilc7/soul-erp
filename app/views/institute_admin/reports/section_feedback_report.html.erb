<% content_for :title, @report_title %>

<div class="report-header">
  <h1 class="report-title"><%= @report_title %></h1>
  <p class="institute-name"><%= current_institute.name %></p>
  <p class="generated-date">Generated on <%= Date.current.strftime('%B %d, %Y') %></p>
</div>

<div class="filter-info">
  <table>
    <tr>
      <td>Date Range:</td>
      <td><%= @date_range_text %></td>
    </tr>
    <tr>
      <td>Section:</td>
      <td><%= @section_text %></td>
    </tr>
  </table>
</div>

<% if @submission_status == "submitted" %>
  <% if @submitted_feedbacks.any? %>
    <table class="report-data">
      <thead>
        <tr>
          <th>Date</th>
          <th>Participant</th>
          <th>Section</th>
          <th>Training Program</th>
          <th>Rating</th>
          <th>Content</th>
        </tr>
      </thead>
      <tbody>
        <% @submitted_feedbacks.each do |feedback| %>
          <tr>
            <td><%= feedback.created_at.strftime("%b %d, %Y") %></td>
            <td><%= feedback.participant.full_name %></td>
            <td><%= feedback.participant.section.name %></td>
            <td><%= feedback.training_program.title %></td>
            <td><%= feedback.rating %></td>
            <td><%= feedback.content %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      No submitted feedbacks found for the selected criteria.
    </div>
  <% end %>
<% else %>
  <% if @not_submitted_participants.any? %>
    <table class="report-data">
      <thead>
        <tr>
          <th>Participant</th>
          <th>Section</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        <% @not_submitted_participants.each do |participant| %>
          <tr>
            <td><%= participant.full_name %></td>
            <td><%= participant.section.name %></td>
            <td><%= participant.email %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      No pending submissions found for the selected criteria.
    </div>
  <% end %>
<% end %>
