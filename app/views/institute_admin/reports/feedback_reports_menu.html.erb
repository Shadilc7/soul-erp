<div class="container-fluid px-4 py-4">
  <!-- Modern Header & Breadcrumb Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb breadcrumb-modern mb-0">
          <li class="breadcrumb-item">
            <%= link_to institute_admin_root_path do %>
              <i class="bi bi-house-door"></i>
            <% end %>
          </li>
          <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
          <li class="breadcrumb-item active" aria-current="page">Feedback Reports</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-1">Feedback Insights Hub</h3>
      <p class="text-muted small mb-0">Explore training program feedback aggregations, section ratings, and participant evaluations.</p>
    </div>

    <div>
      <%= link_to institute_admin_reports_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Reports</span>
      <% end %>
    </div>
  </div>

  <!-- Modern Interactive Report Cards Grid -->
  <div class="row g-4 mt-1">
    <!-- Section-wise Feedback Card -->
    <div class="col-12 col-md-6 col-xl-5">
      <div class="report-menu-card card-purple">
        <%= link_to section_feedback_reports_institute_admin_reports_path, class: "card-overlay-link", title: "Open Section-wise Feedback Reports" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-purple">
            <i class="bi bi-chat-square-quote-fill"></i>
          </div>
          <span class="badge badge-purple rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-diagram-3-fill me-1"></i> Section Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Section-wise Feedback Reports</span>
            <i class="bi bi-arrow-right action-arrow text-purple"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Analyze overall section rating averages, program feedback summaries, and section breakdown metrics across all active courses.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-purple fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-star-fill"></i> View Section Feedback
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Individual Feedback Card -->
    <div class="col-12 col-md-6 col-xl-5">
      <div class="report-menu-card card-rose">
        <%= link_to individual_feedback_reports_institute_admin_reports_path, class: "card-overlay-link", title: "Open Individual Feedback Reports" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-rose">
            <i class="bi bi-person-lines-fill"></i>
          </div>
          <span class="badge badge-rose rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-person-heart me-1"></i> Participant Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Individual Feedback Reports</span>
            <i class="bi bi-arrow-right action-arrow text-rose"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Review detailed individual feedback responses, trainer ratings, and qualitative comments submitted by individual participants.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-rose fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-chat-right-text-fill"></i> View Individual Submissions
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Glassmorphic Card Container */
  .report-menu-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-overlay-link {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
  }

  .report-menu-card:hover {
    transform: translateY(-5px) scale(1.01);
    border-color: #cbd5e1;
  }

  /* Purple Variant (Section Feedback) */
  .card-purple:hover {
    box-shadow: 0 12px 28px rgba(139, 92, 246, 0.15);
    border-color: #ddd6fe;
  }

  .icon-purple {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(139, 92, 246, 0.3);
  }

  .badge-purple {
    background-color: #f5f3ff;
    color: #5b21b6;
    border: 1px solid #ddd6fe;
  }

  .text-purple {
    color: #7c3aed !important;
  }

  /* Rose Variant (Individual Feedback) */
  .card-rose:hover {
    box-shadow: 0 12px 28px rgba(236, 72, 153, 0.15);
    border-color: #fbcfe8;
  }

  .icon-rose {
    background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(236, 72, 153, 0.3);
  }

  .badge-rose {
    background-color: #fdf2f8;
    color: #9d174d;
    border: 1px solid #fbcfe8;
  }

  .text-rose {
    color: #db2777 !important;
  }

  /* Icon Wrapper */
  .report-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .report-menu-card:hover .report-icon-wrapper {
    transform: scale(1.1) rotate(-5deg);
  }

  /* Animated Arrow */
  .action-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .report-menu-card:hover .action-arrow {
    transform: translateX(6px);
  }

  .report-card-footer {
    border-color: #f1f5f9 !important;
  }

  .leading-relaxed {
    line-height: 1.6;
  }
</style> 