<!-- Modern Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb breadcrumb-modern mb-0">
    <li class="breadcrumb-item">
      <%= link_to institute_admin_root_path do %>
        <i class="bi bi-house-door"></i>
      <% end %>
    </li>
    <li class="breadcrumb-item"><%= link_to "Reports", institute_admin_reports_path %></li>
    <% if current_page.present? %>
      <li class="breadcrumb-item"><%= link_to "Certificates", certificates_institute_admin_reports_path %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= current_page %></li>
    <% else %>
      <li class="breadcrumb-item active" aria-current="page">Certificates</li>
    <% end %>
  </ol>
</nav> 