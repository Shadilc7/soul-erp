<div class="container-fluid px-4 py-4">
  <!-- Modern Header & Breadcrumb Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <%= render 'certificate_breadcrumb', current_page: nil %>
      <h3 class="fw-bold text-dark mb-1">Certificate Management Hub</h3>
      <p class="text-muted small mb-0">Generate, inspect, and configure credentials and distribution analytics for participants.</p>
    </div>

    <div>
      <%= link_to institute_admin_reports_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2 fw-medium shadow-sm" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Reports</span>
      <% end %>
    </div>
  </div>

  <!-- Modern Interactive Certificate Action Cards Grid -->
  <div class="row g-4 mt-1">
    <!-- Generate Individual Certificate Card -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="report-menu-card card-indigo">
        <%= link_to generate_certificate_institute_admin_reports_path, class: "card-overlay-link", title: "Generate Individual Certificate" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-indigo">
            <i class="bi bi-person-workspace"></i>
          </div>
          <span class="badge badge-indigo rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-plus-circle-fill me-1"></i> Individual Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Generate Individual</span>
            <i class="bi bi-arrow-right action-arrow text-indigo"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Create custom certificates for single participants based on assignment performance and completion criteria.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-indigo fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-award-fill"></i> Issue Single Credential
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Generate Section-Wise Certificate Card -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="report-menu-card card-rose">
        <%= link_to generate_section_certificate_institute_admin_reports_path, class: "card-overlay-link", title: "Generate Section-Wise Certificates" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-rose">
            <i class="bi bi-collection-play-fill"></i>
          </div>
          <span class="badge badge-rose rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-diagram-3-fill me-1"></i> Batch Mode
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Generate Section-Wise</span>
            <i class="bi bi-arrow-right action-arrow text-rose"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Bulk generate certificates for all eligible participants enrolled within a specific section or cohort.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-rose fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-stack"></i> Bulk Generate
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- View Certificates Card -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="report-menu-card card-emerald">
        <%= link_to view_certificates_institute_admin_reports_path, class: "card-overlay-link", title: "View All Generated Certificates" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-emerald">
            <i class="bi bi-patch-check-fill"></i>
          </div>
          <span class="badge badge-emerald rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-folder-fill me-1"></i> Directory
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>View Certificates</span>
            <i class="bi bi-arrow-right action-arrow text-emerald"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Browse, filter, preview, publish, or regenerate existing certificates stored in the institute repository.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-emerald fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-file-earmark-pdf-fill"></i> Browse Credential Logs
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Certificate Statistics Card -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="report-menu-card card-amber">
        <%= link_to certificate_stats_institute_admin_reports_path, class: "card-overlay-link", title: "Certificate Generation Statistics" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-amber">
            <i class="bi bi-bar-chart-line-fill"></i>
          </div>
          <span class="badge badge-amber rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-graph-up me-1"></i> Analytics
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Certificate Statistics</span>
            <i class="bi bi-arrow-right action-arrow text-amber"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Gain insight into certificate issue rates, distribution timeline metrics, and section completion trends.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-amber fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-pie-chart-fill"></i> View Certificate Metrics
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>

    <!-- Certificate Configurations Card -->
    <div class="col-12 col-md-6 col-xl-4">
      <div class="report-menu-card card-cyan">
        <%= link_to institute_admin_certificate_configurations_path, class: "card-overlay-link", title: "Certificate Template Configurations" do %><% end %>
        
        <div class="d-flex align-items-start justify-content-between mb-3">
          <div class="report-icon-wrapper icon-cyan">
            <i class="bi bi-gear-wide-connected"></i>
          </div>
          <span class="badge badge-cyan rounded-pill px-3 py-1.5 fw-semibold">
            <i class="bi bi-sliders me-1"></i> Settings
          </span>
        </div>

        <div class="report-card-content">
          <h5 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
            <span>Certificate Settings</span>
            <i class="bi bi-arrow-right action-arrow text-cyan"></i>
          </h5>
          <p class="text-muted small mb-0 leading-relaxed">
            Configure certificate visual templates, signature uploads, background art, and custom field tokens.
          </p>
        </div>

        <div class="report-card-footer mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
          <span class="text-cyan fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-palette-fill"></i> Customize Templates
          </span>
          <i class="bi bi-chevron-right text-muted small"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Glassmorphic Card Container */
  .report-menu-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-overlay-link {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
  }

  .report-menu-card:hover {
    transform: translateY(-5px) scale(1.01);
    border-color: #cbd5e1;
  }

  /* Indigo Variant */
  .card-indigo:hover {
    box-shadow: 0 12px 28px rgba(99, 102, 241, 0.15);
    border-color: #c7d2fe;
  }
  .icon-indigo {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
  }
  .badge-indigo {
    background-color: #eef2ff;
    color: #4338ca;
    border: 1px solid #c7d2fe;
  }
  .text-indigo { color: #4f46e5 !important; }

  /* Rose Variant */
  .card-rose:hover {
    box-shadow: 0 12px 28px rgba(244, 63, 94, 0.15);
    border-color: #fecdd3;
  }
  .icon-rose {
    background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(244, 63, 94, 0.3);
  }
  .badge-rose {
    background-color: #fff1f2;
    color: #be123c;
    border: 1px solid #fecdd3;
  }
  .text-rose { color: #e11d48 !important; }

  /* Emerald Variant */
  .card-emerald:hover {
    box-shadow: 0 12px 28px rgba(16, 185, 129, 0.15);
    border-color: #a7f3d0;
  }
  .icon-emerald {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
  }
  .badge-emerald {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }
  .text-emerald { color: #059669 !important; }

  /* Amber Variant */
  .card-amber:hover {
    box-shadow: 0 12px 28px rgba(245, 158, 11, 0.15);
    border-color: #fde68a;
  }
  .icon-amber {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.3);
  }
  .badge-amber {
    background-color: #fffbeb;
    color: #b45309;
    border: 1px solid #fde68a;
  }
  .text-amber { color: #d97706 !important; }

  /* Cyan Variant */
  .card-cyan:hover {
    box-shadow: 0 12px 28px rgba(6, 182, 212, 0.15);
    border-color: #a5f3fc;
  }
  .icon-cyan {
    background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(6, 182, 212, 0.3);
  }
  .badge-cyan {
    background-color: #ecfeff;
    color: #0e7490;
    border: 1px solid #a5f3fc;
  }
  .text-cyan { color: #0891b2 !important; }

  /* Icon Wrapper */
  .report-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .report-menu-card:hover .report-icon-wrapper {
    transform: scale(1.1) rotate(-5deg);
  }

  /* Animated Arrow */
  .action-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .report-menu-card:hover .action-arrow {
    transform: translateX(6px);
  }

  .report-card-footer {
    border-color: #f1f5f9 !important;
  }

  .leading-relaxed {
    line-height: 1.6;
  }
</style>