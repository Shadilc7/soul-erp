<% content_for :title, @report_title %>

<div class="report-header">
  <h1 class="report-title"><%= @report_title %></h1>
  <p class="institute-name"><%= current_institute.name %></p>
  <p class="generated-date">Generated on <%= Date.current.strftime('%B %d, %Y') %></p>
</div>

<div class="filter-info">
  <table>
    <tr>
      <td>Date Range:</td>
      <td><%= @date_range_text %></td>
    </tr>
    <tr>
      <td>Participant:</td>
      <td><%= @participant_text %></td>
    </tr>
    <tr>
      <td>Section:</td>
      <td><%= @section_text %></td>
    </tr>
    <tr>
      <td>Training Program:</td>
      <td><%= @assignment_text %></td>
    </tr>
  </table>
</div>

<% if @submission_status == "submitted" %>
  <% if @submitted_feedbacks.any? %>
    <table class="report-data">
      <thead>
        <tr>
          <th>Date</th>
          <th>Training Program</th>
          <th>Rating</th>
          <th>Feedback</th>
        </tr>
      </thead>
      <tbody>
        <% @submitted_feedbacks.each do |feedback| %>
          <tr>
            <td><%= feedback.created_at.strftime("%b %d, %Y") %></td>
            <td><%= feedback.training_program.title %></td>
            <td><%= "★" * feedback.rating %></td>
            <td><%= feedback.content %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      No submitted feedbacks found for the selected criteria.
    </div>
  <% end %>
<% else %>
  <% if @not_submitted_training_programs.any? %>
    <table class="report-data">
      <thead>
        <tr>
          <th>Training Program</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @not_submitted_training_programs.each do |training_program| %>
          <tr>
            <td><%= training_program.title %></td>
            <td><%= training_program.start_date.strftime("%b %d, %Y") %></td>
            <td><%= training_program.end_date.strftime("%b %d, %Y") %></td>
            <td><%= training_program.status.titleize %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      No pending feedbacks found for the selected criteria.
    </div>
  <% end %>
<% end %>
