  function filterFormPoolQuestions(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-pool-question-card').forEach(card => {
      const title = card.dataset.questionTitle || '';
      card.classList.toggle('d-none', q && !title.includes(q));
    });
  }

  function filterFormBundles(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-bundle-card').forEach(card => {
      const nameEl = card.querySelector('[id*="form_bundle_name_display_"]');
      const name = nameEl ? nameEl.textContent.toLowerCase() : '';
      card.classList.toggle('d-none', q && !name.includes(q));
    });
