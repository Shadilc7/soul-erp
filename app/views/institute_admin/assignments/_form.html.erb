  function submitEditFormBundle(e) {
    e.preventDefault();
    const bundleId = document.getElementById('edit_form_bundle_id').value;
    const name = document.getElementById('edit_form_bundle_name').value.trim();
    const fromDay = parseInt(document.getElementById('edit_form_bundle_from_day').value, 10) || 1;
    const toDay = parseInt(document.getElementById('edit_form_bundle_to_day').value, 10) || 30;
    const dayText = (fromDay === toDay) ? `Day ${fromDay}` : `Day ${fromDay}-${toDay}`;

    if (!bundleId || !name) return;

    // Update bundle card UI
    const nameDisplay = document.getElementById(`form_bundle_name_display_${bundleId}`);
    if (nameDisplay) nameDisplay.textContent = name;

    const schedDisplay = document.getElementById(`form_bundle_schedule_display_${bundleId}`);
    if (schedDisplay) schedDisplay.textContent = dayText;

    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (container) {
      container.dataset.bundleName = name;
    }

    // Update hidden inputs for bundle questions
    document.querySelectorAll(`.form-bundle-item-name-input-${bundleId}`).forEach(input => {
      input.value = name;
    });

    // Update dropdown options
    document.querySelectorAll('[class*="form-bundle-assign-select-"]').forEach(select => {
      for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].value == bundleId) {
          select.options[i].textContent = `${name} (${dayText})`;
          select.options[i].dataset.bundleName = name;
          break;
        }
      }
    });

    const modalEl = document.getElementById('editFormBundleModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
  }

  function deleteFormBundle(bundleId) {
    if (!confirm('Are you sure you want to delete this custom bundle? Assigned questions will be removed from this bundle.')) return;

    const card = document.getElementById(`form_bundle_card_${bundleId}`);
    if (card) {
      // Free options in select
      document.querySelectorAll('[class*="form-bundle-assign-select-"]').forEach(select => {
        for (let i = select.options.length - 1; i >= 0; i--) {
          if (select.options[i].value == bundleId) {
            select.remove(i);
            break;
          }
        }
      });
      card.remove();

      // Update bundle count
      const countEl = document.getElementById('form_bundles_count');
      if (countEl) {
        const total = document.querySelectorAll('.form-bundle-card').length;
        countEl.textContent = `${total} ${total === 1 ? 'bundle' : 'bundles'}`;
      }
    }
  }

