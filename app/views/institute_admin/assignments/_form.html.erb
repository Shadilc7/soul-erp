  function submitNewFormQuestion(e) {
    e.preventDefault();
    const errorEl = document.getElementById('new_q_modal_error');
    errorEl.classList.add('d-none');

    const title = document.getElementById('new_form_q_title').value.trim();
    const type = document.getElementById('new_form_q_type').value;
    const fromDay = parseInt(document.getElementById('new_form_q_from_day').value, 10) || 1;
    const toDay = parseInt(document.getElementById('new_form_q_to_day').value, 10) || 30;
    const desc = document.getElementById('new_form_q_desc').value.trim();

    if (!title) return;

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const optionsData = [];

    if (type === 'multiple_choice' || type === 'single_choice') {
      document.querySelectorAll('.new-q-opt-text').forEach(input => {
        if (input.value.trim()) optionsData.push({ text: input.value.trim() });
      });
    }

    const payload = {
      question: {
        title: title,
        question_type: type,
        from_day: fromDay,
        to_day: toDay,
        description: desc,
        options_attributes: optionsData
      }
    };

    fetch('/institute_admin/questions.json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(payload)
    })
    .then(res => res.json())
    .then(data => {
      if (data.status === 'success' && data.question) {
        const q = data.question;
        const dayText = (q.from_day === q.to_day) ? `Day ${q.from_day}` : `Day ${q.from_day}-${q.to_day}`;
        
        let container = document.getElementById('form_custom_questions_container');
        let section = document.getElementById('form_custom_questions_section');

        if (!section) {
          const poolContainer = document.getElementById('form_question_pool_container')?.parentElement;
          if (poolContainer) {
            section = document.createElement('div');
            section.className = 'card border rounded-4 bg-white shadow-sm p-3 mt-4';
            section.id = 'form_custom_questions_section';
            section.innerHTML = `
              <div class="card-header bg-light border-0 rounded-3 p-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 cursor-pointer" data-bs-toggle="collapse" data-bs-target="#form_custom_q_collapse" aria-expanded="true">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-chevron-down text-secondary transition-transform"></i>
                  <i class="bi bi-building-gear text-secondary fs-5"></i>
                  <h6 class="fw-bold text-dark mb-0 fs-6">Institution Custom Questions</h6>
                  <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 fw-semibold ms-1" id="form_custom_q_count_badge">0 questions</span>
                </div>
              </div>
              <div class="collapse show mt-3" id="form_custom_q_collapse">
                <div class="d-flex flex-column gap-3" id="form_custom_questions_container"></div>
              </div>
            `;
            poolContainer.appendChild(section);
            container = document.getElementById('form_custom_questions_container');
          }
        }

        if (container) {
          const card = document.createElement('div');
          card.className = 'card border border-light-subtle rounded-3 p-3 bg-white shadow-sm hover-shadow transition-all form-pool-question-card';
          card.id = `form_pool_card_${q.id}`;
          card.dataset.questionTitle = q.title.toLowerCase();
          card.dataset.qId = q.id;
          card.dataset.qTitle = q.title;
          card.dataset.qDesc = q.description || '';
          card.dataset.qType = q.question_type;
          card.dataset.qFrom = q.from_day || 1;
          card.dataset.qTo = q.to_day || 30;
          card.dataset.qOptions = JSON.stringify(q.options || []);

          card.innerHTML = `
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">New</span>
                <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-${q.id}" style="font-size: 0.7rem;">${q.question_type.replace(/_/g, ' ')}</span>
                <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-${q.id}" style="font-size: 0.7rem;"><i class="bi bi-clock-history me-1"></i>${dayText}</span>
              </div>
              <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="Edit Question" onclick="openFormEditQuestionModal(${q.id})">
                  <i class="bi bi-pencil" style="font-size: 0.85rem;"></i>
                </button>
              </div>
            </div>
            <h6 class="fw-bold text-dark mb-1 q-title-display-${q.id}" style="font-size: 0.925rem; line-height: 1.35;">${q.title}</h6>
            <div class="mt-3 pt-2 border-top">
              <select class="form-select form-select-sm rounded-3 text-muted form-bundle-assign-select-${q.id}" data-q-id="${q.id}" onchange="handleFormQuestionBundleSelect(${q.id}, this)">
                <option value="">+ Assign to Bundle...</option>
              </select>
            </div>
          `;
          container.prepend(card);

          // Pre-populate dropdown bundles for new question
          const select = card.querySelector(`.form-bundle-assign-select-${q.id}`);
          if (select) {
            document.querySelectorAll('.form-bundle-card').forEach(bCard => {
              const bId = bCard.dataset.bundleId || bCard.id.replace('form_bundle_card_', '');
              const bNameEl = document.getElementById(`form_bundle_name_display_${bId}`);
