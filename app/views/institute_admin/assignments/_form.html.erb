<%= form_with(model: [:institute_admin, @assignment], local: true, html: { novalidate: true }, data: { controller: "assignment-form" }) do |f| %>
  <!-- Hidden default fields -->
  <%= hidden_field_tag "assignment[question_ids][]", nil %>

  <!-- Basic Info & Schedule Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square text-primary"></i> Basic Information & Schedule
      </h5>

      <% current_duration = (@assignment.end_date.present? && @assignment.start_date.present?) ? ((@assignment.end_date.to_date - @assignment.start_date.to_date).to_i + 1) : 30 %>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-bold shadow-xs" id="selected_days_badge" style="font-size: 0.85rem;">
        <i class="bi bi-calendar-range me-1.5 text-primary"></i><span id="selected_days_text"><%= current_duration %> <%= current_duration == 1 ? 'Day' : 'Days' %> Selected</span>
      </span>
    </div>

    <div class="card-body p-3 p-md-4">
      <% if @assignment.errors.any? %>
        <div class="alert alert-danger mb-4 rounded-3">
          <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please fix the following errors:</h6>
          <ul class="mb-0 ps-3 small">
            <% @assignment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :title, "Assignment Title", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.text_field :title, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              placeholder: "Enter assignment title...",
              data: { assignment_form_target: "titleInput" } %>
        </div>

        <div class="col-md-6">
          <%= f.label :assignment_type, "Assignment Audience Type", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.select :assignment_type, [["Individual Participants", "individual"], ["Sections / Batches", "section"]], {}, 
              class: "form-select rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_type_select",
              onchange: "toggleAssignmentAudienceSection(this.value)" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :description, "Description (Optional)", class: "form-label fw-semibold text-dark small mb-1" %>
        <%= f.text_area :description, class: "form-control rounded-3 border-secondary-subtle", rows: 2,
            placeholder: "Brief summary or instructions for participants..." %>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :start_date, "Start Date", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.date_field :start_date, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_start_date",
              onchange: "autoUpdateAssignmentEndDate(); updateAssignmentSelectedDaysCount();",
              oninput: "updateAssignmentSelectedDaysCount();" %>
        </div>
        <div class="col-md-6">
          <%= f.label :end_date, "End Date", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.date_field :end_date, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_end_date",
              onchange: "updateAssignmentSelectedDaysCount()",
              oninput: "updateAssignmentSelectedDaysCount()" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recipients Selection Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between">
      <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-people-fill text-primary"></i> <span id="recipients_card_title"><%= @assignment.assignment_type == 'section' ? 'Sections / Batches' : 'Participants' %></span>
      </h5>
      <div class="d-flex align-items-center gap-2">
        <div class="form-check mb-0">
          <input type="checkbox" id="form_select_all_recipients" class="form-check-input cursor-pointer"
                 onchange="toggleFormSelectAllRecipients(this.checked)">
          <label for="form_select_all_recipients" class="form-check-label small fw-semibold text-dark cursor-pointer">
            Select All
          </label>
        </div>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">
      <!-- Individual Participants Container -->
      <div id="individual_audience_container" class="<%= 'd-none' if @assignment.assignment_type == 'section' %>">
        <!-- Participant Type Filter -->
        <div class="mb-3">
          <select id="form_participant_type_filter" class="form-select form-select-sm rounded-3 border-secondary-subtle"
                  onchange="filterFormParticipantsByType(this.value)">
            <option value="all">All Participant Types</option>
            <option value="student">Students</option>
            <option value="guardian">Guardians</option>
            <option value="employee">Employees</option>
          </select>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-dark small fw-bold">Assign Participants</span>
          <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;" id="form_recipient_count_badge">
            <%= @assignment.persisted? ? @assignment.participant_ids.size : 0 %> Selected
          </span>
        </div>

        <!-- Participant Breakdown Legend -->
        <div id="form_participant_breakdown" class="d-flex align-items-center gap-1.5 flex-wrap mb-2 d-none"></div>

        <div class="list-group rounded-3 border overflow-auto bg-white" style="max-height: 220px;">
          <% if @participants.present? && @participants.any? %>
            <% @participants.each do |p| %>
              <% p_type = p.participant_type.to_s.downcase %>
              <% is_sel = @selected_participants&.include?(p) || @assignment.participant_ids.include?(p.id) %>
              <%
                badge_style = case p_type
                when 'student' then 'background-color: #06b6d4; color: #ffffff;'
                when 'guardian' then 'background-color: #f59e0b; color: #ffffff;'
                when 'employee' then 'background-color: #10b981; color: #ffffff;'
                else 'background-color: #64748b; color: #ffffff;'
                end
              %>
              <div class="list-group-item p-2.5 border-bottom hover-bg-light form-part-item" data-participant-type="<%= p_type %>"
                   data-search-name="<%= p.full_name.downcase %> <%= p.user&.email.to_s.downcase %>">
                <div class="form-check mb-0 d-flex align-items-center gap-2">
                  <%= check_box_tag "assignment[participant_ids][]", p.id, is_sel,
                      id: "part_chk_#{p.id}",
                      class: "form-check-input form-part-cb cursor-pointer m-0 ms-1",
                      onchange: "updateFormRecipientCount()" %>
                  <label for="part_chk_<%= p.id %>" class="form-check-label small mb-0 flex-grow-1 cursor-pointer">
                    <div class="d-flex align-items-center justify-content-between">
                      <span class="fw-semibold text-dark"><%= p.full_name %></span>
                      <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="<%= badge_style %> font-size: 0.68rem;">
                        <%= p.participant_type&.capitalize %>
                      </span>
                    </div>
                  </label>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-3 text-center text-muted small">No active participants available.</div>
          <% end %>
        </div>
      </div>

      <!-- Section / Batch Container -->
      <div id="section_audience_container" class="<%= 'd-none' if @assignment.assignment_type != 'section' %>">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-dark small fw-bold">Assign Sections</span>
          <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;" id="form_sec_count_badge">
            <%= @assignment.persisted? ? @assignment.section_ids.size : 0 %> Selected
          </span>
        </div>
        <div class="list-group rounded-3 border overflow-auto bg-white" style="max-height: 220px;">
          <% if @sections.present? && @sections.any? %>
            <% @sections.each do |sec| %>
              <% is_sec_sel = @selected_sections&.include?(sec) || @assignment.section_ids.include?(sec.id) %>
              <div class="list-group-item p-2.5 border-bottom hover-bg-light">
                <div class="form-check mb-0 d-flex align-items-center gap-2">
                  <%= check_box_tag "assignment[section_ids][]", sec.id, is_sec_sel,
                      id: "sec_chk_#{sec.id}",
                      class: "form-check-input form-sec-cb cursor-pointer m-0 ms-1",
                      onchange: "updateFormRecipientCount()" %>
                  <label for="sec_chk_<%= sec.id %>" class="form-check-label small mb-0 flex-grow-1 cursor-pointer fw-semibold text-dark">
                    <%= sec.name %>
                  </label>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-3 text-center text-muted small">No active sections available.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 2-COLUMN QUESTION BANK WORKSPACE BUILDER GRID -->
  <% category = @assignment.question_category %>
  <% category_questions = category.present? ? category.questions.includes(:options).order(position: :asc, created_at: :asc, id: :asc) : @assignment.questions.includes(:options).order(position: :asc, created_at: :asc, id: :asc) %>
  <% category_bundles = category.present? ? category.question_bundles.includes(question_bundle_items: { question: :options }).order(:position) : [] %>

  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-layers-fill text-warning fs-5"></i> Question Bank & Custom Bundles Builder
        </h5>
        <span class="text-muted small">Manage questions, customize bundle day ranges, or add custom questions to bundles.</span>
      </div>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" id="expand_collapse_all_btn" onclick="toggleAllFormBundles(this)" data-expanded="true">
          <i class="bi bi-chevrons-down me-1" id="expand_collapse_all_icon"></i> <span id="expand_collapse_all_text">Collapse All</span>
        </button>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">
      <div class="row g-4">
        <!-- LEFT COLUMN: QUESTION POOL -->
        <div class="col-lg-5" id="form_question_pool_col">
          <div class="card border border-secondary-subtle shadow-sm rounded-4 h-100 bg-light-subtle">
            <div class="card-header bg-white border-bottom p-3.5 p-md-4 rounded-top-4">
              <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                <div>
                  <h6 class="fw-bold text-dark mb-0 d-flex align-items-center flex-wrap gap-2" style="font-size: 1rem;">
                    <i class="bi bi-card-list text-primary fs-5"></i>
                    <span>Question Pool</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1" style="font-size: 0.75rem;" id="form_pool_count">
                      <%= category_questions.size %> <%= category_questions.size == 1 ? 'question' : 'questions' %>
                    </span>
                  </h6>
                  <span class="text-muted small d-block mt-1">Select questions from pool to assign to custom bundles.</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <button type="button" 
                          class="btn btn-sm btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs"
                          data-bs-toggle="modal" data-bs-target="#newFormQuestionModal">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Add Custom Question</span>
                  </button>
                  <button type="button" 
                          class="btn btn-sm btn-primary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm text-white border-0" 
                          style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);"
                          onclick="autoAssignFormQuestionsToBundles()"
                          title="Auto-assign questions to matching bundles based on schedule day ranges">
                    <i class="bi bi-magic fs-6"></i>
                    <span>Auto Assign to Bundles</span>
                  </button>
                </div>
              </div>

              <!-- Search Filter -->
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 ps-3 pe-2"><i class="bi bi-search text-muted"></i></span>
                <input type="text" 
                       class="form-control bg-light border-start-0 ps-0 py-2" 
                       placeholder="Search questions by title..." 
                       oninput="filterFormPoolQuestions(this.value)">
              </div>
            </div>

            <!-- Question Pool Cards List -->
            <div class="card-body p-3 overflow-auto" style="max-height: 700px;">
              <% if category_questions.any? %>
                <div class="d-flex flex-column gap-3" id="form_question_pool_container">
                  <% category_questions.each_with_index do |q, q_idx| %>
                    <% is_in_assignment = @assignment.question_ids.include?(q.id) %>
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white shadow-sm hover-shadow transition-all position-relative form-pool-question-card" 
                         id="form_pool_card_<%= q.id %>"
                         data-question-title="<%= q.title.downcase %>"
                         data-q-id="<%= q.id %>"
                         data-q-title="<%= ERB::Util.html_escape(q.title) %>"
                         data-q-desc="<%= ERB::Util.html_escape(q.description.to_s) %>"
                         data-q-type="<%= q.question_type %>"
                         data-q-from="<%= q.from_day || 1 %>"
                         data-q-to="<%= q.to_day || 30 %>"
                         data-q-options="<%= ERB::Util.html_escape(q.options.map { |o| { id: o.id, text: o.text } }.to_json) %>">

                      <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
                        <div class="d-flex align-items-center flex-wrap gap-1.5 min-w-0">
                          <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                            #<%= q_idx + 1 %>
                          </span>

                          <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= q.id %>" style="font-size: 0.7rem;">
                            <%= q.question_type&.titleize %>
                          </span>

                          <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-<%= q.id %>" style="font-size: 0.7rem;">
                            <i class="bi bi-clock-history me-1"></i><%= q.day_range_text %>
                          </span>
                        </div>

                        <!-- Quick Actions (Edit / View) -->
                        <div class="d-flex align-items-center flex-shrink-0 ms-auto gap-1">
                          <button type="button" class="btn btn-sm btn-outline-primary rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="Edit Question" onclick="openFormEditQuestionModal(<%= q.id %>)">
                            <i class="bi bi-pencil" style="font-size: 0.85rem;"></i>
                          </button>
                          <button type="button" class="btn btn-sm btn-outline-info rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="View Question Details" data-bs-toggle="modal" data-bs-target="#viewFormQuestionModal_<%= q.id %>">
                            <i class="bi bi-eye" style="font-size: 0.85rem;"></i>
                          </button>
                        </div>
                      </div>

                      <!-- Question Title -->
                      <h6 class="fw-bold text-dark mb-1 text-break q-title-display-<%= q.id %>" style="font-size: 0.925rem; line-height: 1.35; word-break: break-word;">
                        <%= q.title %>
                      </h6>

                      <% if q.requires_options? && q.options.any? %>
                        <div class="text-muted small mb-1 q-options-count-<%= q.id %>">
                          <i class="bi bi-list-check me-1 text-primary"></i> <%= q.options.size %> Answer Options
                        </div>
                      <% elsif q.rating? %>
                        <div class="text-muted small mb-1">
                          <i class="bi bi-star-fill me-1 text-warning"></i> Max Scale: <%= q.max_rating || 5 %> Stars
                        </div>
                      <% end %>

                      <!-- Quick Assign to Bundle Select -->
                      <% if category_bundles.any? %>
                        <div class="mt-3 pt-2 border-top">
                          <select class="form-select form-select-sm rounded-3 text-muted form-bundle-assign-select-<%= q.id %>" 
                                  data-q-id="<%= q.id %>"
                                  onchange="handleFormQuestionBundleSelect(<%= q.id %>, this)">
                            <option value="">+ Assign to Bundle...</option>
                            <%
                              assigned_bnames = if @assignment.assignment_questions.loaded?
                                                  @assignment.assignment_questions.select { |aq| aq.question_id == q.id }.map(&:bundle_name)
                                                else
                                                  @assignment.assignment_questions.where(question_id: q.id).pluck(:bundle_name)
                                                end
                            %>
                            <% category_bundles.each do |b| %>
                              <% is_assigned = assigned_bnames.include?(b.name) %>
                              <option value="<%= b.id %>" data-bundle-name="<%= b.name %>" <%= 'disabled' if is_assigned %>>
                                <%= b.name %> (<%= b.day_range_text %>)<%= " - Assigned" if is_assigned %>
                              </option>
                            <% end %>
                          </select>
                        </div>
                      <% end %>
                    </div>

                    <!-- Modal: View Form Question -->
                    <div class="modal fade" id="viewFormQuestionModal_<%= q.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content rounded-4 border-0 shadow-lg">
                          <div class="modal-header border-bottom-0 pb-0">
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                              <i class="bi bi-eye-fill text-info"></i> Question Details
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body p-4">
                            <span class="badge bg-secondary-subtle text-dark text-uppercase px-2.5 py-1 mb-2 q-type-badge-<%= q.id %>" style="font-size: 0.75rem;"><%= q.question_type&.titleize %></span>
                            <h4 class="fw-bold text-dark mb-2 q-title-display-<%= q.id %>"><%= q.title %></h4>
                            <% if q.description.present? %>
                              <div class="p-3 bg-light rounded-3 text-muted small mb-3"><%= q.description %></div>
                            <% end %>
                            <% if q.requires_options? && q.options.any? %>
                              <h6 class="fw-semibold text-dark mb-2">Answer Options:</h6>
                              <div class="list-group rounded-3 mb-3">
                                <% q.options.each_with_index do |opt, o_idx| %>
                                  <div class="list-group-item d-flex align-items-center justify-content-between">
                                    <span><%= o_idx + 1 %>. <%= opt.text %></span>
                                  </div>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                          <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <!-- Institution Custom Questions Section -->
              <% if @custom_questions.present? && @custom_questions.any? %>
                <div class="card border rounded-4 bg-white shadow-sm p-2.5 p-sm-3 mt-4" id="form_custom_questions_section">
                  <div class="card-header bg-light border-0 rounded-3 p-2.5 p-sm-3 mb-0 d-flex align-items-center justify-content-between gap-2 cursor-pointer"
                       data-bs-toggle="collapse" 
                       data-bs-target="#form_custom_q_collapse" 
                       aria-expanded="true">
                    <div class="d-flex align-items-center flex-wrap gap-2 min-w-0">
                      <i class="bi bi-chevron-down text-secondary transition-transform"></i>
                      <i class="bi bi-building-gear text-secondary fs-5"></i>
                      <h6 class="fw-bold text-dark mb-0 fs-6 text-nowrap">Institution Custom Questions</h6>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 fw-semibold text-nowrap" id="form_custom_q_count_badge">
                        <%= pluralize(@custom_questions.size, 'question') %>
                      </span>
                    </div>
                    <span class="text-secondary flex-shrink-0" data-bs-toggle="tooltip" data-bs-placement="top" title="Click &quot;+ Assign to Bundle&quot; to assign questions">
                      <i class="bi bi-info-circle fs-6"></i>
                    </span>
                  </div>

                  <div class="collapse show mt-3" id="form_custom_q_collapse">
                    <div class="d-flex flex-column gap-3" id="form_custom_questions_container">
                      <% @custom_questions.each_with_index do |cq, cq_idx| %>
                        <div class="card border border-light-subtle rounded-3 p-2.5 p-sm-3 bg-white shadow-sm hover-shadow transition-all form-pool-question-card overflow-hidden" 
                             id="form_pool_card_<%= cq.id %>"
                             data-question-title="<%= cq.title.downcase %>"
                             data-q-id="<%= cq.id %>"
                             data-q-title="<%= ERB::Util.html_escape(cq.title) %>"
                             data-q-desc="<%= ERB::Util.html_escape(cq.description.to_s) %>"
                             data-q-type="<%= cq.question_type %>"
                             data-q-from="<%= cq.from_day || 1 %>"
                             data-q-to="<%= cq.to_day || 30 %>"
                             data-q-options="<%= ERB::Util.html_escape(cq.options.map { |o| { id: o.id, text: o.text } }.to_json) %>">
                          
                          <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
                            <div class="d-flex align-items-center flex-wrap gap-1.5 min-w-0">
                              <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                #<%= cq_idx + 1 %>
                              </span>
                              <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= cq.id %>" style="font-size: 0.7rem;">
                                <%= cq.question_type&.titleize %>
                              </span>
                              <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-<%= cq.id %>" style="font-size: 0.7rem;">
                                <i class="bi bi-clock-history me-1"></i><%= cq.day_range_text %>
                              </span>
                            </div>

                            <div class="d-flex align-items-center flex-shrink-0 ms-auto gap-1">
                              <button type="button" class="btn btn-sm btn-outline-info rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="View Question Details" data-bs-toggle="modal" data-bs-target="#viewFormQuestionModal_<%= cq.id %>">
                                <i class="bi bi-eye" style="font-size: 0.85rem;"></i>
                              </button>
                            </div>
                          </div>

                          <h6 class="fw-bold text-dark mb-1 text-break q-title-display-<%= cq.id %>" style="font-size: 0.925rem; line-height: 1.35; word-break: break-word;"><%= cq.title %></h6>

                          <% if category_bundles.any? %>
                            <div class="mt-3 pt-2 border-top">
                              <select class="form-select form-select-sm rounded-3 text-muted w-100 form-bundle-assign-select-<%= cq.id %>" 
                                      data-q-id="<%= cq.id %>"
                                      onchange="handleFormQuestionBundleSelect(<%= cq.id %>, this)">
                                <option value="">+ Assign to Bundle...</option>
                                <%
                                  assigned_bnames = if @assignment.assignment_questions.loaded?
                                                      @assignment.assignment_questions.select { |aq| aq.question_id == cq.id }.map(&:bundle_name)
                                                    else
                                                      @assignment.assignment_questions.where(question_id: cq.id).pluck(:bundle_name)
                                                    end
                                %>
                                <% category_bundles.each do |b| %>
                                  <% is_assigned = assigned_bnames.include?(b.name) %>
                                  <option value="<%= b.id %>" data-bundle-name="<%= b.name %>" <%= 'disabled' if is_assigned %>>
                                    <%= b.name %> (<%= b.day_range_text %>)<%= " - Assigned" if is_assigned %>
                                  </option>
                                <% end %>
                              </select>
                            </div>
                          <% end %>
                        </div>

                        <!-- Modal: View Form Custom Question -->
                        <div class="modal fade" id="viewFormQuestionModal_<%= cq.id %>" tabindex="-1" aria-hidden="true">
                          <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                              <div class="modal-header border-bottom-0 pb-0">
                                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                                  <i class="bi bi-eye-fill text-info"></i> Question Details
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body p-4">
                                <span class="badge bg-secondary-subtle text-dark text-uppercase px-2.5 py-1 mb-2 q-type-badge-<%= cq.id %>" style="font-size: 0.75rem;"><%= cq.question_type&.titleize %></span>
                                <h4 class="fw-bold text-dark mb-2 q-title-display-<%= cq.id %>"><%= cq.title %></h4>
                                <% if cq.description.present? %>
                                  <div class="p-3 bg-light rounded-3 text-muted small mb-3"><%= cq.description %></div>
                                <% end %>
                                <% if cq.requires_options? && cq.options.any? %>
                                  <h6 class="fw-semibold text-dark mb-2">Answer Options:</h6>
                                  <div class="list-group rounded-3 mb-3">
                                    <% cq.options.each_with_index do |opt, o_idx| %>
                                      <div class="list-group-item d-flex align-items-center justify-content-between">
                                        <span><%= o_idx + 1 %>. <%= opt.text %></span>
                                      </div>
                                    <% end %>
                                  </div>
                                <% end %>
                              </div>
                              <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: CUSTOM BUNDLES -->
        <div class="col-lg-7" id="form_bundles_col">
          <div class="card border border-secondary-subtle shadow-sm rounded-4 h-100 bg-light-subtle">
            <div class="card-header bg-white border-bottom p-3.5 p-md-4 rounded-top-4">
              <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                <div>
                  <h6 class="fw-bold text-dark mb-0 d-flex align-items-center flex-wrap gap-2" style="font-size: 1rem;">
                    <i class="bi bi-layers-fill text-warning fs-5"></i>
                    <span>Custom Bundles</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1" style="font-size: 0.75rem;" id="form_bundles_count">
                      <%= category_bundles.size %> <%= category_bundles.size == 1 ? 'bundle' : 'bundles' %>
                    </span>
                  </h6>
                  <span class="text-muted small d-block mt-1">Organize questions into day-wise bundles for participants.</span>
                </div>
                <button type="button" class="btn btn-sm btn-primary rounded-3 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" data-bs-toggle="modal" data-bs-target="#newFormBundleModal">
                  <i class="bi bi-plus-lg"></i>
                  <span>Add Custom Bundle</span>
                </button>
              </div>

              <!-- Search Filter -->
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 ps-3 pe-2"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control bg-light border-start-0 ps-0 py-2" placeholder="Search bundles..." oninput="filterFormBundles(this.value)">
              </div>
            </div>

            <!-- Custom Bundles Cards List -->
            <div class="card-body p-3 overflow-auto" style="max-height: 700px;">
              <div class="d-flex flex-column gap-3" id="form_bundles_container">
                <% if category_bundles.any? %>
                  <% category_bundles.each_with_index do |bundle, b_idx| %>
                    <% assigned_qs = @assignment.questions_grouped_by_bundle[bundle.name] || [] %>
                    <% duration = current_duration %>

                    <div class="card border rounded-4 bg-white shadow-sm p-3 border-light-subtle position-relative form-bundle-card" id="form_bundle_card_<%= bundle.id %>" data-bundle-id="<%= bundle.id %>" data-bundle-from="<%= bundle.from_day || 1 %>" data-bundle-to="<%= bundle.to_day || 30 %>">
                      <!-- Bundle Card Header -->
                      <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                          <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.85rem;">
                            <i class="bi bi-layers-fill me-1"></i><h6 class="d-inline fw-bold text-white mb-0" id="form_bundle_name_display_<%= bundle.id %>" style="font-size: 0.85rem;"><%= bundle.name %></h6>
                          </span>
                          <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1" id="form_bundle_q_count_pill_<%= bundle.id %>">
                            <%= assigned_qs.size %> <%= assigned_qs.size == 1 ? 'question' : 'questions' %>
                          </span>
                          <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
                            <i class="bi bi-calendar-event me-1"></i><span id="form_bundle_schedule_display_<%= bundle.id %>"><%= bundle.day_range_text %></span>
                          </span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                          <button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-2 p-1" title="Edit Bundle" onclick="openFormEditBundleModal('<%= bundle.id %>', '<%= j bundle.name %>', '<%= bundle.from_day || 1 %>', '<%= bundle.to_day || 30 %>')">
                            <i class="bi bi-pencil"></i>
                          </button>
                          <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2 p-1" title="Delete Bundle" onclick="deleteFormBundle('<%= bundle.id %>')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </div>

                      <!-- Dropzone Container -->
                      <div class="card-body bg-light-subtle rounded-3 p-2.5" style="min-height: 100px; border: 2px dashed #94a3b8 !important;">
                        <div class="d-flex flex-column gap-2 form-bundle-items-container" id="form_bundle_items_<%= bundle.id %>" data-bundle-name="<%= bundle.name %>">
                          <% assigned_qs.each_with_index do |q, q_idx| %>
                            <%
                              q_from = q.from_day || 1
                              q_to = q.to_day || 30
                              b_from = bundle.from_day || 1
                              b_to = bundle.to_day || 30
                              eff_from = [q_from, b_from].max
                              eff_to = [q_to, b_to].min
                              if eff_from <= eff_to
                                days_in_bundle = (eff_to - eff_from + 1)
                                eff_sched_text = (eff_from == eff_to) ? "Day #{eff_from.ordinalize}" : "Day #{eff_from.ordinalize} - #{eff_to.ordinalize} Day"
                              else
                                days_in_bundle = 0
                                eff_sched_text = (q_from == q_to) ? "Day #{q_from.ordinalize}" : "Day #{q_from.ordinalize} - #{q_to.ordinalize} Day"
                              end
                            %>
                            <div class="bundle-question-item bg-white p-3 rounded-3 border shadow-xs position-relative hover-shadow-sm transition-all mb-2" id="form_bundle_item_card_<%= bundle.id %>_<%= q.id %>">
                              <input type="hidden" name="assignment[question_bundle_items][][question_id]" value="<%= q.id %>">
                              <input type="hidden" name="assignment[question_bundle_items][][bundle_name]" value="<%= bundle.name %>" class="form-bundle-item-name-input-<%= bundle.id %>">

                              <div class="d-flex align-items-start gap-2">
                                <div class="d-flex align-items-center gap-1 flex-shrink-0 pt-0.5">
                                  <input type="hidden" name="assignment[question_ids][]" value="<%= q.id %>">
                                  <i class="bi bi-list fs-5 text-secondary drag-handle me-0.5" style="cursor: grab;" title="Drag to reorder"></i>

                                  <div class="btn-group btn-group-sm rounded-2 bg-light border p-0.5 me-0.5">
                                    <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1 border-0" title="Move Up" onclick="moveFormBundleItemUp(this, '<%= bundle.id %>')">
                                      <i class="bi bi-chevron-up" style="font-size: 0.75rem;"></i>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1 border-0" title="Move Down" onclick="moveFormBundleItemDown(this, '<%= bundle.id %>')">
                                      <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
                                    </button>
                                  </div>

                                  <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold form-bundle-item-serial" style="font-size: 0.75rem;">
                                    #<%= q_idx + 1 %>
                                  </span>
                                </div>

                                <div class="flex-grow-1 min-w-0">
                                  <div class="fw-bold text-dark mb-0 text-break pe-1 q-title-display-<%= q.id %>" style="font-size: 0.925rem;"><%= q.title %></div>
                                  <div class="d-flex align-items-center flex-wrap gap-1.5 mt-1">
                                    <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= q.id %>" style="font-size: 0.7rem;"><%= q.question_type&.titleize %></span>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                                      <i class="bi bi-clock-history me-1 text-primary"></i><span class="form-bundle-item-eff-sched-<%= bundle.id %>-<%= q.id %>"><%= eff_sched_text %></span>
                                    </span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                                      <i class="bi bi-calendar-check me-1 text-success"></i><span class="form-bundle-item-days-<%= bundle.id %>-<%= q.id %>"><%= days_in_bundle %> <%= 'day'.pluralize(days_in_bundle) %> in bundle</span>
                                    </span>
                                  </div>
                                </div>

                                <div class="flex-shrink-0 d-flex align-items-center gap-1">
                                  <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2 p-1" title="Remove from bundle" onclick="removeFormQuestionFromBundle('<%= bundle.id %>', <%= q.id %>)">
                                    <i class="bi bi-x-lg"></i>
                                  </button>
                                </div>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <div class="text-muted text-center py-4">No question bundles found.</div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions Footer -->
  <div class="d-flex align-items-center justify-content-between bg-white border shadow-sm rounded-4 p-3.5 p-md-4 mb-4">
    <%= link_to institute_admin_assignments_path, class: "btn btn-outline-secondary rounded-3 px-4 fw-semibold" do %>
      <i class="bi bi-arrow-left me-1.5"></i> Cancel
    <% end %>

    <%= f.submit "Save Assignment Changes", class: "btn btn-primary rounded-3 px-5 py-2.5 fw-bold shadow-sm" %>
  </div>
<% end %>

<!-- JS HELPER FUNCTIONS -->
<script>
  function toggleAssignmentAudienceSection(val) {
    const ind = document.getElementById('individual_audience_container');
    const sec = document.getElementById('section_audience_container');
    const title = document.getElementById('recipients_card_title');
    if (val === 'section') {
      if (ind) ind.classList.add('d-none');
      if (sec) sec.classList.remove('d-none');
      if (title) title.textContent = 'Sections / Batches';
    } else {
      if (sec) sec.classList.add('d-none');
      if (ind) ind.classList.remove('d-none');
      if (title) title.textContent = 'Participants';
    }
    updateFormRecipientCount();
  }

  function filterFormParticipantsByType(type) {
    document.querySelectorAll('.form-part-item').forEach(item => {
      if (type === 'all' || item.dataset.participantType === type) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  function toggleFormSelectAllRecipients(checked) {
    const isSection = document.getElementById('section_audience_container') &&
                      !document.getElementById('section_audience_container').classList.contains('d-none');
    if (isSection) {
      document.querySelectorAll('.form-sec-cb').forEach(cb => { cb.checked = checked; });
    } else {
      document.querySelectorAll('.form-part-cb').forEach(cb => {
        const item = cb.closest('.form-part-item');
        if (item && item.style.display !== 'none') {
          cb.checked = checked;
        }
      });
    }
    updateFormRecipientCount();
  }

  function updateFormRecipientCount() {
    const isSection = document.getElementById('section_audience_container') &&
                      !document.getElementById('section_audience_container').classList.contains('d-none');

    if (isSection) {
      const count = document.querySelectorAll('.form-sec-cb:checked').length;
      const badge = document.getElementById('form_sec_count_badge');
      if (badge) badge.textContent = `${count} Selected`;
    } else {
      const checkedCbs = document.querySelectorAll('.form-part-cb:checked');
      const count = checkedCbs.length;
      const badge = document.getElementById('form_recipient_count_badge');
      if (badge) badge.textContent = `${count} Selected`;

      // Build participant breakdown
      const counts = {};
      checkedCbs.forEach(cb => {
        const item = cb.closest('.form-part-item');
        if (item && item.dataset.participantType) {
          const t = item.dataset.participantType;
          counts[t] = (counts[t] || 0) + 1;
        }
      });
      renderFormParticipantBreakdown('form_participant_breakdown', counts);
    }
  }

  function renderFormParticipantBreakdown(containerId, counts) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const colorMap = {
      student: { bg: '#ecfeff', color: '#0891b2', border: '#a5f3fc' },
      guardian: { bg: '#fffbeb', color: '#d97706', border: '#fcd34d' },
      employee: { bg: '#ecfdf5', color: '#059669', border: '#6ee7b7' }
    };

    const keys = Object.keys(counts);
    if (keys.length === 0) {
      container.classList.add('d-none');
      container.innerHTML = '';
      return;
    }

    container.classList.remove('d-none');
    container.innerHTML = keys.map(type => {
      const c = colorMap[type] || { bg: '#f1f5f9', color: '#475569', border: '#cbd5e1' };
      return `<span class="badge rounded-pill px-2 py-1 fw-semibold" style="background-color: ${c.bg}; color: ${c.color}; border: 1px solid ${c.border}; font-size: 0.7rem;">${counts[type]} ${type.charAt(0).toUpperCase() + type.slice(1)}${counts[type] > 1 ? 's' : ''}</span>`;
    }).join('');
  }

  function filterFormPoolQuestions(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-pool-question-card').forEach(card => {
      const title = card.dataset.questionTitle || '';
      card.classList.toggle('d-none', q && !title.includes(q));
    });
  }

  function filterFormBundles(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-bundle-card').forEach(card => {
      const nameEl = card.querySelector('[id*="form_bundle_name_display_"]');
      const name = nameEl ? nameEl.textContent.toLowerCase() : '';
      card.classList.toggle('d-none', q && !name.includes(q));
    });
  }

  function getFormOrdinal(n) {
    const s = ["th", "st", "nd", "rd"];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }

  function calculateFormBundleItemSchedule(qFrom, qTo, bFrom, bTo) {
    const effFrom = Math.max(qFrom, bFrom);
    const effTo = Math.min(qTo, bTo);
    let effSchedText = '';
    let daysInBundle = 0;

    if (effFrom <= effTo) {
      daysInBundle = effTo - effFrom + 1;
      if (effFrom === effTo) {
        effSchedText = `Day ${getFormOrdinal(effFrom)}`;
      } else {
        effSchedText = `Day ${getFormOrdinal(effFrom)} - ${getFormOrdinal(effTo)} Day`;
      }
    } else {
      effSchedText = (qFrom === qTo) ? `Day ${getFormOrdinal(qFrom)}` : `Day ${getFormOrdinal(qFrom)} - ${getFormOrdinal(qTo)} Day`;
      daysInBundle = 0;
    }
    return { daysInBundle, effSchedText };
  }

  function updateFormBundleItemSchedules(bundleId) {
    const bundleCard = document.getElementById(`form_bundle_card_${bundleId}`);
    if (!bundleCard) return;
    const bFrom = parseInt(bundleCard.dataset.bundleFrom, 10) || 1;
    const bTo = parseInt(bundleCard.dataset.bundleTo, 10) || 30;

    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (!container) return;

    container.querySelectorAll('.bundle-question-item').forEach(itemCard => {
      const qIdInput = itemCard.querySelector('input[name="assignment[question_bundle_items][][question_id]"]');
      if (!qIdInput) return;
      const qId = qIdInput.value;
      const poolCard = document.getElementById(`form_pool_card_${qId}`);

      let qFrom = 1, qTo = 30;
      if (poolCard) {
        qFrom = parseInt(poolCard.dataset.qFrom, 10) || 1;
        qTo = parseInt(poolCard.dataset.qTo, 10) || 30;
      }

      const { daysInBundle, effSchedText } = calculateFormBundleItemSchedule(qFrom, qTo, bFrom, bTo);

      const effSchedEl = itemCard.querySelector(`.form-bundle-item-eff-sched-${bundleId}-${qId}`);
      const daysEl = itemCard.querySelector(`.form-bundle-item-days-${bundleId}-${qId}`);

      if (effSchedEl) effSchedEl.textContent = effSchedText;
      if (daysEl) daysEl.textContent = `${daysInBundle} ${daysInBundle === 1 ? 'day' : 'days'} in bundle`;
    });
  }

  function handleFormQuestionBundleSelect(qId, selectEl) {
    const bundleId = selectEl.value;
    if (!bundleId) return;

    const opt = selectEl.options[selectEl.selectedIndex];
    const bundleName = opt.dataset.bundleName;

    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    const poolCard = document.getElementById(`form_pool_card_${qId}`);
    const bundleCard = document.getElementById(`form_bundle_card_${bundleId}`);

    if (container && poolCard) {
      const title = poolCard.querySelector('h6')?.textContent?.trim() || '';
      const qType = poolCard.querySelector('.badge.bg-secondary-subtle')?.textContent?.trim() || '';
      
      const qFrom = parseInt(poolCard.dataset.qFrom, 10) || 1;
      const qTo = parseInt(poolCard.dataset.qTo, 10) || 30;
      const bFrom = bundleCard ? (parseInt(bundleCard.dataset.bundleFrom, 10) || 1) : 1;
      const bTo = bundleCard ? (parseInt(bundleCard.dataset.bundleTo, 10) || 30) : 30;

      const { daysInBundle, effSchedText } = calculateFormBundleItemSchedule(qFrom, qTo, bFrom, bTo);

      const itemCard = document.createElement('div');
      itemCard.className = 'bundle-question-item bg-white p-3 rounded-3 border shadow-xs position-relative hover-shadow-sm transition-all mb-2';
      itemCard.id = `form_bundle_item_card_${bundleId}_${qId}`;
      itemCard.innerHTML = `
        <input type="hidden" name="assignment[question_bundle_items][][question_id]" value="${qId}">
        <input type="hidden" name="assignment[question_bundle_items][][bundle_name]" value="${bundleName}">
        <div class="d-flex align-items-start gap-2">
          <div class="d-flex align-items-center gap-1 flex-shrink-0 pt-0.5">
            <input type="hidden" name="assignment[question_ids][]" value="${qId}">
            <i class="bi bi-list fs-5 text-secondary drag-handle me-0.5" style="cursor: grab;" title="Drag to reorder"></i>
            <div class="btn-group btn-group-sm rounded-2 bg-light border p-0.5 me-0.5">
              <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1 border-0" title="Move Up" onclick="moveFormBundleItemUp(this, '${bundleId}')">
                <i class="bi bi-chevron-up" style="font-size: 0.75rem;"></i>
              </button>
              <button type="button" class="btn btn-xs btn-link text-secondary p-0 px-1 border-0" title="Move Down" onclick="moveFormBundleItemDown(this, '${bundleId}')">
                <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
              </button>
            </div>
            <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold form-bundle-item-serial" style="font-size: 0.75rem;">#1</span>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="fw-bold text-dark mb-0 text-break pe-1 q-title-display-${qId}" style="font-size: 0.925rem;">${title}</div>
            <div class="d-flex align-items-center flex-wrap gap-1.5 mt-1">
              <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-${qId}" style="font-size: 0.7rem;">${qType}</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                <i class="bi bi-clock-history me-1 text-primary"></i><span class="form-bundle-item-eff-sched-${bundleId}-${qId}">${effSchedText}</span>
              </span>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.68rem;">
                <i class="bi bi-calendar-check me-1 text-success"></i><span class="form-bundle-item-days-${bundleId}-${qId}">${daysInBundle} ${daysInBundle === 1 ? 'day' : 'days'} in bundle</span>
              </span>
            </div>
          </div>
          <div class="flex-shrink-0">
            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2 p-1" title="Remove from bundle" onclick="removeFormQuestionFromBundle(${bundleId}, ${qId})">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
      `;
      container.appendChild(itemCard);
      updateFormBundleItemSerials(bundleId);
      initFormBundleSortables();
      opt.disabled = true;
      selectEl.value = '';
    }
  }

  function removeFormQuestionFromBundle(bundleId, qId) {
    const card = document.getElementById(`form_bundle_item_card_${bundleId}_${qId}`);
    if (card) {
      card.remove();
      updateFormBundleItemSerials(bundleId);
      const select = document.querySelector(`.form-bundle-assign-select-${qId}`);
      if (select) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].value == bundleId) {
            select.options[i].disabled = false;
            break;
          }
        }
      }
    }
  }

  function moveFormBundleItemUp(btn, bundleId) {
    const itemCard = btn.closest('.bundle-question-item');
    if (!itemCard) return;
    const prev = itemCard.previousElementSibling;
    if (prev && prev.classList.contains('bundle-question-item')) {
      itemCard.parentNode.insertBefore(itemCard, prev);
      updateFormBundleItemSerials(bundleId);
    }
  }

  function moveFormBundleItemDown(btn, bundleId) {
    const itemCard = btn.closest('.bundle-question-item');
    if (!itemCard) return;
    const next = itemCard.nextElementSibling;
    if (next && next.classList.contains('bundle-question-item')) {
      itemCard.parentNode.insertBefore(next, itemCard);
      updateFormBundleItemSerials(bundleId);
    }
  }

  function initFormBundleSortables() {
    if (typeof Sortable !== "undefined") {
      const containers = document.querySelectorAll('.form-bundle-items-container');
      containers.forEach(container => {
        if (container._sortable) container._sortable.destroy();
        container._sortable = new Sortable(container, {
          handle: '.drag-handle',
          filter: 'button, button *, a, a *, select, input, .dropdown, .dropdown-menu, .dropdown-item',
          preventOnFilter: false,
          animation: 150,
          onEnd: function(evt) {
            const bundleId = evt.to.id.replace('form_bundle_items_', '');
            updateFormBundleItemSerials(bundleId);
          }
        });
      });
    }
  }

  function updateFormBundleItemSerials(bundleId) {
    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (!container) return;
    const items = container.querySelectorAll('.bundle-question-item');
    items.forEach((item, idx) => {
      const serial = item.querySelector('.form-bundle-item-serial');
      if (serial) serial.textContent = `#${idx + 1}`;
    });
    const pill = document.getElementById(`form_bundle_q_count_pill_${bundleId}`);
    if (pill) pill.textContent = `${items.length} ${items.length === 1 ? 'question' : 'questions'}`;
  }

  function toggleAllFormBundles(btn) {
    const isExpanded = btn.getAttribute('data-expanded') !== 'false';
    const icon = document.getElementById('expand_collapse_all_icon');
    const text = document.getElementById('expand_collapse_all_text');

    if (isExpanded) {
      btn.setAttribute('data-expanded', 'false');
      if (icon) icon.className = 'bi bi-chevrons-up me-1';
      if (text) text.textContent = 'Expand All';
    } else {
      btn.setAttribute('data-expanded', 'true');
      if (icon) icon.className = 'bi bi-chevrons-down me-1';
      if (text) text.textContent = 'Collapse All';
    }
  }

  function autoAssignFormQuestionsToBundles() {
    const bundleCards = document.querySelectorAll('.form-bundle-card');
    if (bundleCards.length === 0) {
      alert('No custom bundles found. Please create a bundle first.');
      return;
    }

    let assignedCount = 0;
    const poolCards = document.querySelectorAll('.form-pool-question-card');

    poolCards.forEach(card => {
      const qId = card.dataset.qId;
      if (!qId) return;

      const qFrom = parseInt(card.dataset.qFrom, 10) || 1;
      const qTo = parseInt(card.dataset.qTo, 10) || 30;

      const selectEl = document.querySelector(`.form-bundle-assign-select-${qId}`);
      if (!selectEl) return;

      bundleCards.forEach(bCard => {
        const bundleId = bCard.dataset.bundleId;
        const bFrom = parseInt(bCard.dataset.bundleFrom, 10) || 1;
        const bTo = parseInt(bCard.dataset.bundleTo, 10) || 30;

        // Check for day-range overlap
        const overlapFrom = Math.max(qFrom, bFrom);
        const overlapTo = Math.min(qTo, bTo);

        if (overlapFrom <= overlapTo) {
          // Check if already assigned to this bundle
          const existingCard = document.getElementById(`form_bundle_item_card_${bundleId}_${qId}`);
          if (!existingCard) {
            // Find the matching option and check it's not disabled
            let optFound = false;
            for (let i = 0; i < selectEl.options.length; i++) {
              if (selectEl.options[i].value == bundleId && !selectEl.options[i].disabled) {
                selectEl.value = bundleId;
                handleFormQuestionBundleSelect(qId, selectEl);
                assignedCount++;
                optFound = true;
                break;
              }
            }
          }
        }
      });
    });

    if (assignedCount > 0) {
      alert(`Auto-assigned matching questions to bundles based on schedule day ranges (${assignedCount} question-bundle assignments created).`);
    } else {
      alert('All questions are already assigned to their matching bundles, or no new schedule overlaps were found.');
    }
  }
</script>

