                                    <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= q.id %>" style="font-size: 0.7rem;"><%= q.question_type&.titleize %></span>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-<%= q.id %>" style="font-size: 0.7rem;"><i class="bi bi-clock-history me-1"></i><%= q.day_range_text %></span>
                                  </div>
                                </div>

