              <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-${qId}" style="font-size: 0.7rem;">${qType}</span>
              <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-${qId}" style="font-size: 0.7rem;"><i class="bi bi-clock-history me-1"></i>${dayRange}</span>
