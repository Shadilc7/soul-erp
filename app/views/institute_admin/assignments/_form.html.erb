<!-- JS HELPER FUNCTIONS -->
<script>
  function toggleAssignmentAudienceSection(val) {
    const ind = document.getElementById('individual_audience_container');
    const sec = document.getElementById('section_audience_container');
    const title = document.getElementById('recipients_card_title');
    if (val === 'section') {
      if (ind) ind.classList.add('d-none');
      if (sec) sec.classList.remove('d-none');
      if (title) title.textContent = 'Sections / Batches';
    } else {
      if (sec) sec.classList.add('d-none');
      if (ind) ind.classList.remove('d-none');
      if (title) title.textContent = 'Participants';
    }
  }

  function filterFormParticipants(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.participant-item-row').forEach(row => {
      const name = row.dataset.searchName || '';
      row.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
  }

  function filterFormPoolQuestions(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-pool-question-card').forEach(card => {
      const title = card.dataset.questionTitle || '';
      card.classList.toggle('d-none', q && !title.includes(q));
    });
  }

  function filterFormBundles(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.form-bundle-card').forEach(card => {
      const nameEl = card.querySelector('[id*="form_bundle_name_display_"]');
      const name = nameEl ? nameEl.textContent.toLowerCase() : '';
      card.classList.toggle('d-none', q && !name.includes(q));
    });
  }

  function handleFormQuestionBundleSelect(qId, selectEl) {
    const bundleId = selectEl.value;
    if (!bundleId) return;

    const opt = selectEl.options[selectEl.selectedIndex];
    const bundleName = opt.dataset.bundleName;

    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    const poolCard = document.getElementById(`form_pool_card_${qId}`);

    if (container && poolCard) {
      const title = poolCard.querySelector('h6')?.textContent?.trim() || '';
      const qType = poolCard.querySelector('.badge.bg-secondary-subtle')?.textContent?.trim() || '';
      const dayRange = poolCard.querySelector('.badge.bg-info-subtle')?.textContent?.trim() || '';

      const itemCard = document.createElement('div');
      itemCard.className = 'bundle-question-item bg-white p-3 rounded-3 border shadow-xs position-relative hover-shadow-sm transition-all mb-2';
      itemCard.id = `form_bundle_item_card_${bundleId}_${qId}`;
      itemCard.innerHTML = `
        <input type="hidden" name="assignment[question_bundle_items][][question_id]" value="${qId}">
        <input type="hidden" name="assignment[question_bundle_items][][bundle_name]" value="${bundleName}">
        <div class="d-flex align-items-start gap-2">
          <div class="d-flex align-items-center gap-2 flex-shrink-0 pt-0.5">
            <input type="checkbox" name="assignment[question_ids][]" value="${qId}" class="form-check-input m-0 cursor-pointer" checked style="width: 1.1rem; height: 1.1rem;">
            <i class="bi bi-list fs-5 text-secondary drag-handle me-1" style="cursor: grab;"></i>
            <span class="badge bg-dark text-white rounded-pill px-2.5 py-1.5 fw-bold form-bundle-item-serial me-1" style="font-size: 0.75rem;">#1</span>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="fw-bold text-dark mb-0 text-break pe-1" style="font-size: 0.925rem;">${title}</div>
            <div class="d-flex align-items-center gap-2 mt-1">
              <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase" style="font-size: 0.7rem;">${qType}</span>
              <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold" style="font-size: 0.7rem;"><i class="bi bi-clock-history me-1"></i>${dayRange}</span>
            </div>
          </div>
          <div class="flex-shrink-0">
            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2 p-1" title="Remove from bundle" onclick="removeFormQuestionFromBundle(${bundleId}, ${qId})">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
      `;
      container.appendChild(itemCard);
      updateFormBundleItemSerials(bundleId);
      opt.disabled = true;
      selectEl.value = '';
    }
  }

  function removeFormQuestionFromBundle(bundleId, qId) {
    const card = document.getElementById(`form_bundle_item_card_${bundleId}_${qId}`);
    if (card) {
      card.remove();
      updateFormBundleItemSerials(bundleId);
      const select = document.querySelector(`.form-bundle-assign-select-${qId}`);
      if (select) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].value == bundleId) {
            select.options[i].disabled = false;
            break;
          }
        }
      }
    }
  }

  function updateFormBundleItemSerials(bundleId) {
    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (!container) return;
    const items = container.querySelectorAll('.bundle-question-item');
    items.forEach((item, idx) => {
      const serial = item.querySelector('.form-bundle-item-serial');
      if (serial) serial.textContent = `#${idx + 1}`;
    });
    const pill = document.getElementById(`form_bundle_q_count_pill_${bundleId}`);
    if (pill) pill.textContent = `${items.length} ${items.length === 1 ? 'question' : 'questions'}`;
  }

  function toggleAllFormBundles(btn) {
    const isExpanded = btn.getAttribute('data-expanded') !== 'false';
    const icon = document.getElementById('expand_collapse_all_icon');
    const text = document.getElementById('expand_collapse_all_text');

    if (isExpanded) {
      btn.setAttribute('data-expanded', 'false');
      if (icon) icon.className = 'bi bi-chevrons-up me-1';
      if (text) text.textContent = 'Expand All';
    } else {
      btn.setAttribute('data-expanded', 'true');
      if (icon) icon.className = 'bi bi-chevrons-down me-1';
      if (text) text.textContent = 'Collapse All';
    }
  }

