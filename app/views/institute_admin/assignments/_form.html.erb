  function removeFormQuestionFromBundle(bundleId, qId) {
    const card = document.getElementById(`form_bundle_item_card_${bundleId}_${qId}`);
    if (card) {
      card.remove();
      updateFormBundleItemSerials(bundleId);
      const select = document.querySelector(`.form-bundle-assign-select-${qId}`);
      if (select) {
        for (let i = 0; i < select.options.length; i++) {
          if (select.options[i].value == bundleId) {
            select.options[i].disabled = false;
            break;
          }
        }
      }
    }
  }

  function updateFormBundleItemSerials(bundleId) {
    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (!container) return;
    const items = container.querySelectorAll('.bundle-question-item');
    items.forEach((item, idx) => {
      const serial = item.querySelector('.form-bundle-item-serial');
      if (serial) serial.textContent = `#${idx + 1}`;
    });
    const pill = document.getElementById(`form_bundle_q_count_pill_${bundleId}`);
    if (pill) pill.textContent = `${items.length} ${items.length === 1 ? 'question' : 'questions'}`;
  }

