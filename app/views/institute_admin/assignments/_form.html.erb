<%= form_with(model: [:institute_admin, @assignment], local: true, data: { controller: "assignment-form" }) do |f| %>
  <!-- Add hidden fields for empty arrays -->
  <%= hidden_field_tag "assignment[question_ids][]", nil %>

  <div class="row g-4">
    <!-- Left Column: Basic Info & Bundle Question Selection -->
    <div class="col-lg-8">
      <!-- Basic Info Card -->
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-3 rounded-top-4">
          <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-pencil-square text-primary"></i> Basic Information
          </h5>
        </div>
        <div class="card-body p-3 p-md-4">
          <% if @assignment.errors.any? %>
            <div class="alert alert-danger mb-4 rounded-3">
              <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please fix the following errors:</h6>
              <ul class="mb-0 ps-3 small">
                <% @assignment.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :title, "Assignment Title", class: "form-label fw-semibold text-dark" %>
            <%= f.text_field :title, 
                class: "form-control form-control-lg rounded-3",
                placeholder: "Enter assignment title...",
                data: { 
                  assignment_form_target: "titleInput",
                  action: "input->assignment-form#validateForm"
                } %>
          </div>

          <div class="mb-3">
            <%= f.label :description, "Description (Optional)", class: "form-label fw-semibold text-dark" %>
            <%= f.text_area :description, class: "form-control rounded-3", rows: 3,
                placeholder: "Brief summary or instructions for participants...",
                data: { 
                  assignment_form_target: "descriptionInput",
                  action: "input->assignment-form#validateForm"
                } %>
          </div>

          <div class="d-flex align-items-center justify-content-between mb-2">
            <label class="form-label fw-semibold text-dark small mb-0">Schedule Duration</label>
            <% current_duration = (@assignment.end_date.present? && @assignment.start_date.present?) ? ((@assignment.end_date.to_date - @assignment.start_date.to_date).to_i + 1) : 30 %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold shadow-xs" id="selected_days_badge" style="font-size: 0.75rem;">
              <i class="bi bi-calendar-range me-1 text-primary"></i><span id="selected_days_text"><%= current_duration %> <%= current_duration == 1 ? 'Day' : 'Days' %> Selected</span>
            </span>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-group">
                <%= f.label :start_date, "Start Date", class: "form-label fw-semibold text-dark small" %>
                <%= f.date_field :start_date, 
                    class: "form-control rounded-3 border-secondary-subtle",
                    id: "assignment_start_date",
                    onchange: "autoUpdateAssignmentEndDate(); updateAssignmentSelectedDaysCount();",
                    oninput: "updateAssignmentSelectedDaysCount();",
                    data: { assignment_form_target: "startDate" } %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <%= f.label :end_date, "End Date", class: "form-label fw-semibold text-dark small" %>
                <%= f.date_field :end_date, 
                    class: "form-control rounded-3 border-secondary-subtle",
                    id: "assignment_end_date",
                    onchange: "updateAssignmentSelectedDaysCount()",
                    oninput: "updateAssignmentSelectedDaysCount()",
                    data: { assignment_form_target: "endDate" } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bundle Questions Selection Card -->
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-3 rounded-top-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div>
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
              <i class="bi bi-layers-fill text-warning"></i> Question Bundles & Sequence
            </h5>
            <span class="text-muted small">Drag & drop or use arrows to reorder questions inside bundles.</span>
          </div>

          <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" onclick="toggleAllFormBundles(this)" data-expanded="true">
              <i class="bi bi-arrows-collapse me-1"></i> Collapse All
            </button>
            <div class="form-check mb-0 bg-light px-3 py-1.5 rounded-3 border d-flex align-items-center gap-2">
              <%= check_box_tag 'select_all_questions', 
                  nil, 
                  false, 
                  class: "form-check-input m-0 cursor-pointer",
                  data: { 
                    action: "change->assignment-form#toggleAllQuestions",
                    assignment_form_target: "selectAllQuestions"
                  } %>
              <%= label_tag 'select_all_questions', 'Select All Questions', class: "form-check-label fw-semibold small text-dark cursor-pointer mb-0" %>
            </div>
          </div>
        </div>

        <div class="card-body p-3 p-md-4">
          <% grouped = @grouped_questions.presence || @assignment.edit_questions_grouped_by_bundle %>
          <% if grouped.present? && grouped.any? %>
            <div class="d-flex flex-column gap-4">
              <% grouped.each_with_index do |(group_name, questions), b_idx| %>
                <% is_custom_group = (group_name == "Institution Custom Questions") %>
                <div class="card border rounded-4 bg-white shadow-sm p-3" data-is-custom-group="<%= is_custom_group %>">
                  <!-- Bundle Section Header with Collapse Toggle -->
                  <div class="card-header bg-light border-0 rounded-3 p-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 cursor-pointer bundle-header-toggle"
                       data-bs-toggle="collapse" 
                       data-bs-target="#edit_bundle_collapse_<%= b_idx %>" 
                       aria-expanded="true">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-chevron-down text-secondary transition-transform collapse-chevron"></i>
                      <i class="<%= is_custom_group ? 'bi bi-building-gear text-secondary' : 'bi bi-layers-fill text-primary' %>"></i>
                      <h6 class="fw-bold text-dark mb-0 fs-6"><%= group_name %></h6>
                      <span class="badge <%= is_custom_group ? 'bg-secondary-subtle text-secondary border border-secondary-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> rounded-pill px-2.5 py-1 fw-semibold ms-1">
                        <%= pluralize(questions.size, 'question') %>
                      </span>
                    </div>

                    <!-- Bundle-level toggle or Custom Area Info -->
                    <% if is_custom_group %>
                      <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2.5 py-1 small">
                          <i class="bi bi-info-circle me-1"></i> Click "+ Add to Bundle" to assign questions
                        </span>
                      </div>
                    <% else %>
                      <% is_bundle_all_selected = questions.any? && questions.all? { |q| @assignment.question_ids.include?(q.id) } %>
                      <div class="form-check mb-0 d-flex align-items-center gap-2" onclick="event.stopPropagation()">
                        <input type="checkbox" class="form-check-input bundle-select-all m-0 cursor-pointer" 
                               id="bundle_toggle_<%= b_idx %>" 
                               <%= 'checked' if is_bundle_all_selected %>
                               onclick="toggleBundleQuestions(this, 'bundle_group_<%= b_idx %>')">
                        <label class="form-check-label small fw-semibold text-dark cursor-pointer mb-0" for="bundle_toggle_<%= b_idx %>">
                          Select All
                        </label>
                      </div>
                    <% end %>
                  </div>

                  <!-- Questions in Bundle Collapse -->
                  <div class="collapse show bundle-collapse-container mt-3" id="edit_bundle_collapse_<%= b_idx %>">
                    <div class="d-flex flex-column gap-3 bundle-questions-container" id="bundle_group_<%= b_idx %>" data-is-custom-container="<%= is_custom_group %>">
                      <% available_bundles = grouped.each_with_index.select { |(name, _), _| name != group_name } %>
                      <% questions.each_with_index do |q, q_idx| %>
                      <% is_checked = @assignment.question_ids.include?(q.id) %>
                      <% show_checkbox = !is_custom_group %>
                      <% added_count_in_erb = is_custom_group ? available_bundles.count { |(target_name, target_questions), _| target_questions.any? { |tq| tq.id == q.id } } : 0 %>
                      <% total_bundles_in_erb = is_custom_group ? available_bundles.size : 0 %>
                      <% is_added_to_all_bundles = is_custom_group && total_bundles_in_erb > 0 && added_count_in_erb == total_bundles_in_erb %>
                      <div class="card border border-light-subtle rounded-3 p-3 bg-white shadow-sm hover-shadow transition-all question-item-card position-relative <%= 'opacity-50 bg-light-subtle' if is_added_to_all_bundles %>" <%= 'draggable="true"' unless is_custom_group %> data-question-id="<%= q.id %>">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                          
                          <!-- Left Controls: Drag Handle + Checkbox + Question Details -->
                          <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
                            
                            <!-- Drag Handle Container (Only inside bundles) -->
                            <% unless is_custom_group %>
                              <div class="d-flex align-items-center pe-3 border-end text-muted flex-shrink-0">
                                <span class="drag-handle p-1.5 rounded-2 bg-light hover-bg-secondary-subtle cursor-grab" title="Drag to move/reorder question">
                                  <i class="bi bi-grip-vertical fs-5 text-secondary"></i>
                                </span>
                              </div>
                            <% end %>

                            <!-- Checkbox -->
                            <div class="form-check mb-0 pe-2 flex-shrink-0 question-checkbox-wrapper <%= 'd-none' unless show_checkbox %>">
                              <%= check_box_tag "assignment[question_bundle_items][][question_id]", q.id, (is_checked && show_checkbox),
                                  class: "form-check-input question-checkbox fs-5 cursor-pointer m-0",
                                  id: "question_chk_#{b_idx}_#{q_idx}_#{q.id}",
                                  data: { 
                                    action: "change->assignment-form#updateCounter change->assignment-form#updateSelectAllQuestions"
                                  } %>
                              <input type="hidden" name="assignment[question_bundle_items][][bundle_name]" value="<%= group_name %>" class="question-bundle-name-input" <%= 'disabled' unless (is_checked && show_checkbox) %>>
                            </div>

                            <!-- Main Question Information -->
                            <div class="flex-grow-1 overflow-hidden">
                              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <label for="question_chk_<%= q.id %>" class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold cursor-pointer question-position-badge" style="font-size: 0.75rem;">
                                  #<%= q_idx + 1 %>
                                </label>

                                <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase" style="font-size: 0.7rem;">
                                  <%= q.question_type&.titleize %>
                                </span>

                                <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold" style="font-size: 0.7rem;">
                                  <i class="bi bi-clock-history me-1"></i> <%= q.day_range_text %>
                                </span>

                                <% if q.required? %>
                                  <span class="badge bg-danger-subtle text-danger fw-semibold" style="font-size: 0.7rem;">
                                    Required
                                  </span>
                                <% end %>

                                <% if is_custom_group && is_added_to_all_bundles %>
                                  <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold added-status-badge" style="font-size: 0.7rem;">
                                    <i class="bi bi-check2-all me-1"></i> Added to All Bundles
                                  </span>
                                <% elsif is_custom_group && added_count_in_erb > 0 %>
                                  <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold added-status-badge" style="font-size: 0.7rem;">
                                    <i class="bi bi-check2 me-1"></i> Added (<%= added_count_in_erb %>/<%= total_bundles_in_erb %>)
                                  </span>
                                <% end %>
                              </div>

                              <label for="question_chk_<%= q.id %>" class="fw-bold text-dark mb-1 d-block cursor-pointer text-truncate" style="font-size: 0.95rem; line-height: 1.4;">
                                <%= q.title %>
                              </label>

                              <% if q.description.present? %>
                                <p class="text-muted small mb-1 text-truncate"><%= q.description %></p>
                              <% end %>

                              <% if q.requires_options? && q.options.any? %>
                                <div class="text-muted small">
                                  <i class="bi bi-list-check me-1 text-primary"></i> <%= q.options.size %> Answer Options
                                </div>
                              <% elsif q.rating? %>
                                <div class="text-muted small">
                                  <i class="bi bi-star-fill me-1 text-warning"></i> Max Scale: <%= q.max_rating || 5 %> Stars
                                </div>
                              <% end %>
                            </div>
                          </div>

                          <!-- Right Action: Add to Bundle + Preview Buttons -->
                          <div class="ps-2 flex-shrink-0 d-flex align-items-center gap-2">
                            <% if is_custom_group %>
                              <% if available_bundles.size == 1 %>
                                <% target_name, target_questions = available_bundles.first.first %>
                                <% target_idx = available_bundles.first.last %>
                                <% is_added = target_questions.any? { |tq| tq.id == q.id } %>
                                <% if is_added %>
                                  <button type="button" class="btn btn-sm btn-secondary text-nowrap disabled opacity-75 add-to-bundle-single-btn" 
                                          data-target-container-id="bundle_group_<%= target_idx %>" disabled>
                                    <i class="bi bi-check2-all me-1"></i> Added to All Bundles
                                  </button>
                                <% else %>
                                  <button type="button" class="btn btn-sm btn-primary rounded-3 px-2.5 py-1.5 d-inline-flex align-items-center gap-1 text-nowrap fw-semibold add-to-bundle-single-btn" 
                                          data-target-container-id="bundle_group_<%= target_idx %>"
                                          onclick="moveQuestionToBundle(this, 'bundle_group_<%= target_idx %>')">
                                    <i class="bi bi-plus-lg me-1"></i> Add to Bundle
                                  </button>
                                <% end %>
                              <% elsif available_bundles.size > 1 %>
                                <div class="dropdown add-to-bundle-dropdown">
                                  <button type="button" 
                                          class="btn btn-sm <%= is_added_to_all_bundles ? 'btn-secondary disabled opacity-75' : 'btn-primary' %> rounded-3 px-2.5 py-1.5 fw-semibold dropdown-toggle add-to-bundle-main-btn text-nowrap" 
                                          data-bs-toggle="dropdown" 
                                          aria-expanded="false" 
                                          <%= 'disabled' if is_added_to_all_bundles %>>
                                    <% if is_added_to_all_bundles %>
                                      <i class="bi bi-check2-all me-1"></i> Added to All Bundles
                                    <% elsif added_count_in_erb > 0 %>
                                      <i class="bi bi-check2 me-1"></i> Added (<%= added_count_in_erb %>/<%= total_bundles_in_erb %> Bundles)
                                    <% else %>
                                      <i class="bi bi-plus-lg me-1"></i> Add to Bundle
                                    <% end %>
                                  </button>
                                  <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <% available_bundles.each do |(target_name, target_questions), t_idx| %>
                                      <% is_added = target_questions.any? { |tq| tq.id == q.id } %>
                                      <li>
                                        <button type="button" 
                                                class="dropdown-item d-flex align-items-center justify-content-between gap-2 add-to-bundle-item <%= 'disabled text-muted bg-light' if is_added %>" 
                                                data-target-container-id="bundle_group_<%= t_idx %>" 
                                                data-bundle-name="<%= target_name %>"
                                                <%= 'disabled' if is_added %>
                                                onclick="moveQuestionToBundle(this, 'bundle_group_<%= t_idx %>')">
                                          <span>↳ <%= target_name %></span>
                                          <% if is_added %>
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">Added</span>
                                          <% end %>
                                        </button>
                                      </li>
                                    <% end %>
                                  </ul>
                                </div>
                              <% else %>
                                <button type="button" class="btn btn-sm btn-secondary rounded-3 px-2.5 py-1.5 text-nowrap disabled" title="No bundles available">
                                  <i class="bi bi-plus-lg me-1"></i> Add to Bundle
                                </button>
                              <% end %>
                            <% else %>
                              <% is_custom_question = (q.question_category_id != @assignment.question_category_id || q.question_category_id.nil?) %>
                              <% if is_custom_question %>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-3 px-2 py-1 remove-from-bundle-btn" 
                                        onclick="removeQuestionCard(this)" title="Remove custom question from bundle">
                                  <i class="bi bi-trash text-danger fs-6"></i>
                                </button>
                              <% end %>
                            <% end %>

                            <button type="button" class="btn btn-sm btn-light text-secondary border rounded-3 px-2.5 py-1.5 d-inline-flex align-items-center gap-1.5 text-nowrap" 
                                    data-bs-toggle="modal" data-bs-target="#editQuestionModal<%= q.id %>">
                              <i class="bi bi-eye text-primary"></i> Preview
                            </button>
                          </div>

                        </div>
                      </div>

                      <!-- Modal: Question Preview -->
                      <div class="modal fade" id="editQuestionModal<%= q.id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                          <div class="modal-content rounded-4 border-0 shadow-lg">
                            <div class="modal-header border-bottom-0 pb-0">
                              <h5 class="modal-title font-weight-bold d-flex align-items-center gap-2">
                                <i class="bi bi-eye-fill text-primary"></i> Question Details
                              </h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                              <div class="mb-3">
                                <span class="badge bg-secondary-subtle text-dark text-uppercase px-2.5 py-1 mb-2" style="font-size: 0.75rem;">
                                  <%= q.question_type&.titleize %>
                                </span>
                                <h4 class="fw-bold text-dark mb-2"><%= q.title %></h4>
                                <% if q.description.present? %>
                                  <div class="p-3 bg-light rounded-3 text-muted small mb-3"><%= q.description %></div>
                                <% end %>
                              </div>

                              <% if q.requires_options? && q.options.any? %>
                                <div class="mb-3">
                                  <h6 class="fw-semibold text-dark mb-2">Answer Options (<%= q.options.size %>):</h6>
                                  <div class="list-group rounded-3">
                                    <% q.options.each_with_index do |opt, opt_idx| %>
                                      <div class="list-group-item d-flex align-items-center justify-content-between">
                                        <span><%= opt_idx + 1 %>. <%= opt.text %></span>
                                        <% if opt.correct? %>
                                          <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Correct Answer
                                          </span>
                                        <% end %>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                              <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
            </div>
          <% else %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-journal-x fs-1 opacity-50 d-block mb-2 text-warning"></i>
              <p class="mb-0">No questions available for selection.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column: Type & Participants -->
    <div class="col-lg-4">
      <div class="d-flex flex-column gap-4">
        <!-- Assignment Type Card -->
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-white border-bottom p-3 rounded-top-4">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
              <i class="bi bi-sliders text-primary"></i> Assignment Type
            </h5>
          </div>
          <div class="card-body p-3">
            <div class="btn-group w-100 p-1 bg-light rounded-3 border" role="group">
              <%= f.radio_button :assignment_type, 'individual', 
                  class: "btn-check",
                  data: { action: "change->assignment-form#handleTypeChange" } %>
              <%= f.label :assignment_type_individual, class: "btn btn-outline-primary rounded-2 py-2 fw-semibold" do %>
                <i class="bi bi-person me-1.5"></i> Individual
              <% end %>

              <%= f.radio_button :assignment_type, 'section', 
                  class: "btn-check",
                  data: { action: "change->assignment-form#handleTypeChange" } %>
              <%= f.label :assignment_type_section, class: "btn btn-outline-primary rounded-2 py-2 fw-semibold" do %>
                <i class="bi bi-people me-1.5"></i> Section
              <% end %>
            </div>
          </div>
        </div>

        <!-- Recipients Card -->
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-header bg-white border-bottom p-3 rounded-top-4 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
              <i class="bi bi-people-fill text-primary"></i> Participants
            </h5>
            <div class="form-check mb-0 d-none" id="recipients-select-all-container" data-assignment-form-target="recipientsSelectAllContainer">
              <%= check_box_tag 'select_all_recipients', 
                  nil, 
                  false, 
                  class: "form-check-input",
                  data: { 
                    action: "change->assignment-form#toggleAllParticipants",
                    assignment_form_target: "selectAllRecipients"
                  } %>
              <%= label_tag 'select_all_recipients', 'Select All', class: "form-check-label small fw-semibold text-dark" %>
            </div>
          </div>

          <div class="card-body p-0">
            <!-- Individual Selection View -->
            <div class="p-3 <%= @assignment.assignment_type == 'individual' ? '' : 'd-none' %>"
                 data-assignment-form-target="individualView">
              <div class="mb-3">
                <select id="participant-type-filter" class="form-select form-select-sm rounded-3"
                        data-action="change->assignment-form#filterParticipantsByType">
                  <option value="all">All Participant Types</option>
                  <option value="student">Students</option>
                  <option value="guardian">Guardians</option>
                  <option value="employee">Employees</option>
                </select>
              </div>

              <%
                initial_selected = current_institute.participants.where(id: @assignment.participant_ids)
                type_counts = initial_selected.group(:participant_type).count
              %>

              <div class="d-flex align-items-center justify-content-between mb-2 mt-1">
                <span class="text-dark small fw-bold">Assign Participants</span>
                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1.5 fw-semibold" style="font-size: 0.75rem;" data-assignment-form-target="participantsCounter">
                  <%= @assignment.participants.count %> Selected
                </span>
              </div>

              <div class="d-flex align-items-center gap-1.5 flex-wrap mb-3 <%= initial_selected.any? ? '' : 'd-none' %>" data-assignment-form-target="participantBreakdown">
                <% type_counts.each do |type, cnt| %>
                  <% 
                    badge_class = case type.to_s
                      when 'student' then 'bg-info-subtle text-info border-info-subtle'
                      when 'guardian' then 'bg-warning-subtle text-warning border-warning-subtle'
                      when 'employee' then 'bg-success-subtle text-success border-success-subtle'
                      else 'bg-secondary-subtle text-secondary border-secondary-subtle'
                    end
                    formatted_type = type == 'student' ? 'Student' : (type == 'guardian' ? 'Guardian' : (type == 'employee' ? 'Employee' : type.to_s.titleize))
                    label_str = "#{cnt} #{cnt == 1 ? formatted_type : formatted_type.pluralize}"
                  %>
                  <span class="badge <%= badge_class %> border rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.725rem;">
                    <%= label_str %>
                  </span>
                <% end %>
              </div>

              <div class="recipients-list list-group rounded-3 border overflow-auto" style="max-height: 340px;">
                <% current_institute.participants.active.includes(:user).each do |participant| %>
                  <div class="list-group-item p-2.5 border-bottom" data-participant-type="<%= participant.participant_type %>">
                    <div class="form-check mb-0 d-flex align-items-center gap-2">
                      <%= check_box_tag 'assignment[participant_ids][]', participant.id,
                          @assignment.participant_ids.include?(participant.id),
                          class: "form-check-input participant-checkbox",
                          id: "participant_#{participant.id}",
                          data: { 
                            action: "change->assignment-form#updateParticipantsCounter change->assignment-form#updateSelectAllRecipients"
                          } %>
                      <%= label_tag "participant_#{participant.id}", class: "form-check-label small mb-0 flex-grow-1 cursor-pointer" do %>
                        <div class="d-flex align-items-center justify-content-between">
                          <span class="fw-semibold text-dark"><%= participant.user&.full_name || "Participant #{participant.id}" %></span>
                          <span class="badge bg-<%= participant.student? ? 'info' : participant.guardian? ? 'warning' : 'secondary' %> bg-opacity-75" style="font-size: 0.7em;">
                            <%= participant.participant_type&.capitalize %>
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Section Selection View -->
            <div class="p-3 <%= @assignment.assignment_type == 'section' ? '' : 'd-none' %>"
                 data-assignment-form-target="sectionView">
              <div class="card border rounded-3 mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                  <h6 class="mb-0 fw-bold text-dark small">Select Target Sections</h6>
                  <div class="form-check mb-0">
                    <%= check_box_tag 'select_all_sections', 
                        nil, 
                        @assignment.sections.count == current_institute.sections.active.joins(:participants).distinct.count,
                        class: "form-check-input",
                        data: { 
                          action: "change->assignment-form#toggleAllSections",
                          assignment_form_target: "selectAllSections"
                        } %>
                    <%= label_tag 'select_all_sections', 'Select All', class: "form-check-label small fw-semibold text-dark" %>
                  </div>
                </div>
                <div class="card-body p-3">
                  <div class="sections-list">
                    <% sections_with_participants = current_institute.sections.active.joins(:participants).distinct %>
                    <% if sections_with_participants.any? %>
                      <% sections_with_participants.each do |section| %>
                        <div class="form-check mb-2">
                          <%= check_box_tag 'assignment[section_ids][]', 
                              section.id, 
                              @assignment.section_ids.include?(section.id),
                              id: "section_#{section.id}",
                              class: "form-check-input section-checkbox",
                              data: { 
                                action: "change->assignment-form#handleSectionSelection",
                                section_id: section.id 
                              } %>
                          <%= label_tag "section_#{section.id}", 
                              section.name.presence || "Section #{section.id}", 
                              class: "form-check-label fw-semibold text-dark small" %>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="alert alert-info mb-0 small">
                        <i class="bi bi-info-circle me-1"></i> No active sections with participants available.
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Section Participants Container -->
              <div data-assignment-form-target="sectionParticipantsContainer">
                <% if @assignment.persisted? && @assignment.assignment_type == 'section' %>
                  <% @assignment.sections.each do |section| %>
                    <div id="section_<%= section.id %>_participants" class="card border rounded-3 mb-3">
                      <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                        <h6 class="mb-0 fw-bold text-dark small"><%= section.name.presence || "Section #{section.id}" %></h6>
                        <span class="badge bg-secondary rounded-pill"><%= section.participants.count %> participants</span>
                      </div>
                      <div class="card-body p-3">
                        <% section.participants.includes(:user).each do |participant| %>
                          <div class="form-check mb-1.5" data-participant-type="<%= participant.participant_type %>">
                            <%= check_box_tag 'assignment[participant_ids][]',
                                participant.id,
                                @assignment.participant_ids.include?(participant.id),
                                id: "participant_#{participant.id}",
                                class: "form-check-input section-#{section.id}-participant",
                                data: {
                                  action: "change->assignment-form#updateCounter change->assignment-form#updateSectionSelectAll",
                                  section_id: section.id
                                } %>
                            <%= label_tag "participant_#{participant.id}", class: "form-check-label small" do %>
                              <%= participant.user&.full_name || "Participant #{participant.id}" %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
              
              <div class="d-none" data-assignment-form-target="sectionParticipantsView">
                <div data-assignment-form-target="sectionParticipantsList"></div>
                <span data-assignment-form-target="sectionParticipantsCounter">0 Selected</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Questions Summary Card -->
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-3 d-flex align-items-center justify-content-between">
            <span class="fw-semibold text-dark">Selected Questions:</span>
            <span class="badge bg-primary rounded-pill px-3 py-1.5 fs-6 fw-bold" data-assignment-form-target="questionsCounter">
              <%= @assignment.questions.count %> Selected
            </span>
          </div>
        </div>

        <!-- Submit Action Buttons -->
        <div class="d-grid gap-2">
          <%= f.submit "Save Assignment Changes", class: "btn btn-primary btn-lg rounded-3 shadow-sm py-2.5 fw-bold",
              data: { assignment_form_target: "submitButton" } %>
          <%= link_to "Cancel", institute_admin_assignments_path, 
              class: "btn btn-outline-secondary rounded-3 py-2 text-center" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  function toggleBundleQuestions(masterCheckbox, containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const isChecked = masterCheckbox.checked;
    const checkboxes = container.querySelectorAll('.question-checkbox');
    
    checkboxes.forEach(cb => {
      cb.checked = isChecked;
    });

    masterCheckbox.checked = isChecked;
    updateFormCounters(container);
  }

  function updateBundleIndices(container) {
    const cards = container.querySelectorAll('.question-item-card');
    cards.forEach((c, index) => {
      const badge = c.querySelector('.question-position-badge');
      if (badge) badge.textContent = '#' + (index + 1);
    });
  }

  function prepareClonedQuestionCard(clonedCard, targetBundleName) {
    // 1. Show and check the checkbox in cloned card
    const cbWrapper = clonedCard.querySelector('.question-checkbox-wrapper');
    const cb = clonedCard.querySelector('.question-checkbox');
    if (cbWrapper) {
      cbWrapper.classList.remove('d-none');
      cbWrapper.style.display = 'block';
    }
    if (cb) {
      cb.checked = true;
      cb.setAttribute('checked', 'checked');
      cb.name = 'assignment[question_bundle_items][][question_id]';
    }

    let bInput = clonedCard.querySelector('.question-bundle-name-input');
    if (!bInput) {
      bInput = document.createElement('input');
      bInput.type = 'hidden';
      bInput.className = 'question-bundle-name-input';
      if (cbWrapper) cbWrapper.appendChild(bInput);
      else clonedCard.appendChild(bInput);
    }
    bInput.name = 'assignment[question_bundle_items][][bundle_name]';
    bInput.value = targetBundleName || '';
    bInput.disabled = false;

    // 2. Add Drag handle if not present
    clonedCard.setAttribute('draggable', 'true');
    const leftControls = clonedCard.querySelector('.d-flex.align-items-center.gap-3.flex-grow-1');
    if (leftControls && !leftControls.querySelector('.drag-handle')) {
      const dragContainer = document.createElement('div');
      dragContainer.className = 'd-flex align-items-center pe-3 border-end text-muted flex-shrink-0';
      dragContainer.innerHTML = `
        <span class="drag-handle p-1.5 rounded-2 bg-light hover-bg-secondary-subtle cursor-grab" title="Drag to move/reorder question">
          <i class="bi bi-grip-vertical fs-5 text-secondary"></i>
        </span>
      `;
      leftControls.insertBefore(dragContainer, leftControls.firstChild);
    }

    // 3. Remove ALL Add to Bundle buttons, dropdowns, status badges, and opacity from cloned card
    clonedCard.classList.remove('opacity-50', 'bg-light-subtle');
    clonedCard.querySelectorAll('.added-status-badge, .add-to-bundle-btn-wrapper, .add-to-bundle-single-btn, .add-to-bundle-wrapper, [class*="add-to-bundle"]').forEach(el => el.remove());

    // 4. Add remove trash button to cloned card if not present
    const actionContainer = clonedCard.querySelector('.ps-2.flex-shrink-0');
    if (actionContainer && !actionContainer.querySelector('.remove-from-bundle-btn')) {
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-sm btn-outline-danger border-0 rounded-3 px-2 py-1 remove-from-bundle-btn';
      removeBtn.title = 'Remove question from bundle';
      removeBtn.onmousedown = function(e) { e.stopPropagation(); };
      removeBtn.onclick = function(e) { e.stopPropagation(); removeQuestionCard(this); };
      removeBtn.innerHTML = '<i class="bi bi-trash text-danger fs-6"></i>';
      actionContainer.insertBefore(removeBtn, actionContainer.firstChild);
    }
  }

  function showToastMessage(message, type = 'success') {
    let container = document.getElementById('assignment-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'assignment-toast-container';
      container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
      container.style.zIndex = '9999';
      document.body.appendChild(container);
    }

    const toastEl = document.createElement('div');
    toastEl.className = `toast align-items-center text-white bg-${type === 'warning' ? 'danger' : 'success'} border-0 shadow-lg show`;
    toastEl.setAttribute('role', 'alert');
    toastEl.setAttribute('aria-live', 'assertive');
    toastEl.setAttribute('aria-atomic', 'true');
    toastEl.innerHTML = `
      <div class="d-flex">
        <div class="toast-body d-flex align-items-center gap-2">
          <i class="bi bi-${type === 'warning' ? 'trash-fill' : 'check-circle-fill'} fs-6"></i>
          <span>${message}</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest('.toast').remove()"></button>
      </div>
    `;

    container.appendChild(toastEl);
    setTimeout(() => {
      if (toastEl.parentNode) {
        toastEl.classList.remove('show');
        setTimeout(() => toastEl.remove(), 300);
      }
    }, 2500);
  }

  function updateAddControlsForQuestion(questionId) {
    if (!questionId) return;

    // All custom cards in Custom Questions pool matching this question ID
    const customCards = Array.from(document.querySelectorAll('.question-item-card[data-question-id="' + questionId + '"]'))
                             .filter(c => c.closest('.card[data-is-custom-group="true"]'));

    // All target bundle containers
    const targetContainers = Array.from(document.querySelectorAll('.bundle-questions-container[data-is-custom-container="false"]'));

    let addedCount = 0;
    targetContainers.forEach(container => {
      if (container.querySelector('.question-item-card[data-question-id="' + questionId + '"]')) {
        addedCount++;
      }
    });

    const totalBundles = targetContainers.length;
    const addedToAll = totalBundles > 0 && addedCount === totalBundles;

    customCards.forEach(card => {
      const badgeContainer = card.querySelector('.d-flex.align-items-center.gap-2.mb-1.flex-wrap');
      let statusBadge = card.querySelector('.added-status-badge');

      if (addedToAll) {
        card.classList.add('opacity-50', 'bg-light-subtle');
        if (badgeContainer) {
          if (!statusBadge) {
            statusBadge = document.createElement('span');
            badgeContainer.appendChild(statusBadge);
          }
          statusBadge.className = 'badge bg-success-subtle text-success border border-success-subtle fw-semibold added-status-badge';
          statusBadge.style.fontSize = '0.7rem';
          statusBadge.innerHTML = '<i class="bi bi-check2-all me-1"></i> Added to All Bundles';
        }
      } else if (addedCount > 0) {
        card.classList.remove('opacity-50', 'bg-light-subtle');
        if (badgeContainer) {
          if (!statusBadge) {
            statusBadge = document.createElement('span');
            badgeContainer.appendChild(statusBadge);
          }
          statusBadge.className = 'badge bg-info-subtle text-info border border-info-subtle fw-semibold added-status-badge';
          statusBadge.style.fontSize = '0.7rem';
          statusBadge.innerHTML = `<i class="bi bi-check2 me-1"></i> Added (${addedCount}/${totalBundles})`;
        }
      } else {
        card.classList.remove('opacity-50', 'bg-light-subtle');
        if (statusBadge) statusBadge.remove();
      }

      // Update Bootstrap Dropdown Menu & Main Button
      const dropdownMainBtn = card.querySelector('.add-to-bundle-main-btn');
      const dropdownItems = card.querySelectorAll('.add-to-bundle-item');

      if (dropdownMainBtn) {
        if (addedToAll) {
          dropdownMainBtn.disabled = true;
          dropdownMainBtn.className = 'btn btn-sm btn-secondary text-nowrap disabled opacity-75 dropdown-toggle add-to-bundle-main-btn rounded-3 px-2.5 py-1.5 fw-semibold';
          dropdownMainBtn.innerHTML = '<i class="bi bi-check2-all me-1"></i> Added to All Bundles';
        } else if (addedCount > 0) {
          dropdownMainBtn.disabled = false;
          dropdownMainBtn.className = 'btn btn-sm btn-primary text-nowrap dropdown-toggle add-to-bundle-main-btn rounded-3 px-2.5 py-1.5 fw-semibold';
          dropdownMainBtn.innerHTML = `<i class="bi bi-check2 me-1"></i> Added (${addedCount}/${totalBundles} Bundles)`;
        } else {
          dropdownMainBtn.disabled = false;
          dropdownMainBtn.className = 'btn btn-sm btn-primary text-nowrap dropdown-toggle add-to-bundle-main-btn rounded-3 px-2.5 py-1.5 fw-semibold';
          dropdownMainBtn.innerHTML = '<i class="bi bi-plus-lg me-1"></i> Add to Bundle';
        }
      }

      dropdownItems.forEach(item => {
        const targetContainerId = item.getAttribute('data-target-container-id');
        const bundleName = item.getAttribute('data-bundle-name') || '';
        if (targetContainerId) {
          const container = document.getElementById(targetContainerId);
          const exists = container && container.querySelector('.question-item-card[data-question-id="' + questionId + '"]') !== null;
          if (exists) {
            item.disabled = true;
            item.className = 'dropdown-item d-flex align-items-center justify-content-between gap-2 add-to-bundle-item disabled text-muted bg-light';
            item.innerHTML = `<span>↳ ${bundleName}</span><span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">Added</span>`;
          } else {
            item.disabled = false;
            item.className = 'dropdown-item d-flex align-items-center justify-content-between gap-2 add-to-bundle-item';
            item.innerHTML = `<span>↳ ${bundleName}</span>`;
          }
        }
      });

      // Update Single Button
      const singleBtn = card.querySelector('.add-to-bundle-single-btn');
      if (singleBtn) {
        const targetContainerId = singleBtn.getAttribute('data-target-container-id');
        if (targetContainerId) {
          const container = document.getElementById(targetContainerId);
          const exists = container && container.querySelector('.question-item-card[data-question-id="' + questionId + '"]') !== null;
          if (addedToAll || exists) {
            singleBtn.disabled = true;
            singleBtn.className = 'btn btn-sm btn-secondary text-nowrap disabled opacity-75 add-to-bundle-single-btn';
            singleBtn.innerHTML = addedToAll ? '<i class="bi bi-check2-all me-1"></i> Added to All Bundles' : '<i class="bi bi-check2 me-1"></i> Added to Bundle';
          } else {
            singleBtn.disabled = false;
            singleBtn.className = 'btn btn-sm btn-primary rounded-3 px-2.5 py-1.5 d-inline-flex align-items-center gap-1 text-nowrap fw-semibold add-to-bundle-single-btn';
            singleBtn.innerHTML = '<i class="bi bi-plus-lg me-1"></i> Add to Bundle';
          }
        }
      }
    });
  }

  function updateAllAddControls() {
    const questionCards = document.querySelectorAll('.card[data-is-custom-group="true"] .question-item-card[data-question-id]');
    const qIds = Array.from(questionCards).map(c => c.getAttribute('data-question-id'));
    const uniqueIds = Array.from(new Set(qIds));
    uniqueIds.forEach(id => updateAddControlsForQuestion(id));
  }

  function moveQuestionToBundle(btn, targetContainerId) {
    // Hide parent dropdown menu if button is inside a dropdown
    const dropdownWrapper = btn.closest('.dropdown');
    if (dropdownWrapper) {
      const toggle = dropdownWrapper.querySelector('[data-bs-toggle="dropdown"]');
      const menu = dropdownWrapper.querySelector('.dropdown-menu');
      if (toggle && window.bootstrap && window.bootstrap.Dropdown) {
        const bsDropdown = window.bootstrap.Dropdown.getInstance(toggle) || new window.bootstrap.Dropdown(toggle);
        if (bsDropdown) bsDropdown.hide();
      }
      if (toggle) toggle.classList.remove('show');
      if (menu) menu.classList.remove('show');
    }

    const card = btn.closest('.question-item-card');
    const targetContainer = document.getElementById(targetContainerId);
    if (!card || !targetContainer) return;

    const qId = card.getAttribute('data-question-id');

    // Prevent duplicate questions in the target bundle!
    if (qId && targetContainer.querySelector(`.question-item-card[data-question-id="${qId}"]`)) {
      return;
    }

    const targetHeader = targetContainer.closest('.card')?.querySelector('.bundle-header-toggle h6')?.textContent?.trim() || 'Bundle';

    // Clone the question card so it remains in the Custom Questions pool!
    const clonedCard = card.cloneNode(true);
    prepareClonedQuestionCard(clonedCard, targetHeader);

    // Append cloned card to target bundle container
    targetContainer.appendChild(clonedCard);

    // Re-bind drag events to cloned card
    if (window.bindDragEventsToCard) {
      window.bindDragEventsToCard(clonedCard);
    }

    // Update bundle question position numbers
    document.querySelectorAll('.bundle-questions-container').forEach(updateBundleIndices);
    updateFormCounters(targetContainer);
    if (qId) updateAddControlsForQuestion(qId);

    showToastMessage(`Question added to <strong>${targetHeader}</strong>`);
  }

  function removeQuestionCard(btn) {
    const card = btn.closest('.question-item-card');
    if (!card) return;
    const qId = card.getAttribute('data-question-id');
    const container = card.parentElement;
    card.remove();
    if (container) {
      document.querySelectorAll('.bundle-questions-container').forEach(updateBundleIndices);
      updateFormCounters(container);
    }
    if (qId) updateAddControlsForQuestion(qId);

    showToastMessage('Question removed from bundle', 'warning');
  }

  function updateFormCounters(el) {
    const formElement = el.closest('form') || document.querySelector('form');
    if (formElement) {
      const questionsCounterTarget = formElement.querySelector('[data-assignment-form-target="questionsCounter"]');
      const count = formElement.querySelectorAll('.question-checkbox:checked').length;
      if (questionsCounterTarget) {
        questionsCounterTarget.textContent = `${count} Selected`;
      }

      const bundleCheckboxes = formElement.querySelectorAll('.bundle-questions-container[data-is-custom-container="false"] .question-checkbox');
      const checkboxesToCount = bundleCheckboxes.length > 0 ? bundleCheckboxes : formElement.querySelectorAll('.question-checkbox');
      const totalQuestions = checkboxesToCount.length;
      const checkedCount = Array.from(checkboxesToCount).filter(cb => cb.checked).length;

      const selectAllQuestionsTarget = formElement.querySelector('[data-assignment-form-target="selectAllQuestions"]');
      if (selectAllQuestionsTarget) {
        selectAllQuestionsTarget.checked = totalQuestions > 0 && totalQuestions === checkedCount;
      }

      try {
        const app = window.StimulusApplication || window.Stimulus;
        const controller = app?.getControllerForElementAndIdentifier ? app.getControllerForElementAndIdentifier(formElement, 'assignment-form') : null;
        if (controller && typeof controller.validateForm === 'function') {
          controller.validateForm();
        }
      } catch (e) {
        console.warn("Stimulus form validation note:", e);
      }
    }
  }

  // HTML5 Drag and Drop implementation for question cards inside bundles only
  document.addEventListener('DOMContentLoaded', () => {
    initAllDragAndDrop();
    updateAllAddControls();
  });
  document.addEventListener('turbo:load', () => {
    initAllDragAndDrop();
    updateAllAddControls();
  });

  function initAllDragAndDrop() {
    let globalDraggedCard = null;

    window.bindDragEventsToCard = function(card) {
      if (card.closest('.bundle-questions-container[data-is-custom-container="true"]')) {
        card.removeAttribute('draggable');
        return;
      }

      card.setAttribute('draggable', 'true');
      card.addEventListener('dragstart', (e) => {
        globalDraggedCard = card;
        card.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
      });

      card.addEventListener('dragend', (e) => {
        card.classList.remove('dragging');
        document.querySelectorAll('.question-item-card').forEach(c => c.classList.remove('drag-over'));
        globalDraggedCard = null;
        document.querySelectorAll('.bundle-questions-container').forEach(updateBundleIndices);
      });
    };

    document.querySelectorAll('.bundle-questions-container[data-is-custom-container="false"] .question-item-card').forEach(window.bindDragEventsToCard);

    const containers = document.querySelectorAll('.bundle-questions-container[data-is-custom-container="false"]');
    containers.forEach(container => {
      container.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        if (!globalDraggedCard) return;

        const targetCard = e.target.closest('.question-item-card');
        if (targetCard && targetCard !== globalDraggedCard && container.contains(targetCard)) {
          const rect = targetCard.getBoundingClientRect();
          const offset = e.clientY - rect.top - rect.height / 2;
          if (offset > 0) {
            targetCard.after(globalDraggedCard);
          } else {
            targetCard.before(globalDraggedCard);
          }
        }
      });

      container.addEventListener('dragenter', (e) => {
        const targetCard = e.target.closest('.question-item-card');
        if (targetCard && targetCard !== globalDraggedCard) {
          targetCard.classList.add('drag-over');
        }
      });

      container.addEventListener('dragleave', (e) => {
        const targetCard = e.target.closest('.question-item-card');
        if (targetCard) {
          targetCard.classList.remove('drag-over');
        }
      });

      container.addEventListener('drop', (e) => {
        e.preventDefault();
        container.querySelectorAll('.question-item-card').forEach(c => c.classList.remove('drag-over'));
        if (!globalDraggedCard) return;

        const targetHeader = container.closest('.card')?.querySelector('.bundle-header-toggle h6')?.textContent?.trim() || '';
        const bInput = globalDraggedCard.querySelector('.question-bundle-name-input');
        if (bInput) bInput.value = targetHeader;

        const targetCard = e.target.closest('.question-item-card');
        if (targetCard && targetCard !== globalDraggedCard && container.contains(targetCard)) {
          targetCard.before(globalDraggedCard);
        } else if (!container.contains(globalDraggedCard)) {
          container.appendChild(globalDraggedCard);
        }

        document.querySelectorAll('.bundle-questions-container').forEach(updateBundleIndices);
        updateFormCounters(container);
      });
    });
  }

  function toggleAllFormBundles(btn) {
    const isExpanded = btn.getAttribute('data-expanded') !== 'false';
    const collapseContainers = document.querySelectorAll('.bundle-collapse-container');
    
    collapseContainers.forEach(container => {
      const bsCollapse = bootstrap.Collapse.getOrCreateInstance(container, { toggle: false });
      if (isExpanded) {
        bsCollapse.hide();
      } else {
        bsCollapse.show();
      }
    });

    if (isExpanded) {
      btn.setAttribute('data-expanded', 'false');
      btn.innerHTML = '<i class="bi bi-arrows-expand me-1"></i> Expand All';
    } else {
      btn.setAttribute('data-expanded', 'true');
      btn.innerHTML = '<i class="bi bi-arrows-collapse me-1"></i> Collapse All';
    }
  }

  function parseFormDate(str) {
    if (!str) return null;
    const parts = str.split('-');
    if (parts.length === 3) {
      return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    }
    return new Date(str);
  }

  function updateAssignmentSelectedDaysCount() {
    const startDateInput = document.getElementById('assignment_start_date') || document.querySelector('input[name="assignment[start_date]"]');
    const endDateInput = document.getElementById('assignment_end_date') || document.querySelector('input[name="assignment[end_date]"]');
    const textEl = document.getElementById('selected_days_text');
    const badgeEl = document.getElementById('selected_days_badge');

    if (!startDateInput || !endDateInput || !textEl) return;

    const start = parseFormDate(startDateInput.value);
    const end = parseFormDate(endDateInput.value);

    if (start && end && !isNaN(start.getTime()) && !isNaN(end.getTime())) {
      const diffTime = end.getTime() - start.getTime();
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
      const totalDays = diffDays >= 0 ? diffDays + 1 : 0;

      if (totalDays > 0) {
        textEl.textContent = `${totalDays} ${totalDays === 1 ? 'Day' : 'Days'} Selected`;
        if (badgeEl) {
          badgeEl.className = 'badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold shadow-xs';
        }
      } else {
        textEl.textContent = `Invalid Date Range`;
        if (badgeEl) {
          badgeEl.className = 'badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold shadow-xs';
        }
      }
    }
  }

  function autoUpdateAssignmentEndDate() {
    const startDateInput = document.getElementById('assignment_start_date') || document.querySelector('input[name="assignment[start_date]"]');
    const endDateInput = document.getElementById('assignment_end_date') || document.querySelector('input[name="assignment[end_date]"]');
    if (startDateInput && endDateInput && startDateInput.value) {
      const start = parseFormDate(startDateInput.value);
      if (start && !isNaN(start.getTime())) {
        const currentEnd = parseFormDate(endDateInput.value);
        let durationDays = 30;
        if (currentEnd && !isNaN(currentEnd.getTime()) && currentEnd >= start) {
          durationDays = Math.round((currentEnd.getTime() - start.getTime()) / (1000 * 60 * 60 * 24)) + 1;
        }
        start.setDate(start.getDate() + durationDays - 1);
        const year = start.getFullYear();
        const month = String(start.getMonth() + 1).padStart(2, '0');
        const day = String(start.getDate()).padStart(2, '0');
        endDateInput.value = `${year}-${month}-${day}`;
        updateAssignmentSelectedDaysCount();
      }
    }
  }

  document.addEventListener('DOMContentLoaded', updateAssignmentSelectedDaysCount);
  document.addEventListener('turbo:load', updateAssignmentSelectedDaysCount);
</script>

<% content_for :styles do %>
  <style>
    .cursor-pointer { cursor: pointer; }
    .cursor-grab { cursor: grab; }
    .cursor-grab:active { cursor: grabbing; }
    .transition-transform { transition: transform 0.2s ease-in-out; }

    .bundle-header-toggle[aria-expanded="false"] .collapse-chevron {
      transform: rotate(-90deg);
    }
    .bundle-header-toggle[aria-expanded="true"] .collapse-chevron {
      transform: rotate(0deg);
    }

    .question-item-card {
      user-select: none;
    }
    .question-item-card.dragging {
      opacity: 0.4;
      border: 2px dashed #0d6efd !important;
      background-color: #f0f7ff !important;
    }
    .question-item-card.drag-over {
      border-top: 3px solid #0d6efd !important;
    }

    .recipients-list::-webkit-scrollbar { width: 4px; }
    .recipients-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
<% end %>