  function openFormEditQuestionModal(qId) {
    window._edit_deleted_opt_ids = [];
    const card = document.getElementById(`form_pool_card_${qId}`);
    if (!card) return;

    const title = card.getAttribute('data-q-title') || card.dataset.qTitle || '';
    const desc = card.getAttribute('data-q-desc') || card.dataset.qDesc || '';
    const type = card.getAttribute('data-q-type') || card.dataset.qType || 'short_answer';
    const fromDay = card.getAttribute('data-q-from') || card.dataset.qFrom || 1;
    const toDay = card.getAttribute('data-q-to') || card.dataset.qTo || 30;

    let options = [];
    const optAttr = card.getAttribute('data-q-options') || card.dataset.qOptions;
    if (optAttr) {
      try {
        options = JSON.parse(optAttr);
      } catch (err) { options = []; }
    }

    const idInput = document.getElementById('edit_form_q_id');
    const titleInput = document.getElementById('edit_form_q_title');
    const typeInput = document.getElementById('edit_form_q_type');
    const fromInput = document.getElementById('edit_form_q_from_day');
    const toInput = document.getElementById('edit_form_q_to_day');
    const descInput = document.getElementById('edit_form_q_desc');

    if (idInput) idInput.value = qId;
    if (titleInput) titleInput.value = title;
    if (typeInput) typeInput.value = type;
    if (fromInput) fromInput.value = fromDay;
    if (toInput) toInput.value = toDay;
    if (descInput) descInput.value = desc;

    toggleFormQuestionOptionsVisibility('edit', type);

    const container = document.getElementById('edit_form_q_options_container');
    if (container) {
      container.innerHTML = '';
      if (options.length > 0) {
        options.forEach(opt => {
          addFormQuestionOptionRow('edit', opt.text || '', opt.id || '');
        });
      } else if (['multiple_choice', 'checkboxes', 'dropdown', 'yes_or_no'].includes(type)) {
        addFormQuestionOptionRow('edit', (type === 'yes_or_no' ? 'Yes' : ''));
        addFormQuestionOptionRow('edit', (type === 'yes_or_no' ? 'No' : ''));
      }
    }

    const modalEl = document.getElementById('editFormQuestionModal');
    if (modalEl) {
      if (window.bootstrap && window.bootstrap.Modal) {
        const modal = window.bootstrap.Modal.getInstance(modalEl) || new window.bootstrap.Modal(modalEl);
        modal.show();
      } else if (window.jQuery || window.$) {
        window.$(modalEl).modal('show');
      } else {
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
      }
    }
  }

  function submitEditFormQuestion(e) {
    e.preventDefault();
    const qId = document.getElementById('edit_form_q_id').value;
    const errorEl = document.getElementById('edit_q_modal_error');
    if (errorEl) errorEl.classList.add('d-none');

    const title = document.getElementById('edit_form_q_title').value.trim();
    const type = document.getElementById('edit_form_q_type').value;
    const fromDay = parseInt(document.getElementById('edit_form_q_from_day').value, 10) || 1;
    const toDay = parseInt(document.getElementById('edit_form_q_to_day').value, 10) || 30;
    const desc = document.getElementById('edit_form_q_desc').value.trim();

    if (!qId || !title) {
      if (errorEl) {
        errorEl.textContent = 'Question title is required.';
        errorEl.classList.remove('d-none');
      }
      return;
    }

    if (fromDay < 1) {
      if (errorEl) {
        errorEl.textContent = 'From Day must be at least 1.';
        errorEl.classList.remove('d-none');
      }
      return;
    }

    if (toDay < fromDay) {
      if (errorEl) {
        errorEl.textContent = 'To Day must be greater than or equal to From Day.';
        errorEl.classList.remove('d-none');
      }
      return;
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const optionsData = [];

    if (['multiple_choice', 'checkboxes', 'dropdown', 'yes_or_no'].includes(type)) {
      document.querySelectorAll('#edit_form_q_options_container .input-group').forEach(group => {
        const idInput = group.querySelector('.edit-q-opt-id');
        const textInput = group.querySelector('.edit-q-opt-text');
        if (textInput && textInput.value.trim()) {
          const item = { text: textInput.value.trim() };
          if (idInput && idInput.value) item.id = idInput.value;
          optionsData.push(item);
        }
      });

      if (window._edit_deleted_opt_ids && window._edit_deleted_opt_ids.length > 0) {
        window._edit_deleted_opt_ids.forEach(delId => {
          optionsData.push({ id: delId, _destroy: '1' });
        });
      }

      const activeOptions = optionsData.filter(o => o._destroy !== '1');
      if (activeOptions.length < 2) {
        if (errorEl) {
          errorEl.textContent = 'Questions requiring options must have at least 2 options.';
          errorEl.classList.remove('d-none');
        }
        return;
      }
    } else {
      const card = document.getElementById(`form_pool_card_${qId}`);
      const optAttr = card ? (card.getAttribute('data-q-options') || card.dataset.qOptions) : null;
      if (optAttr) {
        try {
          const existingOpts = JSON.parse(optAttr);
          existingOpts.forEach(opt => {
            if (opt && opt.id) optionsData.push({ id: opt.id, _destroy: '1' });
          });
        } catch (e) {}
      }
    }

    const payload = {
      question: {
        title: title,
        question_type: type,
        from_day: fromDay,
        to_day: toDay,
        description: desc,
        options_attributes: optionsData
      }
    };

    fetch(`/institute_admin/questions/${qId}.json`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(payload)
    })
    .then(async res => {
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.status === 'success' && data.question) {
        const q = data.question;
        const newId = q.id;
        const dayText = (q.from_day === q.to_day) ? `Day ${q.from_day}` : `Day ${q.from_day}-${q.to_day}`;

        const card = document.getElementById(`form_pool_card_${qId}`);
        if (card) {
          if (newId != qId) {
            card.id = `form_pool_card_${newId}`;
            const editBtn = card.querySelector('button[title="Edit Question"]');
            if (editBtn) editBtn.setAttribute('onclick', `openFormEditQuestionModal(${newId})`);
            const select = card.querySelector(`select[data-q-id="${qId}"]`);
            if (select) {
              select.className = select.className.replace(`form-bundle-assign-select-${qId}`, `form-bundle-assign-select-${newId}`);
              select.setAttribute('data-q-id', newId);
              select.setAttribute('onchange', `handleFormQuestionBundleSelect(${newId}, this)`);
            }
          }

          card.setAttribute('data-q-id', newId);
          card.setAttribute('data-question-title', q.title.toLowerCase());
          card.setAttribute('data-q-title', q.title);
          card.setAttribute('data-q-desc', q.description || '');
          card.setAttribute('data-q-type', q.question_type);
          card.setAttribute('data-q-from', q.from_day || 1);
          card.setAttribute('data-q-to', q.to_day || 30);
          card.setAttribute('data-q-options', JSON.stringify(q.options || []));
        }

        if (newId != qId) {
          document.querySelectorAll(`input[value="${qId}"]`).forEach(input => {
            if (input.name === 'assignment[question_bundle_items][][question_id]' || input.name === 'assignment[question_ids][]') {
              input.value = newId;
            }
          });
        }

        document.querySelectorAll(`.q-title-display-${qId}, .q-title-display-${newId}`).forEach(el => el.textContent = q.title);
        document.querySelectorAll(`.q-type-badge-${qId}, .q-type-badge-${newId}`).forEach(el => el.textContent = q.question_type.replace(/_/g, ' '));
        document.querySelectorAll(`.q-day-badge-${qId}, .q-day-badge-${newId}`).forEach(el => el.innerHTML = `<i class="bi bi-clock-history me-1"></i>${dayText}`);

        // Update View Details modal if present in DOM
        const viewModal = document.getElementById(`viewFormQuestionModal_${qId}`) || document.getElementById(`viewFormQuestionModal_${newId}`);
        if (viewModal) {
          if (newId != qId) viewModal.id = `viewFormQuestionModal_${newId}`;
          const optionsList = viewModal.querySelector('.list-group');
          if (optionsList && q.options) {
            optionsList.innerHTML = '';
            q.options.forEach((opt, idx) => {
              const optText = typeof opt === 'object' ? (opt.text || '') : opt;
              const itemDiv = document.createElement('div');
              itemDiv.className = 'list-group-item d-flex align-items-center justify-content-between';
              itemDiv.innerHTML = `<span>${idx + 1}. ${optText}</span>`;
              optionsList.appendChild(itemDiv);
            });
          }
        }

        // Recalculate schedule badges for any bundle items holding this question
        document.querySelectorAll(`.bundle-question-item input[name="assignment[question_bundle_items][][question_id]"][value="${newId}"]`).forEach(input => {
          const itemCard = input.closest('.bundle-question-item');
          if (itemCard) {
            const bundleContainer = itemCard.closest('.form-bundle-items-container');
            if (bundleContainer) {
              const bId = bundleContainer.id.replace('form_bundle_items_', '');
              updateFormBundleItemSchedules(bId);
            }
          }
        });

        const modalEl = document.getElementById('editFormQuestionModal');
        if (modalEl) {
          if (window.bootstrap && window.bootstrap.Modal) {
            const modal = window.bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
          } else if (window.jQuery || window.$) {
            window.$(modalEl).modal('hide');
          } else {
            modalEl.classList.remove('show');
            modalEl.style.display = 'none';
          }
        }
      } else {
        const errMsgs = data.errors || (data.message ? [data.message] : ['Failed to update question']);
        if (errorEl) {
          errorEl.textContent = Array.isArray(errMsgs) ? errMsgs.join(', ') : errMsgs;
          errorEl.classList.remove('d-none');
        }
      }
    })
    .catch(err => {
      console.error(err);
      if (errorEl) {
        errorEl.textContent = 'Error updating question. Please try again.';
        errorEl.classList.remove('d-none');
      }
    });
  }

  function parseFormDate(str) {
    if (!str) return null;
    const parts = str.split('-');
    if (parts.length === 3) {
      return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    }
    return new Date(str);
  }

  function updateAssignmentSelectedDaysCount() {
    const startDateInput = document.getElementById('assignment_start_date');
    const endDateInput = document.getElementById('assignment_end_date');
    const textEl = document.getElementById('selected_days_text');
    const badgeEl = document.getElementById('selected_days_badge');

    if (!startDateInput || !endDateInput || !textEl) return;

    const start = parseFormDate(startDateInput.value);
    const end = parseFormDate(endDateInput.value);

    if (start && end && !isNaN(start.getTime()) && !isNaN(end.getTime())) {
      const diffTime = end.getTime() - start.getTime();
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
      const totalDays = diffDays >= 0 ? diffDays + 1 : 0;

      if (totalDays > 0) {
        textEl.textContent = `${totalDays} ${totalDays === 1 ? 'Day' : 'Days'} Selected`;
        if (badgeEl) {
          badgeEl.className = 'badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-bold shadow-xs';
        }
      } else {
        textEl.textContent = `Invalid Date Range`;
        if (badgeEl) {
          badgeEl.className = 'badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-bold shadow-xs';
        }
      }
    }
  }

  function autoUpdateAssignmentEndDate() {
    const startDateInput = document.getElementById('assignment_start_date');
    const endDateInput = document.getElementById('assignment_end_date');
    if (startDateInput && endDateInput && startDateInput.value) {
      const start = parseFormDate(startDateInput.value);
      if (start && !isNaN(start.getTime())) {
        const currentEnd = parseFormDate(endDateInput.value);
        let durationDays = 30;
        if (currentEnd && !isNaN(currentEnd.getTime()) && currentEnd >= start) {
          durationDays = Math.round((currentEnd.getTime() - start.getTime()) / (1000 * 60 * 60 * 24)) + 1;
        }
        start.setDate(start.getDate() + durationDays - 1);
        const year = start.getFullYear();
        const month = String(start.getMonth() + 1).padStart(2, '0');
        const day = String(start.getDate()).padStart(2, '0');
        endDateInput.value = `${year}-${month}-${day}`;
        updateAssignmentSelectedDaysCount();
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() { updateAssignmentSelectedDaysCount(); updateFormRecipientCount(); initFormBundleSortables(); });
  document.addEventListener('turbo:load', function() { updateAssignmentSelectedDaysCount(); updateFormRecipientCount(); initFormBundleSortables(); });
</script>

