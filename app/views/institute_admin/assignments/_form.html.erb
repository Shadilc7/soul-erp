<!-- JS REMAINING HELPER FUNCTIONS -->
<script>

  function submitNewFormBundle(e) {
    e.preventDefault();
    const nameInput = document.getElementById('new_form_bundle_name');
    const fromInput = document.getElementById('new_form_bundle_from_day');
    const toInput = document.getElementById('new_form_bundle_to_day');
    const errBox = document.getElementById('new_form_bundle_error');

    if (errBox) errBox.classList.add('d-none');

    const name = nameInput.value.trim();
    if (!name) {
      if (errBox) { errBox.textContent = 'Bundle name is required.'; errBox.classList.remove('d-none'); }
      return;
    }

    const fromDay = parseInt(fromInput.value, 10) || 1;
    const toDay = parseInt(toInput.value, 10) || 30;

    if (fromDay < 1) {
      if (errBox) { errBox.textContent = 'From Day must be at least 1.'; errBox.classList.remove('d-none'); }
      return;
    }

    if (toDay < fromDay) {
      if (errBox) { errBox.textContent = `To Day (${toDay}) must be greater than or equal to From Day (${fromDay}).`; errBox.classList.remove('d-none'); }
      return;
    }

    // Check overlap with existing bundles
    let overlapFound = false;
    let overlapName = '';
    let overlapRange = '';
    document.querySelectorAll('.form-bundle-card').forEach(card => {
      const oFrom = parseInt(card.dataset.bundleFrom, 10) || 1;
      const oTo = parseInt(card.dataset.bundleTo, 10) || 30;
      if (fromDay <= oTo && toDay >= oFrom) {
        overlapFound = true;
        const nameEl = card.querySelector(`[id^="form_bundle_name_display_"]`);
        overlapName = nameEl ? nameEl.textContent.trim() : 'Existing Bundle';
        overlapRange = (oFrom === oTo) ? `Day ${oFrom}` : `Day ${oFrom} - ${oTo}`;
      }
    });

    if (overlapFound) {
      if (errBox) {
        errBox.textContent = `Bundle day range (Day ${fromDay} - ${toDay}) overlaps with existing bundle '${overlapName}' (${overlapRange}). Please choose non-overlapping days.`;
        errBox.classList.remove('d-none');
      }
      return;
    }

    const dayText = (fromDay === toDay) ? `Day ${fromDay}` : `Day ${fromDay}-${toDay}`;
    const bundleId = `custom_${Date.now()}`;

    const container = document.getElementById('form_bundles_container');
    if (container) {
      const card = document.createElement('div');
      card.className = 'card border rounded-4 bg-white shadow-sm p-3 border-light-subtle position-relative form-bundle-card';
      card.id = `form_bundle_card_${bundleId}`;
      card.dataset.bundleId = bundleId;
      card.dataset.bundleFrom = fromDay;
      card.dataset.bundleTo = toDay;
      card.innerHTML = `
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.85rem;">
              <i class="bi bi-layers-fill me-1"></i><h6 class="d-inline fw-bold text-white mb-0" id="form_bundle_name_display_${bundleId}" style="font-size: 0.85rem;">${name}</h6>
            </span>
            <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1" id="form_bundle_q_count_pill_${bundleId}">
              0 questions
            </span>
            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
              <i class="bi bi-calendar-event me-1"></i><span id="form_bundle_schedule_display_${bundleId}">${dayText}</span>
            </span>
          </div>
          <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-outline-primary border-0 rounded-2 p-1" title="Edit Bundle" onclick="openFormEditBundleModal('${bundleId}', '${name.replace(/'/g, "\\'")}', '${fromDay}', '${toDay}')">
              <i class="bi bi-pencil"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-2 p-1" title="Delete Bundle" onclick="deleteFormBundle('${bundleId}')">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>

        <div class="card-body bg-light-subtle rounded-3 p-2.5" style="min-height: 100px; border: 2px dashed #94a3b8 !important;">
          <div class="d-flex flex-column gap-2 form-bundle-items-container" id="form_bundle_items_${bundleId}" data-bundle-name="${name}"></div>
        </div>
      `;
      container.appendChild(card);

      // Add to dropdown options in question pool
      document.querySelectorAll('[class*="form-bundle-assign-select-"]').forEach(select => {
        const opt = document.createElement('option');
        opt.value = bundleId;
        opt.dataset.bundleName = name;
        opt.textContent = `${name} (${dayText})`;
        select.appendChild(opt);
      });

      // Update bundle count
      const countEl = document.getElementById('form_bundles_count');
      if (countEl) {
        const total = document.querySelectorAll('.form-bundle-card').length;
        countEl.textContent = `${total} ${total === 1 ? 'bundle' : 'bundles'}`;
      }
    }

    nameInput.value = '';
    const modalEl = document.getElementById('newFormBundleModal');
    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
    modal.hide();
  }

  function openFormEditBundleModal(bundleId, name, fromDay, toDay) {
    document.getElementById('edit_form_bundle_id').value = bundleId;
    document.getElementById('edit_form_bundle_name').value = name;
    document.getElementById('edit_form_bundle_from_day').value = fromDay;
    document.getElementById('edit_form_bundle_to_day').value = toDay;
    const errBox = document.getElementById('edit_form_bundle_error');
    if (errBox) errBox.classList.add('d-none');

    const modalEl = document.getElementById('editFormBundleModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  function submitEditFormBundle(e) {
    e.preventDefault();
    const bundleId = document.getElementById('edit_form_bundle_id').value;
    const name = document.getElementById('edit_form_bundle_name').value.trim();
    const fromDay = parseInt(document.getElementById('edit_form_bundle_from_day').value, 10) || 1;
    const toDay = parseInt(document.getElementById('edit_form_bundle_to_day').value, 10) || 30;
    const errBox = document.getElementById('edit_form_bundle_error');

    if (errBox) errBox.classList.add('d-none');

    if (!name) {
      if (errBox) { errBox.textContent = 'Bundle name is required.'; errBox.classList.remove('d-none'); }
      return;
    }

    if (fromDay < 1) {
      if (errBox) { errBox.textContent = 'From Day must be at least 1.'; errBox.classList.remove('d-none'); }
      return;
    }

    if (toDay < fromDay) {
      if (errBox) { errBox.textContent = `To Day (${toDay}) must be greater than or equal to From Day (${fromDay}).`; errBox.classList.remove('d-none'); }
      return;
    }

    // Check overlap with other bundles
    let overlapFound = false;
    let overlapName = '';
    let overlapRange = '';
    document.querySelectorAll('.form-bundle-card').forEach(card => {
      if (card.dataset.bundleId !== bundleId) {
        const oFrom = parseInt(card.dataset.bundleFrom, 10) || 1;
        const oTo = parseInt(card.dataset.bundleTo, 10) || 30;
        if (fromDay <= oTo && toDay >= oFrom) {
          overlapFound = true;
          const nameEl = card.querySelector(`[id^="form_bundle_name_display_"]`);
          overlapName = nameEl ? nameEl.textContent.trim() : 'Existing Bundle';
          overlapRange = (oFrom === oTo) ? `Day ${oFrom}` : `Day ${oFrom} - ${oTo}`;
        }
      }
    });

    if (overlapFound) {
      if (errBox) {
        errBox.textContent = `Bundle day range (Day ${fromDay} - ${toDay}) overlaps with existing bundle '${overlapName}' (${overlapRange}). Please choose non-overlapping days.`;
        errBox.classList.remove('d-none');
      }
      return;
    }

    const dayText = (fromDay === toDay) ? `Day ${fromDay}` : `Day ${fromDay}-${toDay}`;

    // Update bundle card dataset & UI
    const bundleCard = document.getElementById(`form_bundle_card_${bundleId}`);
    if (bundleCard) {
      bundleCard.dataset.bundleFrom = fromDay;
      bundleCard.dataset.bundleTo = toDay;
    }

    const nameDisplay = document.getElementById(`form_bundle_name_display_${bundleId}`);
    if (nameDisplay) nameDisplay.textContent = name;

    const schedDisplay = document.getElementById(`form_bundle_schedule_display_${bundleId}`);
    if (schedDisplay) schedDisplay.textContent = dayText;

    const container = document.getElementById(`form_bundle_items_${bundleId}`);
    if (container) {
      container.dataset.bundleName = name;
    }

    // Update hidden inputs for bundle questions
    document.querySelectorAll(`.form-bundle-item-name-input-${bundleId}`).forEach(input => {
      input.value = name;
    });

    // Update dropdown options
    document.querySelectorAll('[class*="form-bundle-assign-select-"]').forEach(select => {
      for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].value == bundleId) {
          select.options[i].textContent = `${name} (${dayText})`;
          select.options[i].dataset.bundleName = name;
          break;
        }
      }
    });

    updateFormBundleItemSchedules(bundleId);

    const modalEl = document.getElementById('editFormBundleModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
  }

  function deleteFormBundle(bundleId) {
    if (!confirm('Are you sure you want to delete this custom bundle? Assigned questions will be removed from this bundle.')) return;

    const card = document.getElementById(`form_bundle_card_${bundleId}`);
    if (card) {
      // Free options in select
      document.querySelectorAll('[class*="form-bundle-assign-select-"]').forEach(select => {
        for (let i = select.options.length - 1; i >= 0; i--) {
          if (select.options[i].value == bundleId) {
            select.remove(i);
            break;
          }
        }
      });
      card.remove();

      // Update bundle count
      const countEl = document.getElementById('form_bundles_count');
      if (countEl) {
        const total = document.querySelectorAll('.form-bundle-card').length;
        countEl.textContent = `${total} ${total === 1 ? 'bundle' : 'bundles'}`;
      }
    }
  }

  function toggleFormQuestionOptionsVisibility(prefix, type) {
    const wrapper = document.getElementById(`${prefix}_form_q_options_wrapper`);
    if (wrapper) {
      if (['multiple_choice', 'checkboxes', 'dropdown', 'yes_or_no'].includes(type)) {
        wrapper.classList.remove('d-none');
        const container = document.getElementById(`${prefix}_form_q_options_container`);
        if (container) {
          const inputs = container.querySelectorAll(`.${prefix}-q-opt-text`);
          if (type === 'yes_or_no') {
            if (inputs[0]) inputs[0].value = 'Yes';
            if (inputs[1]) inputs[1].value = 'No';
          } else {
            inputs.forEach(input => {
              if (input.value === 'Yes' || input.value === 'No') {
                input.value = '';
              }
            });
            updateFormQuestionOptionPlaceholders(prefix);
          }
        }
      } else {
        wrapper.classList.add('d-none');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const newModal = document.getElementById('newFormQuestionModal');
    if (newModal) {
      newModal.addEventListener('show.bs.modal', function () {
        const typeSelect = document.getElementById('new_form_q_type');
        if (typeSelect) {
          toggleFormQuestionOptionsVisibility('new', typeSelect.value);
        }
      });
    }
  });

  function addFormQuestionOptionRow(prefix, text = '', id = '') {
    const container = document.getElementById(`${prefix}_form_q_options_container`);
    if (!container) return;
    const count = container.querySelectorAll('.input-group').length + 1;
    const row = document.createElement('div');
    row.className = 'input-group input-group-sm mb-1';
    row.innerHTML = `
      ${id ? `<input type="hidden" class="${prefix}-q-opt-id" value="${id}">` : ''}
      <input type="text" class="form-control ${prefix}-q-opt-text" value="${text ? text.replace(/"/g, '&quot;') : ''}" placeholder="Option ${count}">
      <button type="button" class="btn btn-outline-danger" onclick="removeFormQuestionOptionRow(this, '${prefix}');"><i class="bi bi-trash"></i></button>
    `;
    container.appendChild(row);
  }

  function removeFormQuestionOptionRow(btn, prefix) {
    const row = btn.closest('.input-group');
    if (!row) return;
    const idInput = row.querySelector(`.${prefix}-q-opt-id`);
    if (idInput && idInput.value) {
      if (!window[`_${prefix}_deleted_opt_ids`]) window[`_${prefix}_deleted_opt_ids`] = [];
      window[`_${prefix}_deleted_opt_ids`].push(idInput.value);
    }
    row.remove();
    updateFormQuestionOptionPlaceholders(prefix);
  }

  function updateFormQuestionOptionPlaceholders(prefix) {
    const container = document.getElementById(`${prefix}_form_q_options_container`);
    if (!container) return;
    const inputs = container.querySelectorAll(`.${prefix}-q-opt-text`);
    inputs.forEach((input, idx) => {
      input.placeholder = `Option ${idx + 1}`;
    });
  }

