<%= form_with(model: [:institute_admin, @assignment], local: true, data: { controller: "assignment-form" }) do |f| %>
  <!-- Hidden default fields -->
  <%= hidden_field_tag "assignment[question_ids][]", nil %>

  <!-- Basic Info & Schedule Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square text-primary"></i> Basic Information & Schedule
      </h5>

      <% current_duration = (@assignment.end_date.present? && @assignment.start_date.present?) ? ((@assignment.end_date.to_date - @assignment.start_date.to_date).to_i + 1) : 30 %>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-bold shadow-xs" id="selected_days_badge" style="font-size: 0.85rem;">
        <i class="bi bi-calendar-range me-1.5 text-primary"></i><span id="selected_days_text"><%= current_duration %> <%= current_duration == 1 ? 'Day' : 'Days' %> Selected</span>
      </span>
    </div>

    <div class="card-body p-3 p-md-4">
      <% if @assignment.errors.any? %>
        <div class="alert alert-danger mb-4 rounded-3">
          <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please fix the following errors:</h6>
          <ul class="mb-0 ps-3 small">
            <% @assignment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :title, "Assignment Title", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.text_field :title, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              placeholder: "Enter assignment title...",
              data: { assignment_form_target: "titleInput" } %>
        </div>

        <div class="col-md-6">
          <%= f.label :assignment_type, "Assignment Audience Type", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.select :assignment_type, [["Individual Participants", "individual"], ["Sections / Batches", "section"]], {}, 
              class: "form-select rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_type_select",
              onchange: "toggleAssignmentAudienceSection(this.value)" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :description, "Description (Optional)", class: "form-label fw-semibold text-dark small mb-1" %>
        <%= f.text_area :description, class: "form-control rounded-3 border-secondary-subtle", rows: 2,
            placeholder: "Brief summary or instructions for participants..." %>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :start_date, "Start Date", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.date_field :start_date, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_start_date",
              onchange: "autoUpdateAssignmentEndDate(); updateAssignmentSelectedDaysCount();",
              oninput: "updateAssignmentSelectedDaysCount();" %>
        </div>
        <div class="col-md-6">
          <%= f.label :end_date, "End Date", class: "form-label fw-semibold text-dark small mb-1" %>
          <%= f.date_field :end_date, 
              class: "form-control rounded-3 border-secondary-subtle fw-medium",
              id: "assignment_end_date",
              onchange: "updateAssignmentSelectedDaysCount()",
              oninput: "updateAssignmentSelectedDaysCount()" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recipients Selection Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between">
      <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-people-fill text-primary"></i> <span id="recipients_card_title">Participants</span>
      </h5>
    </div>

    <div class="card-body p-3 p-md-4">
      <!-- Individual Participants Container -->
      <div id="individual_audience_container" class="<%= 'd-none' if @assignment.assignment_type == 'section' %>">
        <div class="input-group input-group-sm mb-3">
          <span class="input-group-text bg-light border-end-0 ps-3 pe-2"><i class="bi bi-search text-muted"></i></span>
          <input type="text" class="form-control bg-light border-start-0 ps-0 py-2" placeholder="Search participants by name or code..." oninput="filterFormParticipants(this.value)">
        </div>

        <div class="border rounded-3 p-3 overflow-auto recipients-list" style="max-height: 220px; background-color: #f8fafc;">
          <% if @participants.present? && @participants.any? %>
            <div class="row g-2" id="participants_checkbox_grid">
              <% @participants.each do |p| %>
                <% is_sel = @selected_participants&.include?(p) || @assignment.participant_ids.include?(p.id) %>
                <div class="col-md-6 participant-item-row" data-search-name="<%= p.full_name.downcase %> <%= p.user&.email.to_s.downcase %>">
                  <div class="form-check bg-white p-2 px-3 border rounded-3 d-flex align-items-center gap-2 mb-0 shadow-xs hover-shadow transition-all">
                    <%= check_box_tag "assignment[participant_ids][]", p.id, is_sel, id: "part_chk_#{p.id}", class: "form-check-input m-0 cursor-pointer" %>
                    <label for="part_chk_<%= p.id %>" class="form-check-label small fw-semibold text-dark cursor-pointer flex-grow-1 text-truncate mb-0">
                      <%= p.full_name %>
                    </label>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-muted small text-center py-3">No active participants available.</div>
          <% end %>
        </div>
      </div>

      <!-- Section / Batch Container -->
      <div id="section_audience_container" class="<%= 'd-none' if @assignment.assignment_type != 'section' %>">
        <div class="border rounded-3 p-3 overflow-auto recipients-list" style="max-height: 220px; background-color: #f8fafc;">
          <% if @sections.present? && @sections.any? %>
            <div class="row g-2">
              <% @sections.each do |sec| %>
                <% is_sec_sel = @selected_sections&.include?(sec) || @assignment.section_ids.include?(sec.id) %>
                <div class="col-md-6">
                  <div class="form-check bg-white p-2 px-3 border rounded-3 d-flex align-items-center gap-2 mb-0 shadow-xs hover-shadow transition-all">
                    <%= check_box_tag "assignment[section_ids][]", sec.id, is_sec_sel, id: "sec_chk_#{sec.id}", class: "form-check-input m-0 cursor-pointer" %>
                    <label for="sec_chk_<%= sec.id %>" class="form-check-label small fw-semibold text-dark cursor-pointer flex-grow-1 text-truncate mb-0">
                      <%= sec.name %>
                    </label>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-muted small text-center py-3">No active sections available.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 2-COLUMN QUESTION BANK WORKSPACE BUILDER GRID -->
  <% category = @assignment.question_category %>
  <% category_questions = category.present? ? category.questions.includes(:options).order(:position, :created_at) : @assignment.questions.includes(:options) %>
  <% category_bundles = category.present? ? category.question_bundles.includes(question_bundle_items: { question: :options }).order(:position) : [] %>

  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-layers-fill text-warning fs-5"></i> Question Bank & Custom Bundles Builder
        </h5>
        <span class="text-muted small">Manage questions, customize bundle day ranges, or add custom questions to bundles.</span>
      </div>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" id="expand_collapse_all_btn" onclick="toggleAllFormBundles(this)" data-expanded="true">
          <i class="bi bi-chevrons-down me-1" id="expand_collapse_all_icon"></i> <span id="expand_collapse_all_text">Collapse All</span>
        </button>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">
      <div class="row g-4">
        <!-- LEFT COLUMN: QUESTION POOL -->
        <div class="col-lg-5" id="form_question_pool_col">
          <div class="card border border-secondary-subtle shadow-sm rounded-4 h-100 bg-light-subtle">
            <div class="card-header bg-white border-bottom p-3.5 p-md-4 rounded-top-4">
              <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                <div>
                  <h6 class="fw-bold text-dark mb-0 d-flex align-items-center flex-wrap gap-2" style="font-size: 1rem;">
                    <i class="bi bi-card-list text-primary fs-5"></i>
                    <span>Question Pool</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1" style="font-size: 0.75rem;" id="form_pool_count">
                      <%= category_questions.size %> <%= category_questions.size == 1 ? 'question' : 'questions' %>
                    </span>
                  </h6>
                  <span class="text-muted small d-block mt-1">Select questions from pool to assign to custom bundles.</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <button type="button" 
                          class="btn btn-sm btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs"
                          data-bs-toggle="modal" data-bs-target="#newFormQuestionModal">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Add Custom Question</span>
                  </button>
                  <button type="button" 
                          class="btn btn-sm btn-primary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm text-white border-0" 
                          style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);"
                          onclick="autoAssignFormQuestionsToBundles()"
                          title="Auto-assign questions to matching bundles based on schedule day ranges">
                    <i class="bi bi-magic fs-6"></i>
                    <span>Auto Assign to Bundles</span>
                  </button>
                </div>
              </div>

              <!-- Search Filter -->
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 ps-3 pe-2"><i class="bi bi-search text-muted"></i></span>
                <input type="text" 
                       class="form-control bg-light border-start-0 ps-0 py-2" 
                       placeholder="Search questions by title..." 
                       oninput="filterFormPoolQuestions(this.value)">
              </div>
            </div>

            <!-- Question Pool Cards List -->
            <div class="card-body p-3 overflow-auto" style="max-height: 700px;">
              <% if category_questions.any? %>
                <div class="d-flex flex-column gap-3" id="form_question_pool_container">
                  <% category_questions.each_with_index do |q, q_idx| %>
                    <% is_in_assignment = @assignment.question_ids.include?(q.id) %>
                    <div class="card border border-light-subtle rounded-3 p-3 bg-white shadow-sm hover-shadow transition-all position-relative form-pool-question-card" 
                         id="form_pool_card_<%= q.id %>"
                         data-question-title="<%= q.title.downcase %>"
                         data-q-id="<%= q.id %>"
                         data-q-title="<%= ERB::Util.html_escape(q.title) %>"
                         data-q-desc="<%= ERB::Util.html_escape(q.description.to_s) %>"
                         data-q-type="<%= q.question_type %>"
                         data-q-from="<%= q.from_day || 1 %>"
                         data-q-to="<%= q.to_day || 30 %>"
                         data-q-options="<%= ERB::Util.html_escape(q.options.map { |o| { id: o.id, text: o.text } }.to_json) %>">

                      <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                          <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                            #<%= q_idx + 1 %>
                          </span>

                          <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= q.id %>" style="font-size: 0.7rem;">
                            <%= q.question_type&.titleize %>
                          </span>

                          <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-<%= q.id %>" style="font-size: 0.7rem;">
                            <i class="bi bi-clock-history me-1"></i><%= q.day_range_text %>
                          </span>
                        </div>

                        <!-- Quick Actions (Edit / View) -->
                        <div class="d-flex align-items-center gap-1">
                          <button type="button" class="btn btn-sm btn-outline-primary rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="Edit Question" onclick="openFormEditQuestionModal(<%= q.id %>)">
                            <i class="bi bi-pencil" style="font-size: 0.85rem;"></i>
                          </button>
                          <button type="button" class="btn btn-sm btn-outline-info rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="View Question Details" data-bs-toggle="modal" data-bs-target="#viewFormQuestionModal_<%= q.id %>">
                            <i class="bi bi-eye" style="font-size: 0.85rem;"></i>
                          </button>
                        </div>
                      </div>

                      <!-- Question Title -->
                      <h6 class="fw-bold text-dark mb-1 q-title-display-<%= q.id %>" style="font-size: 0.925rem; line-height: 1.35;">
                        <%= q.title %>
                      </h6>

                      <% if q.requires_options? && q.options.any? %>
                        <div class="text-muted small mb-1 q-options-count-<%= q.id %>">
                          <i class="bi bi-list-check me-1 text-primary"></i> <%= q.options.size %> Answer Options
                        </div>
                      <% elsif q.rating? %>
                        <div class="text-muted small mb-1">
                          <i class="bi bi-star-fill me-1 text-warning"></i> Max Scale: <%= q.max_rating || 5 %> Stars
                        </div>
                      <% end %>

                      <!-- Quick Assign to Bundle Select -->
                      <% if category_bundles.any? %>
                        <div class="mt-3 pt-2 border-top">
                          <select class="form-select form-select-sm rounded-3 text-muted form-bundle-assign-select-<%= q.id %>" 
                                  data-q-id="<%= q.id %>"
                                  onchange="handleFormQuestionBundleSelect(<%= q.id %>, this)">
                            <option value="">+ Assign to Bundle...</option>
                            <% category_bundles.each do |b| %>
                              <% assigned_bnames = @assignment.assignment_questions.where(question_id: q.id).pluck(:bundle_name) %>
                              <% is_assigned = assigned_bnames.include?(b.name) %>
                              <option value="<%= b.id %>" data-bundle-name="<%= b.name %>" <%= 'disabled' if is_assigned %>>
                                <%= b.name %> (<%= b.day_range_text %>)<%= " - Assigned" if is_assigned %>
                              </option>
                            <% end %>
                          </select>
                        </div>
                      <% end %>
                    </div>

                    <!-- Modal: View Form Question -->
                    <div class="modal fade" id="viewFormQuestionModal_<%= q.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content rounded-4 border-0 shadow-lg">
                          <div class="modal-header border-bottom-0 pb-0">
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                              <i class="bi bi-eye-fill text-info"></i> Question Details
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body p-4">
                            <span class="badge bg-secondary-subtle text-dark text-uppercase px-2.5 py-1 mb-2 q-type-badge-<%= q.id %>" style="font-size: 0.75rem;"><%= q.question_type&.titleize %></span>
                            <h4 class="fw-bold text-dark mb-2 q-title-display-<%= q.id %>"><%= q.title %></h4>
                            <% if q.description.present? %>
                              <div class="p-3 bg-light rounded-3 text-muted small mb-3"><%= q.description %></div>
                            <% end %>
                            <% if q.requires_options? && q.options.any? %>
                              <h6 class="fw-semibold text-dark mb-2">Answer Options:</h6>
                              <div class="list-group rounded-3 mb-3">
                                <% q.options.each_with_index do |opt, o_idx| %>
                                  <div class="list-group-item d-flex align-items-center justify-content-between">
                                    <span><%= o_idx + 1 %>. <%= opt.text %></span>
                                  </div>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                          <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <!-- Institution Custom Questions Section -->
              <% if @custom_questions.present? && @custom_questions.any? %>
                <div class="card border rounded-4 bg-white shadow-sm p-3 mt-4" id="form_custom_questions_section">
                  <div class="card-header bg-light border-0 rounded-3 p-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2 cursor-pointer"
                       data-bs-toggle="collapse" 
                       data-bs-target="#form_custom_q_collapse" 
                       aria-expanded="true">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-chevron-down text-secondary transition-transform"></i>
                      <i class="bi bi-building-gear text-secondary fs-5"></i>
                      <h6 class="fw-bold text-dark mb-0 fs-6">Institution Custom Questions</h6>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 fw-semibold ms-1" id="form_custom_q_count_badge">
                        <%= pluralize(@custom_questions.size, 'question') %>
                      </span>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2.5 py-1 small">
                      <i class="bi bi-info-circle me-1"></i> Click "+ Assign to Bundle" to assign questions
                    </span>
                  </div>

                  <div class="collapse show mt-3" id="form_custom_q_collapse">
                    <div class="d-flex flex-column gap-3" id="form_custom_questions_container">
                      <% @custom_questions.each_with_index do |cq, cq_idx| %>
                        <div class="card border border-light-subtle rounded-3 p-3 bg-white shadow-sm hover-shadow transition-all form-pool-question-card" 
                             id="form_pool_card_<%= cq.id %>"
                             data-question-title="<%= cq.title.downcase %>"
                             data-q-id="<%= cq.id %>"
                             data-q-title="<%= ERB::Util.html_escape(cq.title) %>"
                             data-q-desc="<%= ERB::Util.html_escape(cq.description.to_s) %>"
                             data-q-type="<%= cq.question_type %>"
                             data-q-from="<%= cq.from_day || 1 %>"
                             data-q-to="<%= cq.to_day || 30 %>"
                             data-q-options="<%= ERB::Util.html_escape(cq.options.map { |o| { id: o.id, text: o.text } }.to_json) %>">
                          
                          <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                              <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                #<%= cq_idx + 1 %>
                              </span>
                              <span class="badge bg-secondary-subtle text-dark fw-semibold text-uppercase q-type-badge-<%= cq.id %>" style="font-size: 0.7rem;">
                                <%= cq.question_type&.titleize %>
                              </span>
                              <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold q-day-badge-<%= cq.id %>" style="font-size: 0.7rem;">
                                <i class="bi bi-clock-history me-1"></i><%= cq.day_range_text %>
                              </span>
                            </div>

                            <div class="d-flex align-items-center gap-1">
                              <button type="button" class="btn btn-sm btn-outline-primary rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="Edit Question" onclick="openFormEditQuestionModal(<%= cq.id %>)">
                                <i class="bi bi-pencil" style="font-size: 0.85rem;"></i>
                              </button>
                              <button type="button" class="btn btn-sm btn-outline-info rounded-2 p-1 d-flex align-items-center justify-content-center shadow-xs" style="width: 28px; height: 28px;" title="View Question Details" data-bs-toggle="modal" data-bs-target="#viewFormQuestionModal_<%= cq.id %>">
                                <i class="bi bi-eye" style="font-size: 0.85rem;"></i>
                              </button>
                            </div>
                          </div>

                          <h6 class="fw-bold text-dark mb-1 q-title-display-<%= cq.id %>" style="font-size: 0.925rem; line-height: 1.35;"><%= cq.title %></h6>

                          <% if category_bundles.any? %>
                            <div class="mt-3 pt-2 border-top">
                              <select class="form-select form-select-sm rounded-3 text-muted form-bundle-assign-select-<%= cq.id %>" 
                                      data-q-id="<%= cq.id %>"
                                      onchange="handleFormQuestionBundleSelect(<%= cq.id %>, this)">
                                <option value="">+ Assign to Bundle...</option>
                                <% category_bundles.each do |b| %>
                                  <% assigned_bnames = @assignment.assignment_questions.where(question_id: cq.id).pluck(:bundle_name) %>
                                  <% is_assigned = assigned_bnames.include?(b.name) %>
                                  <option value="<%= b.id %>" data-bundle-name="<%= b.name %>" <%= 'disabled' if is_assigned %>>
                                    <%= b.name %> (<%= b.day_range_text %>)<%= " - Assigned" if is_assigned %>
                                  </option>
                                <% end %>
                              </select>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: CUSTOM BUNDLES -->
        <div class="col-lg-7" id="form_bundles_col">
          <div class="card border border-secondary-subtle shadow-sm rounded-4 h-100 bg-light-subtle">
            <div class="card-header bg-white border-bottom p-3.5 p-md-4 rounded-top-4">
              <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                <div>
                  <h6 class="fw-bold text-dark mb-0 d-flex align-items-center flex-wrap gap-2" style="font-size: 1rem;">
                    <i class="bi bi-layers-fill text-warning fs-5"></i>
                    <span>Custom Bundles</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1" style="font-size: 0.75rem;" id="form_bundles_count">
                      <%= category_bundles.size %> <%= category_bundles.size == 1 ? 'bundle' : 'bundles' %>
                    </span>
                  </h6>
                  <span class="text-muted small d-block mt-1">Organize questions into day-wise bundles for participants.</span>
                </div>
                <button type="button" class="btn btn-sm btn-primary rounded-3 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" data-bs-toggle="modal" data-bs-target="#newFormBundleModal">
                  <i class="bi bi-plus-lg"></i>
                  <span>Add Custom Bundle</span>
                </button>
              </div>

