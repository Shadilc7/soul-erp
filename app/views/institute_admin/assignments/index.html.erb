<div class="container-fluid px-4 py-4">
  <!-- PAGE HEADER & ACTION BUTTONS -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">Assignments Directory</h3>
      <p class="text-muted small mb-0">Manage institute evaluation assignments, participant allocations, and question bank categories.</p>
    </div>
    <div class="header-actions d-flex flex-wrap align-items-center gap-2">
      <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" data-bs-toggle="modal" data-bs-target="#importQuestionBankModal">
        <i class="bi bi-box-arrow-in-down"></i>
        <span>Import Question Bank</span>
      </button>

      <%= link_to new_institute_admin_assignment_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-plus-lg"></i>
        <span>New Assignment</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Assignments</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @total_assignments_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-journal-bookmark-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Assignments</div>
          <div class="h4 fw-bold mb-0 text-success"><%= @active_assignments_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-check-circle-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Assigned Questions</div>
          <div class="h4 fw-bold mb-0 text-info"><%= @total_questions_assigned_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-patch-question-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Allocated Recipients</div>
          <div class="h4 fw-bold mb-0 text-warning"><%= @total_participants_assigned_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-people-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- FILLED FILTER TOOLBAR -->
  <div class="filled-toolbar mb-4">
    <%= form_with url: institute_admin_assignments_path, method: :get, local: true, id: "assignmentsFilterForm" do |f| %>
      <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-12 col-md-5 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" id="assignmentSearchInput" class="form-control border-start-0" placeholder="Search title or description..." value="<%= params[:search] %>">
          </div>
        </div>

        <!-- Assignment Type Filter -->
        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-sliders"></i></span>
            <select name="assignment_type" id="typeFilter" class="form-select border-start-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:assignment_type].blank? %>>All Target Types</option>
              <option value="individual" <%= 'selected' if params[:assignment_type] == 'individual' %>>Individual</option>
              <option value="section" <%= 'selected' if params[:assignment_type] == 'section' %>>Section / Batch</option>
            </select>
          </div>
        </div>

        <!-- Question Category Filter -->
        <div class="col-12 col-sm-6 col-md-2 col-lg-2">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-folder2"></i></span>
            <select name="question_category_id" id="categoryFilter" class="form-select border-start-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:question_category_id].blank? %>>All Categories</option>
              <% (@categories_for_filter || []).each do |cat| %>
                <option value="<%= cat.id %>" <%= 'selected' if params[:question_category_id].to_s == cat.id.to_s %>><%= cat.name %></option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Filter & Reset Buttons -->
        <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm">
            <i class="bi bi-funnel-fill"></i>
            <span>Filter</span>
          </button>
          <%= link_to institute_admin_assignments_path, class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2.5", title: "Reset All Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- MAIN DATA TABLE CARD -->
  <div class="table-card">
    <div class="table-card-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-journal-text text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Assignments Directory</h6>
      </div>
      <span class="badge bg-light text-secondary border px-2.5 py-1">
        Showing <%= @assignments.size %> of <%= @total_assignments_count %>
      </span>
    </div>

    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">#</th>
            <th style="min-width: 220px;">Title & Category</th>
            <th style="min-width: 130px;">Target Type</th>
            <th style="min-width: 170px;">Schedule Duration</th>
            <th style="min-width: 140px;">Recipients</th>
            <th style="min-width: 120px;">Questions</th>
            <th style="min-width: 150px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @assignments.empty? %>
            <tr>
              <td colspan="7" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Assignments Found</h6>
                <p class="text-muted small mb-0">No assignment records match the selected search or filter criteria.</p>
              </td>
            </tr>
          <% else %>
            <% @assignments.each_with_index do |assignment, index| %>
              <tr>
                <td class="text-center fw-semibold text-secondary" style="font-size: 0.85rem;"><%= index + 1 %></td>
                <td>
                  <div class="fw-bold text-dark mb-0.5"><%= assignment.title %></div>
                  <% if assignment.question_category.present? && assignment.question_category.name != assignment.title %>
                    <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle font-monospace" style="font-size: 0.72rem;">
                      <i class="bi bi-folder2 me-1 text-primary"></i><%= assignment.question_category.name %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <% if assignment.assignment_type == "individual" %>
                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-person me-1"></i> Individual
                    </span>
                  <% else %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-medium">
                      <i class="bi bi-people me-1"></i> Section
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex flex-column text-muted small">
                    <span class="fw-semibold text-dark">
                      <i class="bi bi-calendar3 me-1 text-muted"></i>
                      <%= assignment.start_date.strftime("%b %d") %> – <%= assignment.end_date.strftime("%b %d, %Y") %>
                    </span>
                    <span class="badge bg-light text-muted border border-light-subtle rounded-pill w-auto align-self-start mt-1 px-2 py-0.5" style="font-size: 0.68rem;">
                      <%= assignment.total_days %> Active Days
                    </span>
                  </div>
                </td>
                <td>
                  <% if assignment.assignment_type == "section" %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-semibold">
                      <i class="bi bi-diagram-3 me-1"></i> <%= pluralize(@sections_count_by_assignment_id[assignment.id] || 0, 'Section') %>
                    </span>
                  <% else %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                      <i class="bi bi-people me-1"></i> <%= pluralize(@participants_count_by_assignment_id[assignment.id] || 0, 'Participant') %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <% questions_count = @questions_count_by_assignment_id[assignment.id] || 0 %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-semibold">
                    <i class="bi bi-patch-question me-1"></i> <%= pluralize(questions_count, 'Question') %>
                  </span>
                </td>
                <td class="text-center">
                  <div class="action-btn-group">
                    <%= link_to institute_admin_assignment_path(assignment), 
                        class: "action-btn action-btn-view", title: "View Assignment" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_institute_admin_assignment_path(assignment), 
                        class: "action-btn action-btn-edit", title: "Edit Assignment" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to institute_admin_assignment_path(assignment), method: :delete,
                        data: { confirm: "Are you sure you want to delete this assignment?", turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this assignment?" },
                        class: "action-btn action-btn-delete", title: "Delete Assignment" do %>
                      <i class="bi bi-trash3"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'import_question_bank_modal' %>
