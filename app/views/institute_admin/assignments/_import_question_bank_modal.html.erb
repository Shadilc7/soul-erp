<!-- Import Question Bank Modal -->
<div class="modal fade" id="importQuestionBankModal" tabindex="-1" aria-labelledby="importQuestionBankModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="importQuestionBankModalLabel">
          <i class="bi bi-box-arrow-in-down me-2"></i>Import Question Bank
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: import_question_bank_institute_admin_assignments_path, method: :post, local: true do |f| %>
        <div class="modal-body p-4">
          <p class="text-muted mb-4">
            Select a Master Admin Question Bank below. Importing will automatically generate distinct assignments for each category in the bank, using dynamic duration days and bundle-ordered questions.
          </p>

          <% if @available_question_banks.present? && @available_question_banks.any? %>
            <div class="row g-3">
              <% @available_question_banks.each_with_index do |bank, index| %>
                <div class="col-12">
                  <div class="card border border-light-subtle shadow-sm hover-shadow transition">
                    <div class="card-body p-3">
                      <div class="form-check d-flex align-items-start gap-3">
                        <input class="form-check-input mt-1 fs-5" 
                               type="radio" 
                               name="question_bank_id" 
                               id="bank_<%= bank.id %>" 
                               value="<%= bank.id %>" 
                               <%= 'checked' if index == 0 %>>
                        
                        <label class="form-check-label flex-grow-1" for="bank_<%= bank.id %>">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="mb-0 fw-bold text-dark"><%= bank.name %></h6>
                            <span class="badge bg-primary rounded-pill">
                              <%= pluralize(bank.question_categories.count, 'Category') %>
                            </span>
                          </div>
                          
                          <% if bank.description.present? %>
                            <p class="text-muted small mb-2"><%= bank.description %></p>
                          <% end %>

                          <div class="d-flex flex-wrap gap-2 mt-2">
                            <% bank.question_categories.each do |category| %>
                              <span class="badge bg-light text-dark border">
                                <i class="bi bi-folder2 me-1 text-primary"></i><%= category.name %>
                                <span class="text-muted ms-1">(<%= category.duration_days %> days)</span>
                              </span>
                            <% end %>
                          </div>
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
              <p class="text-muted">No Question Banks are currently available for import.</p>
            </div>
          <% end %>
        </div>

        <div class="modal-footer bg-light px-4 py-3">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <% if @available_question_banks.present? && @available_question_banks.any? %>
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-download me-1"></i> Import Question Bank
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
