<div class="container-fluid px-4 py-4">
  <!-- PAGE HEADER & ACTION BUTTONS -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">Questions Bank</h3>
      <p class="text-muted small mb-0">Manage institute evaluation questions, choices, and response templates.</p>
    </div>
    <div class="header-actions d-flex flex-wrap align-items-center gap-2">
      <div id="reorderStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-3 d-none align-items-center gap-1.5 fw-medium">
        <i class="bi bi-check-circle-fill"></i>
        <span>Order Saved</span>
      </div>

      <%= link_to institute_admin_questions_path(format: :pdf, question_type: params[:question_type], status: params[:status], search: params[:search]), 
                  class: "btn btn-outline-danger d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                  target: "_blank", 
                  title: "Export PDF Report using Ferrum" do %>
        <i class="bi bi-file-earmark-pdf-fill"></i>
        <span>Export PDF</span>
      <% end %>

      <%= link_to institute_admin_questions_path(format: :csv, question_type: params[:question_type], status: params[:status], search: params[:search]), 
                  class: "btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium", 
                  title: "Export CSV Data" do %>
        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
        <span>Export CSV</span>
      <% end %>

      <%= link_to new_institute_admin_question_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-plus-lg"></i>
        <span>New Question</span>
      <% end %>
    </div>
  </div>

  <!-- KPI SUMMARY METRICS ROW -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Questions</div>
          <div class="h4 fw-bold mb-0 text-dark"><%= @total_questions_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-primary">
          <i class="bi bi-patch-question"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Questions</div>
          <div class="h4 fw-bold mb-0 text-success"><%= @active_questions_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-success">
          <i class="bi bi-check-circle"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Question Types</div>
          <div class="h4 fw-bold mb-0 text-info"><%= @types_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-info">
          <i class="bi bi-layers"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="inst-kpi-card">
        <div>
          <div class="text-uppercase text-muted fw-semibold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Mandatory</div>
          <div class="h4 fw-bold mb-0 text-warning"><%= @required_questions_count %></div>
        </div>
        <div class="inst-kpi-icon inst-kpi-icon-warning">
          <i class="bi bi-asterisk"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- FILLED FILTER TOOLBAR -->
  <div class="filled-toolbar mb-4">
    <%= form_with url: institute_admin_questions_path, method: :get, local: true, id: "questionsFilterForm" do |f| %>
      <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-12 col-md-5 col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" id="questionSearchInput" class="form-control border-start-0" placeholder="Search title or display name..." value="<%= params[:search] %>">
          </div>
        </div>

        <!-- Question Type Filter (All Dynamic Types) -->
        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-filter-circle"></i></span>
            <select name="question_type" id="typeFilter" class="form-select border-start-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:question_type].blank? %>>All Types</option>
              <% (@question_types || Question.question_types.keys).each do |type| %>
                <option value="<%= type %>" <%= 'selected' if params[:question_type] == type %>><%= type.titleize %></option>
              <% end %>
            </select>
          </div>
        </div>

        <!-- Status Filter -->
        <div class="col-12 col-sm-6 col-md-2 col-lg-2">
          <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-toggle-on"></i></span>
            <select name="status" id="statusFilter" class="form-select border-start-0" onchange="this.form.submit()">
              <option value="" <%= 'selected' if params[:status].blank? %>>All Status</option>
              <option value="active" <%= 'selected' if params[:status] == 'active' %>>Active Only</option>
              <option value="inactive" <%= 'selected' if params[:status] == 'inactive' %>>Inactive Only</option>
            </select>
          </div>
        </div>

        <!-- Filter & Reset Buttons -->
        <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm">
            <i class="bi bi-funnel-fill"></i>
            <span>Filter</span>
          </button>
          <%= link_to institute_admin_questions_path, class: "btn btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2.5", title: "Reset All Filters" do %>
            <i class="bi bi-arrow-counterclockwise"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- MAIN DATA TABLE CARD -->
  <div class="table-card">
    <div class="table-card-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-patch-question text-primary fs-5"></i>
        <h6 class="fw-bold mb-0 text-dark">Questions Directory</h6>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-2 font-monospace" style="font-size: 0.75rem;">
          <i class="bi bi-arrows-move me-1"></i> Drag rows to rearrange
        </span>
      </div>
      <span class="badge bg-light text-secondary border px-2.5 py-1">
        Showing <%= @questions.count %> of <%= @total_questions_count %>
      </span>
    </div>

    <div class="table-responsive">
      <table class="table align-middle mb-0" id="questionsTable">
        <thead class="table-light">
          <tr>
            <th style="width: 40px;" class="text-center"><i class="bi bi-arrows-move text-muted" title="Drag to Rearrange"></i></th>
            <th style="width: 50px;" class="text-center">#</th>
            <th style="min-width: 220px;">Title</th>
            <th style="min-width: 160px;">Display Name</th>
            <th style="min-width: 140px;">Type</th>
            <th style="min-width: 110px;">Status</th>
            <th style="min-width: 100px;" class="text-center">Options</th>
            <th style="min-width: 160px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody id="sortableQuestionsBody">
          <% if @questions.empty? %>
            <tr>
              <td colspan="8" class="text-center py-5">
                <div class="text-muted mb-2"><i class="bi bi-inbox fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">No Questions Found</h6>
                <p class="text-muted small mb-0">No question entries match the selected filters.</p>
              </td>
            </tr>
          <% else %>
            <% @questions.each_with_index do |question, index| %>
              <tr class="draggable-row" data-question-id="<%= question.id %>" draggable="true" style="cursor: move;">
                <td class="text-center text-muted drag-handle-cell">
                  <i class="bi bi-list fs-5"></i>
                </td>
                <td class="text-center fw-semibold text-secondary row-index-cell" style="font-size: 0.85rem;"><%= index + 1 %></td>
                <td>
                  <div class="fw-semibold text-dark"><%= question.title %></div>
                </td>
                <td>
                  <%= question.display_name.presence || "<em class='text-muted small'>Not set</em>".html_safe %>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-medium">
                    <%= question.question_type.titleize %>
                  </span>
                </td>
                <td>
                  <% if question.active? %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-medium">Active</span>
                  <% else %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-medium">Inactive</span>
                  <% end %>
                </td>
                <td class="text-center font-monospace fw-semibold text-secondary">
                  <%= question.options.count %>
                </td>
                <td class="text-center">
                  <div class="d-flex justify-content-center gap-1.5">
                    <%= link_to institute_admin_question_path(question), 
                        class: "btn btn-sm btn-light border text-primary px-2 py-1", title: "View Question" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_institute_admin_question_path(question), 
                        class: "btn btn-sm btn-light border text-secondary px-2 py-1", title: "Edit Question" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to duplicate_institute_admin_question_path(question), method: :post, data: { turbo_method: :post },
                        class: "btn btn-sm btn-light border text-info px-2 py-1", title: "Duplicate Question" do %>
                      <i class="bi bi-files"></i>
                    <% end %>
                    <%= link_to institute_admin_question_path(question), method: :delete, data: { confirm: "Are you sure you want to delete this question?", turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this question?" },
                        class: "btn btn-sm btn-light border text-danger px-2 py-1", title: "Delete Question" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .draggable-row {
    transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
  }
  .draggable-row.dragging {
    opacity: 0.4;
    background-color: #e0e7ff !important;
  }
  .draggable-row.drag-over {
    border-top: 3px solid #3b82f6 !important;
    background-color: #eff6ff !important;
  }
  .drag-handle-cell {
    color: #94a3b8;
    user-select: none;
  }
  .draggable-row:hover .drag-handle-cell {
    color: #3b82f6;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    initDragAndDrop();
  });

  document.addEventListener('turbo:load', function() {
    initDragAndDrop();
  });

  function initDragAndDrop() {
    const tbody = document.getElementById('sortableQuestionsBody');
    if (!tbody) return;

    let draggedRow = null;

    const rows = tbody.querySelectorAll('.draggable-row');
    rows.forEach(row => {
      row.addEventListener('dragstart', function(e) {
        draggedRow = this;
        this.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
      });

      row.addEventListener('dragend', function() {
        this.classList.remove('dragging');
        rows.forEach(r => r.classList.remove('drag-over'));
        updateRowNumbers();
        saveNewOrder();
      });

      row.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        if (this !== draggedRow) {
          this.classList.add('drag-over');
        }
      });

      row.addEventListener('dragleave', function() {
        this.classList.remove('drag-over');
      });

      row.addEventListener('drop', function(e) {
        e.preventDefault();
        this.classList.remove('drag-over');

        if (draggedRow && draggedRow !== this) {
          const allRows = Array.from(tbody.querySelectorAll('.draggable-row'));
          const draggedIndex = allRows.indexOf(draggedRow);
          const targetIndex = allRows.indexOf(this);

          if (draggedIndex < targetIndex) {
            this.after(draggedRow);
          } else {
            this.before(draggedRow);
          }
        }
      });
    });
  }

  function updateRowNumbers() {
    const rows = document.querySelectorAll('#sortableQuestionsBody .draggable-row');
    rows.forEach((row, index) => {
      const indexCell = row.querySelector('.row-index-cell');
      if (indexCell) {
        indexCell.textContent = index + 1;
      }
    });
  }

  function saveNewOrder() {
    const rows = document.querySelectorAll('#sortableQuestionsBody .draggable-row');
    const questionIds = Array.from(rows).map(row => row.getAttribute('data-question-id'));

    if (questionIds.length === 0) return;

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    const statusBadge = document.getElementById('reorderStatusBadge');

    fetch('<%= reorder_institute_admin_questions_path %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ question_ids: questionIds })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'success') {
        if (statusBadge) {
          statusBadge.classList.remove('d-none');
          statusBadge.classList.add('d-flex');
          setTimeout(() => {
            statusBadge.classList.remove('d-flex');
            statusBadge.classList.add('d-none');
          }, 3000);
        }
      }
    })
    .catch(err => {
      console.error('Failed to save question order:', err);
    });
  }
</script>