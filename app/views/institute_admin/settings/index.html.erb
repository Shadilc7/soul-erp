<% content_for :styles do %>
  <style>
    .settings-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.8);
      border-radius: 20px;
      padding: 1.85rem;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      position: relative;
      overflow: hidden;
    }

    .settings-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: transparent;
      transition: background 0.3s ease;
    }

    .settings-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
      border-color: rgba(199, 210, 254, 0.6);
    }

    .settings-card-sections:hover::before { background: linear-gradient(90deg, #10b981, #059669); }
    .settings-card-general:hover::before { background: linear-gradient(90deg, #3b82f6, #1d4ed8); }
    .settings-card-trainers:hover::before { background: linear-gradient(90deg, #8b5cf6, #6d28d9); }
    .settings-card-participants:hover::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .settings-card-programs:hover::before { background: linear-gradient(90deg, #ec4899, #be185d); }

    .icon-wrapper {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.65rem;
      margin-bottom: 1.25rem;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .settings-card:hover .icon-wrapper {
      transform: scale(1.1) rotate(-4deg);
    }

    .icon-sections { background: #ecfdf5; color: #10b981; }
    .icon-general { background: #eff6ff; color: #3b82f6; }
    .icon-trainers { background: #f5f3ff; color: #8b5cf6; }
    .icon-participants { background: #fffbeb; color: #f59e0b; }
    .icon-programs { background: #fdf2f8; color: #ec4899; }

    .settings-card h4 {
      font-weight: 700;
      color: #0f172a;
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }

    .settings-card p {
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .btn-settings-action {
      border-radius: 12px;
      padding: 0.65rem 1.25rem;
      font-weight: 600;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.25s ease;
      width: 100%;
      text-decoration: none;
    }

    .btn-sections { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .btn-sections:hover { background: #10b981; color: #ffffff; border-color: #10b981; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }

    .btn-general { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .btn-general:hover { background: #3b82f6; color: #ffffff; border-color: #3b82f6; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); }

    .btn-trainers { background: #f5f3ff; color: #6d28d9; border: 1px solid #ddd6fe; }
    .btn-trainers:hover { background: #8b5cf6; color: #ffffff; border-color: #8b5cf6; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3); }

    .btn-participants { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .btn-participants:hover { background: #f59e0b; color: #ffffff; border-color: #f59e0b; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); }

    .btn-programs { background: #fdf2f8; color: #be185d; border: 1px solid #fbcfe8; }
    .btn-programs:hover { background: #ec4899; color: #ffffff; border-color: #ec4899; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3); }
  </style>
<% end %>

<div class="container-fluid px-4 py-4">
  <!-- BREADCRUMBS & PAGE HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom mb-1">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door me-1"></i>Home<% end %></li>
          <li class="breadcrumb-item active" aria-current="page">Settings</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0">Institute Control & Configuration</h3>
    </div>
  </div>

  <!-- CONTROL CARDS GRID -->
  <div class="row g-4">
    <!-- Sections & Batches -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="settings-card settings-card-sections">
        <div>
          <div class="icon-wrapper icon-sections">
            <i class="bi bi-grid-3x3"></i>
          </div>
          <h4>Sections & Batches</h4>
          <p>Organize institute student batches, capacity limits, and assign section codes.</p>
        </div>
        <%= link_to institute_admin_sections_path, class: "btn-settings-action btn-sections" do %>
          <span>Manage Sections</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- General Institute Settings -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="settings-card settings-card-general">
        <div>
          <div class="icon-wrapper icon-general">
            <i class="bi bi-sliders"></i>
          </div>
          <h4>General Settings</h4>
          <p>Configure institute preferences, brand details, default rules, and portal settings.</p>
        </div>
        <%= link_to institute_admin_general_settings_path, class: "btn-settings-action btn-general" do %>
          <span>Configure Settings</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Trainers Management -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="settings-card settings-card-trainers">
        <div>
          <div class="icon-wrapper icon-trainers">
            <i class="bi bi-person-badge"></i>
          </div>
          <h4>Trainers & Faculty</h4>
          <p>Manage trainer accounts, credentials, and course allocations across sections.</p>
        </div>
        <%= link_to institute_admin_trainers_path, class: "btn-settings-action btn-trainers" do %>
          <span>Manage Trainers</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Participants Directory -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="settings-card settings-card-participants">
        <div>
          <div class="icon-wrapper icon-participants">
            <i class="bi bi-people"></i>
          </div>
          <h4>Participants Directory</h4>
          <p>Review student registrations, section enrollments, and status approvals.</p>
        </div>
        <%= link_to institute_admin_participants_path, class: "btn-settings-action btn-participants" do %>
          <span>Manage Participants</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>

    <!-- Training Programs -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="settings-card settings-card-programs">
        <div>
          <div class="icon-wrapper icon-programs">
            <i class="bi bi-journal-bookmark"></i>
          </div>
          <h4>Training Programs</h4>
          <p>Overview active training curricula, feedback modules, and attendance logs.</p>
        </div>
        <%= link_to institute_admin_training_programs_path, class: "btn-settings-action btn-programs" do %>
          <span>View Programs</span>
          <i class="bi bi-arrow-right fs-6"></i>
        <% end %>
      </div>
    </div>
  </div>
</div>