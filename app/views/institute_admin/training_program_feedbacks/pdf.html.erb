<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Training Program Feedback Report - <%= training_program.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Malayalam:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Inter', 'Noto Sans Malayalam', -apple-system, sans-serif;
      color: #1e293b;
      background-color: #ffffff;
      padding: 24px;
      font-size: 11px;
      line-height: 1.5;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /* HEADER HERO BAR */
    .hero-banner {
      background: linear-gradient(135deg, #4f46e5 0%, #1e1b4b 100%);
      color: #ffffff;
      padding: 20px 24px;
      border-radius: 12px;
      margin-bottom: 24px;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);
    }

    .hero-table {
      width: 100%;
      border-collapse: collapse;
    }

    .hero-title {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      margin-bottom: 4px;
    }

    .hero-subtitle {
      font-size: 13px;
      color: #c7d2fe;
      font-weight: 500;
    }

    .hero-badge {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 9999px;
      font-weight: 700;
      font-size: 11px;
    }

    /* KPI METRICS GRID */
    .kpi-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 12px 0;
      margin-left: -12px;
      margin-right: -12px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 14px 16px;
    }

    .kpi-card-indigo {
      background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
      border: 1px solid #c7d2fe;
    }

    .kpi-card-amber {
      background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
      border: 1px solid #fde68a;
    }

    .kpi-card-emerald {
      background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
      border: 1px solid #a7f3d0;
    }

    .kpi-card-blue {
      background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
      border: 1px solid #bae6fd;
    }

    .kpi-label {
      font-size: 9.5px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #475569;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .kpi-value {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
    }

    /* DATA TABLE */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
    }

    .data-table th {
      background-color: #1e293b;
      color: #f8fafc;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      text-align: left;
      padding: 11px 14px;
    }

    .data-table td {
      padding: 12px 14px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
      background-color: #ffffff;
    }

    .data-table tr:nth-child(even) td {
      background-color: #f8fafc;
    }

    /* BADGES & RATING STYLING */
    .user-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: capitalize;
    }

    .badge-student {
      background-color: #4f46e5;
      color: #ffffff;
    }

    .badge-guardian {
      background-color: #d97706;
      color: #ffffff;
    }

    .badge-employee {
      background-color: #0284c7;
      color: #ffffff;
    }

    .rating-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      background-color: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 6px;
      color: #b45309;
      font-weight: 700;
      font-size: 11px;
    }

    .rating-stars {
      color: #f59e0b;
      font-weight: 700;
      margin-right: 4px;
    }

    /* FEEDBACK QUOTE BOX */
    .feedback-box {
      background-color: #f1f5f9;
      border-left: 4px solid #4f46e5;
      padding: 10px 14px;
      border-radius: 0 6px 6px 0;
      font-size: 11px;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
      color: #0f172a;
      font-weight: 500;
    }

    .footer-section {
      margin-top: 36px;
      padding-top: 14px;
      border-top: 2px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: #64748b;
      font-weight: 500;
    }

    @page {
      size: A4;
      margin: 10mm;
    }
  </style>
</head>
<body>

  <!-- HERO HEADER -->
  <div class="hero-banner">
    <table class="hero-table">
      <tr>
        <td style="vertical-align: middle;">
          <div class="hero-title">Training Program Feedback Report</div>
          <div class="hero-subtitle">Program: <%= training_program.title %></div>
        </td>
        <td style="text-align: right; vertical-align: middle;">
          <div class="hero-badge"><%= training_program.institute&.name || "Soul ERP" %></div>
          <div style="font-size: 10.5px; color: #e0e7ff; margin-top: 6px;">
            Generated: <%= Time.current.strftime("%B %d, %Y") %>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <!-- KPI SUMMARY ROW -->
  <table class="kpi-table">
    <tr>
      <td style="width: 25%;">
        <div class="kpi-card kpi-card-indigo">
          <div class="kpi-label" style="color: #3730a3;">Total Feedbacks</div>
          <div class="kpi-value" style="color: #1e1b4b;"><%= total_count %></div>
        </div>
      </td>
      <td style="width: 25%;">
        <div class="kpi-card kpi-card-amber">
          <div class="kpi-label" style="color: #92400e;">Average Rating</div>
          <div class="kpi-value" style="color: #78350f;"><%= avg_rating %> ★</div>
        </div>
      </td>
      <td style="width: 25%;">
        <div class="kpi-card kpi-card-emerald">
          <div class="kpi-label" style="color: #065f46;">5-Star Reviews</div>
          <div class="kpi-value" style="color: #064e3b;"><%= five_star_count %></div>
        </div>
      </td>
      <td style="width: 25%;">
        <div class="kpi-card kpi-card-blue">
          <div class="kpi-label" style="color: #075985;">User Categories</div>
          <div class="kpi-value" style="color: #0c4a6e;"><%= participant_types_count %></div>
        </div>
      </td>
    </tr>
  </table>

  <!-- DATA TABLE -->
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 4%; text-align: center;">#</th>
        <th style="width: 24%;">Participant Details</th>
        <th style="width: 14%;">User Type</th>
        <th style="width: 16%;">Rating</th>
        <th style="width: 42%;">Feedback Comment</th>
      </tr>
    </thead>
    <tbody>
      <% if feedbacks.empty? %>
        <tr>
          <td colspan="5" style="text-align: center; padding: 28px; color: #64748b; font-weight: 500;">
            No feedback entries found matching the report criteria.
          </td>
        </tr>
      <% else %>
        <% feedbacks.each_with_index do |fb, idx| %>
          <% 
            participant = fb.participant
            user = participant&.user
            user_type = participant&.participant_type.presence || 'student'
          %>
          <tr>
            <td style="text-align: center; font-weight: 700; color: #64748b;"><%= idx + 1 %></td>
            <td>
              <div style="font-weight: 700; color: #0f172a; font-size: 11.5px;"><%= user&.full_name.presence || "Unknown User" %></div>
              <div style="font-size: 10px; color: #64748b; margin-top: 2px;"><%= user&.email.presence || participant&.phone_number %></div>
            </td>
            <td>
              <% case user_type.downcase %>
              <% when 'student' %>
                <span class="user-badge badge-student">Student</span>
              <% when 'guardian' %>
                <span class="user-badge badge-guardian">Guardian</span>
              <% when 'employee' %>
                <span class="user-badge badge-employee">Employee</span>
              <% else %>
                <span class="user-badge" style="background-color: #64748b; color: #ffffff;"><%= user_type.titleize %></span>
              <% end %>
            </td>
            <td>
              <div class="rating-badge">
                <span class="rating-stars">
                  <% fb.rating.times do %>★<% end %><% (5 - fb.rating).times do %>☆<% end %>
                </span>
                <span><%= fb.rating %>.0</span>
              </div>
            </td>
            <td>
              <div class="feedback-box">
                <%= fb.content %>
              </div>
              <div style="font-size: 9.5px; color: #94a3b8; margin-top: 5px; font-weight: 500;">
                Submitted on <%= fb.created_at.strftime("%b %d, %Y at %I:%M %p") %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <!-- FOOTER SECTION -->
  <div class="footer-section">
    <div>Soul ERP — Administrative Feedback Report</div>
    <div>Page 1 of 1</div>
  </div>

</body>
</html>
