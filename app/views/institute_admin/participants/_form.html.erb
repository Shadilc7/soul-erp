  function populateIaDistricts(state, selected) {
    var sel = document.getElementById('ia_district');
    if (!sel) return;
    var districts = SD[state] || [];
    sel.innerHTML = '<option value="">Select District</option>' +
      districts.map(function(d) {
        return '<option value="' + d + '"' + (d === selected ? ' selected' : '') + '>' + d + '</option>';
      }).join('');
  }

  document.addEventListener('DOMContentLoaded', function () {
    var stateEl   = document.getElementById('ia_state');
    var distEl    = document.getElementById('ia_district');
    var pinEl     = document.getElementById('ia_pin_code');
    var spinner   = document.getElementById('ia-pin-spinner');

    if (stateEl) {
      stateEl.addEventListener('change', function () {
        populateIaDistricts(this.value, '');
      });
      // On load: populate districts (handles validation re-render)
      if (stateEl.value) {
        var current = distEl ? (distEl.dataset.current || '') : '';
        populateIaDistricts(stateEl.value, current);
      }
    }

    if (pinEl) {
      pinEl.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '').substring(0, 6);
        if (this.value.length !== 6) return;
        var pin = this.value;
        if (spinner) spinner.classList.remove('d-none');
        fetch('https://api.postalpincode.in/pincode/' + pin)
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (spinner) spinner.classList.add('d-none');
            if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length) {
              var po       = data[0].PostOffice[0];
              var apiState = po.State;
              var apiDist  = po.District;
              if (stateEl) {
                var opt = Array.from(stateEl.options).find(function (o) {
                  return o.value.toLowerCase() === apiState.toLowerCase();
                });
                if (opt) stateEl.value = opt.value;
              }
              var matched = (SD[apiState] || []).find(function (d) {
                return d.toLowerCase() === apiDist.toLowerCase();
              }) || apiDist;
              populateIaDistricts(apiState, matched);
            }
          })
          .catch(function () { if (spinner) spinner.classList.add('d-none'); });
      });
    }
  });
}());
</script> 