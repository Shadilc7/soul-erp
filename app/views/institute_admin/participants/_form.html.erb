<%= form_with(model: [:institute_admin, @user], url: @user.persisted? ? institute_admin_participant_path(@user) : institute_admin_participants_path, local: true) do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <h6>Please fix the following errors:</h6>
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if !@user.new_record? && @user.participant.employee? %>
    <style>
      /* Force employee fields to be visible when editing an employee */
      .employee-field {
        display: block !important;
      }
    </style>
  <% end %>

  <% if !@user.new_record? && @user.participant.guardian? %>
    <style>
      /* Force guardian fields to be visible when editing a guardian */
      .guardian-field {
        display: block !important;
      }
    </style>
  <% end %>

  <%= f.hidden_field :section_id, id: 'user_section_id' %>

  <div class="row">
    <!-- Basic Information -->
    <div class="col-md-12 mb-3">
      <div class="form-group">
        <%= f.label :first_name, "Name", class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control", placeholder: "Enter name" %>
      </div>
    </div>

    <%= f.hidden_field :last_name, value: "" %>

    <div class="col-md-6 mb-3">
      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", placeholder: "Enter email" %>
      </div>
    </div>

    <% participant_form_id = SecureRandom.hex(8) %>
    <%= f.fields_for :participant do |participant_form| %>
      <% if !@user.new_record? && @user.participant.persisted? %>
        <%= participant_form.hidden_field :id, id: "user_participant_attributes_id_#{participant_form_id}" %>
      <% end %>
      
      <div class="col-md-6 mb-3">
        <div class="form-group">
          <label class="form-label">Phone Number</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted" style="width: 60px;">+91</span>
            <%= participant_form.text_field :phone_number, 
                class: "form-control #{'is-invalid' if participant_form.object.errors[:phone_number].any?}", 
                placeholder: "Enter 10-digit number" %>
            <% if participant_form.object.errors[:phone_number].any? %>
              <div class="invalid-feedback">
                <%= participant_form.object.errors[:phone_number].first %>
              </div>
            <% end %>
          </div>
          <small class="text-muted">Enter 10 digits without country code</small>
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <div class="form-group">
          <%= participant_form.label :date_of_birth, class: "form-label" %>
          <%= participant_form.date_field :date_of_birth, class: "form-control" %>
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <div class="form-group">
          <%= participant_form.label :enrollment_date, "Enrollment Date", class: "form-label" %>
          <%= participant_form.date_field :enrollment_date, class: "form-control", value: @user.participant.enrollment_date || Date.current %>
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <div class="form-group">
          <%= participant_form.label :participant_type, "Participant Type", class: "form-label" %>
          <%= participant_form.select :participant_type, 
              [['Student', 'student'], ['Guardian', 'guardian'], ['Employee', 'employee']],
              { prompt: "Select Type" }, 
              { class: "form-select", id: "participant_type_select", onchange: "toggleParticipantFields()" } %>
        </div>
      </div>

      <!-- Section and Student Selection -->
      <div class="col-md-6 mb-3 section-field">
        <div class="form-group">
          <%= participant_form.label :section_id, "Section", class: "form-label" %>
          <%= participant_form.collection_select :section_id, 
              @sections, :id, :name,
              { prompt: "Select Section" }, 
              { class: "form-select", 
                id: "participant_section_select",
                onchange: "handleSectionChange(this.value)" } %>
        </div>
      </div>

      <!-- Employee-specific fields -->
      <div class="col-md-4 mb-3 employee-field" style="display: <%= @user&.participant&.employee? ? 'block' : 'none' %>;">
        <div class="form-group">
          <%= participant_form.label :job_role, "Job Role", class: "form-label" %>
          <%= participant_form.text_field :job_role, class: "form-control", placeholder: "Enter job role" %>
        </div>
      </div>

      <div class="col-md-4 mb-3 employee-field" style="display: <%= @user&.participant&.employee? ? 'block' : 'none' %>;">
        <div class="form-group">
          <%= participant_form.label :qualification, "Qualification", class: "form-label" %>
          <%= participant_form.text_field :qualification, class: "form-control", placeholder: "Enter qualification" %>
        </div>
      </div>

      <div class="col-md-4 mb-3 employee-field" style="display: <%= @user&.participant&.employee? ? 'block' : 'none' %>;">
        <div class="form-group">
          <%= participant_form.label :years_of_experience, "Experience (Years)", class: "form-label" %>
          <%= participant_form.number_field :years_of_experience, class: "form-control", min: 0, placeholder: "Enter years" %>
        </div>
      </div>

      <div class="col-md-12 mb-3 guardian-field" style="display: <%= @user&.participant&.guardian? ? 'block' : 'none' %>;">
        <div class="form-group">
          <label class="form-label fw-semibold">Linked Students</label>

          <!-- Section pick — triggers student list load for guardian -->
          <div class="mb-3">
            <label class="form-label text-muted small">Filter by Section</label>
            <select id="guardian_section_filter" class="form-select form-select-sm"
                    onchange="loadStudentsForGuardian(this.value)">
              <option value=""> Select a section </option>
              <% @sections.each do |s| %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% end %>
            </select>
          </div>

          <!-- Student checklist (populated via JS) -->
          <div id="guardian_students_container"
               style="max-height:260px;overflow-y:auto;border:1px solid #dee2e6;border-radius:8px;padding:10px;background:#fafafa;">
            <% if @linked_student_ids.present? %>
              <%# Preload existing students for edit page %>
              <% existing_students = Participant.where(id: @linked_student_ids).includes(:user, :section) %>
              <% existing_students.each do |st| %>
                <div class="form-check mb-2">
                  <input class="form-check-input student-checkbox" type="checkbox"
                         name="user[student_participant_ids][]"
                         value="<%= st.id %>"
                         id="student_<%= st.id %>"
                         checked>
                  <label class="form-check-label" for="student_<%= st.id %>">
                    <span class="fw-medium"><%= st.user.full_name %></span>
                    <small class="text-muted">— <%= st.section&.name || "No section" %></small>
                  </label>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted small mb-0" id="guardian_students_placeholder">
                Select a section above to see available students.
              </p>
            <% end %>
          </div>

          <%# Hidden field ensures an empty array is submitted when no checkboxes are checked %>
          <input type="hidden" name="user[student_participant_ids][]" value="">
        </div>
      </div>

      <!-- Address Information -->
      <div class="col-md-12 mb-2">
        <div class="form-group">
          <%= participant_form.label :address_line1, "Address Line 1", class: "form-label" %>
          <%= participant_form.text_field :address_line1,
              class: "form-control #{'is-invalid' if participant_form.object.errors[:address_line1].any?}",
              placeholder: "House / Flat No., Building Name" %>
          <% if participant_form.object.errors[:address_line1].any? %>
            <div class="invalid-feedback"><%= participant_form.object.errors[:address_line1].first %></div>
          <% end %>
          <small class="text-muted">House / Flat No., Building Name</small>
        </div>
      </div>

      <div class="col-md-12 mb-2">
        <div class="form-group">
          <%= participant_form.label :address_line2, "Address Line 2 (Optional)", class: "form-label" %>
          <%= participant_form.text_field :address_line2,
              class: "form-control",
              placeholder: "Street, Locality, Area" %>
          <small class="text-muted">Street, Locality, Area</small>
        </div>
      </div>

      <div class="col-md-12 mb-3">
        <div class="form-group">
          <%= participant_form.label :place, "Place / Town", class: "form-label" %>
          <%= participant_form.text_field :place,
              class: "form-control #{'is-invalid' if participant_form.object.errors[:place].any?}",
              placeholder: "Enter place or town" %>
          <% if participant_form.object.errors[:place].any? %>
            <div class="invalid-feedback"><%= participant_form.object.errors[:place].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <div class="form-group">
            <%= participant_form.label :pin_code, "PIN Code", class: "form-label" %>
            <div class="position-relative">
              <%= participant_form.text_field :pin_code,
                  id: "ia_pin_code",
                  class: "form-control",
                  placeholder: "6-digit PIN",
                  maxlength: 6,
                  inputmode: "numeric",
                  pattern: "[0-9]{6}" %>
              <span id="ia-pin-spinner" class="d-none position-absolute top-50 end-0 translate-middle-y me-2">
                <span class="spinner-border spinner-border-sm text-success" role="status"></span>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="form-group">
            <%= participant_form.label :state, "State", class: "form-label" %>
            <%= participant_form.select :state,
                options_for_select(["Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"].map { |s| [s, s] }, participant_form.object.state.presence || "Kerala"),
                { prompt: "Select State" },
                { class: "form-select", id: "ia_state" } %>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="form-group">
            <%= participant_form.label :district, "District", class: "form-label" %>
            <select name="user[participant_attributes][district]"
                    id="ia_district"
                    class="form-select"
                    data-current="<%= participant_form.object.district.to_s %>">
              <option value="">Select District</option>
            </select>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Move password fields to the end -->
    <div class="col-md-6 mb-3">
      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: "Enter password" %>
        <% if @user.new_record? %>
          <small class="text-muted">Minimum 6 characters</small>
        <% else %>
          <small class="text-muted">Leave blank if you don't want to change it</small>
        <% end %>
      </div>
    </div>

    <div class="col-md-6 mb-3">
      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm password" %>
      </div>
    </div>
  </div>

  <div class="form-actions mt-4 d-flex gap-2">
    <%= f.submit @user.new_record? ? "Create Participant" : "Update Participant", class: "btn btn-primary" %>
    <%= link_to "Cancel", institute_admin_participants_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<script>
  // IDs of students already linked (populated by server for edit page)
  const prelinkedStudentIds = new Set(<%= @linked_student_ids.to_json %>);

  function toggleParticipantFields() {
    const participantType = document.getElementById('participant_type_select').value;
    const guardianFields  = document.querySelectorAll('.guardian-field');
    const employeeFields  = document.querySelectorAll('.employee-field');

    employeeFields.forEach(f => f.style.display = 'none');
    guardianFields.forEach(f => f.style.display = 'none');

    if (participantType === 'employee') {
      employeeFields.forEach(f => f.style.display = 'block');
    } else if (participantType === 'guardian') {
      guardianFields.forEach(f => f.style.display = 'block');
      const guardianFilter = document.getElementById('guardian_section_filter');
      if (guardianFilter && guardianFilter.value) {
        loadStudentsForGuardian(guardianFilter.value);
      }
    }
  }
  
  function handleSectionChange(sectionId) {
    document.getElementById('user_section_id').value = sectionId;
    // Guardian student list uses its own filter dropdown — no action needed here
  }

  // Renders checkboxes for students in the chosen section.
  // Already-linked students (prelinkedStudentIds) and currently-checked items stay checked.
  function loadStudentsForGuardian(sectionId) {
    const container = document.getElementById('guardian_students_container');
    if (!container) return;

    if (!sectionId) {
      container.innerHTML = '<p class="text-muted small mb-0">Select a section above to see available students.</p>';
      return;
    }

    container.innerHTML = '<p class="text-muted small mb-0"><i class="bi bi-hourglass-split me-1"></i>Loading…</p>';

    fetch(`/institute_admin/sections/${sectionId}/participants.json`)
      .then(response => {
        if (!response.ok) throw new Error('Network error');
        return response.json();
      })
      .then(data => {
        if (!data.length) {
          container.innerHTML = '<p class="text-muted small mb-0">No students found in this section.</p>';
          return;
        }

        const currentlyChecked = new Set(
          [...document.querySelectorAll('.student-checkbox:checked')].map(el => parseInt(el.value))
        );

        container.innerHTML = '';
        data.forEach(student => {
          const checked = prelinkedStudentIds.has(student.id) || currentlyChecked.has(student.id);
          const div = document.createElement('div');
          div.className = 'form-check mb-2';
          div.innerHTML = `
            <input class="form-check-input student-checkbox" type="checkbox"
                   name="user[student_participant_ids][]"
                   value="${student.id}"
                   id="student_${student.id}"
                   ${checked ? 'checked' : ''}>
            <label class="form-check-label" for="student_${student.id}">
              <span class="fw-medium">${student.full_name || 'Student ' + student.id}</span>
            </label>`;
          container.appendChild(div);
        });
      })
      .catch(() => {
        container.innerHTML = '<p class="text-danger small mb-0">Failed to load students. Please try again.</p>';
      });
  }
  
  // Initialize fields on page load
  document.addEventListener('DOMContentLoaded', function() {
    <% if !@user.new_record? && @user.participant.participant_type.present? %>
      const participantTypeSelect = document.getElementById('participant_type_select');
      if (participantTypeSelect) {
        participantTypeSelect.value = '<%= @user.participant.participant_type %>';

        <% if @user.participant.employee? %>
          document.querySelectorAll('.employee-field').forEach(f => f.style.display = 'block');
        <% end %>

        <% if @user.participant.guardian? %>
          document.querySelectorAll('.guardian-field').forEach(f => f.style.display = 'block');
        <% end %>
      }
    <% end %>

    toggleParticipantFields();

    const participantTypeSelect = document.getElementById('participant_type_select');
    if (participantTypeSelect) {
      participantTypeSelect.addEventListener('change', toggleParticipantFields);
    }
  });
</script>

