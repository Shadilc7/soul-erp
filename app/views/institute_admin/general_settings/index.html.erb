<% content_for :styles do %>
  <style>
    .glass-form-card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(226, 232, 240, 0.8);
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .glass-form-card-header {
      padding: 1.25rem 1.5rem;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .glass-form-card-body {
      padding: 1.75rem;
    }

    .form-section-title {
      font-weight: 700;
      color: #0f172a;
      font-size: 1.05rem;
      margin-bottom: 0;
    }

    .custom-input {
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      transition: all 0.2s ease;
    }

    .custom-input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .form-label-custom {
      font-weight: 600;
      color: #334155;
      font-size: 0.875rem;
      margin-bottom: 0.4rem;
    }

    .logo-upload-zone {
      border: 2px dashed #cbd5e1;
      border-radius: 14px;
      padding: 1.5rem;
      text-align: center;
      background: #f8fafc;
      transition: all 0.2s ease;
    }

    .logo-upload-zone:hover {
      border-color: #6366f1;
      background: #f5f3ff;
    }

    .btn-save-settings {
      background: linear-gradient(135deg, #10b981 0%, #047857 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 0.75rem 2rem;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.25s ease;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-save-settings:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(16, 185, 129, 0.45);
      color: #ffffff;
    }
  </style>
<% end %>

<div class="container-fluid px-4 py-4">
  <!-- BREADCRUMBS & PAGE HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom mb-1">
          <li class="breadcrumb-item"><%= link_to institute_admin_root_path do %><i class="bi bi-house-door me-1"></i>Home<% end %></li>
          <li class="breadcrumb-item"><%= link_to "Settings", institute_admin_settings_path %></li>
          <li class="breadcrumb-item active" aria-current="page">General Settings</li>
        </ol>
      </nav>
      <h3 class="fw-bold text-dark mb-0">General Institute Settings</h3>
    </div>
    <div>
      <%= link_to institute_admin_settings_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm rounded-3 px-3 py-2 fw-medium" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Settings</span>
      <% end %>
    </div>
  </div>

  <%= form_with(model: @institute, url: institute_admin_general_settings_path, method: :patch, multipart: true, class: "needs-validation") do |form| %>
    <% if @institute.errors.any? %>
      <div class="alert alert-danger rounded-4 shadow-sm border-danger-subtle mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
          <h6 class="alert-heading fw-bold mb-0"><%= pluralize(@institute.errors.count, "error") %> prohibited saving these settings:</h6>
        </div>
        <ul class="mb-0 ps-4 small">
          <% @institute.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- SECTION 1: GENERAL & BRAND IDENTITY -->
    <div class="glass-form-card">
      <div class="glass-form-card-header">
        <i class="bi bi-building text-primary fs-5"></i>
        <h6 class="form-section-title">General & Brand Profile</h6>
      </div>
      <div class="glass-form-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-8">
            <div class="form-group">
              <%= form.label :name, "Institute Name", class: "form-label-custom" %>
              <%= form.text_field :name, class: "form-control custom-input", placeholder: "e.g. Acme Educational Institute" %>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="form-group">
              <%= form.label :code, "Tenant Code", class: "form-label-custom" %>
              <%= form.text_field :code, class: "form-control custom-input font-monospace", placeholder: "e.g. ACME-01" %>
            </div>
          </div>
          <div class="col-12">
            <div class="form-group">
              <%= form.label :description, "About / Summary Description", class: "form-label-custom" %>
              <%= form.text_area :description, rows: 2, class: "form-control custom-input", placeholder: "Brief description of the institute..." %>
            </div>
          </div>

          <!-- LOGO UPLOAD & PREVIEW -->
          <div class="col-12 mt-3">
            <label class="form-label-custom">Institute Logo</label>
            <div class="logo-upload-zone">
              <div class="d-flex flex-column align-items-center">
                <% if @institute.logo.attached? %>
                  <div class="mb-3 d-flex align-items-center gap-4 bg-white p-3 rounded-3 border">
                    <%= image_tag rails_blob_path(@institute.logo, only_path: true), alt: "Current logo",
                          style: "max-height:75px;max-width:180px;object-fit:contain;" %>
                    <div class="text-start">
                      <span class="badge bg-success-subtle text-success border border-success-subtle mb-1"><i class="bi bi-check-circle-fill me-1"></i>Active Logo</span>
                      <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" name="institute[remove_logo]" value="1" id="remove_logo">
                        <label class="form-check-label text-danger small fw-semibold" for="remove_logo">Remove logo file</label>
                      </div>
                    </div>
                  </div>
                <% end %>

                <div class="d-flex align-items-center gap-2 mb-2 text-primary">
                  <i class="bi bi-cloud-arrow-up fs-3"></i>
                  <span class="fw-semibold">Choose new logo image</span>
                </div>
                <%= form.file_field :logo, class: "form-control w-auto custom-input mb-2",
                      accept: "image/png,image/jpeg,image/gif,image/webp",
                      id: "logo_upload" %>
                <small class="text-muted">PNG, JPG or WEBP · Max 2 MB · Transparent background recommended (200×200 px)</small>
                
                <div class="mt-3" id="logo_preview_container" style="display:none;">
                  <span class="text-muted small d-block mb-1">New Upload Preview:</span>
                  <img id="logo_preview" src="#" alt="Preview"
                       style="max-height:80px;max-width:200px;object-fit:contain;border:1px solid #cbd5e1;border-radius:8px;padding:6px;background:#ffffff;">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 2: CONTACT & POINT OF CONTACT -->
    <div class="glass-form-card">
      <div class="glass-form-card-header">
        <i class="bi bi-telephone text-primary fs-5"></i>
        <h6 class="form-section-title">Contact & Governance</h6>
      </div>
      <div class="glass-form-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :email, "Official Email Address", class: "form-label-custom" %>
              <%= form.email_field :email, class: "form-control custom-input", placeholder: "contact@institute.edu" %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :contact_number, "Contact Phone Number", class: "form-label-custom" %>
              <%= form.text_field :contact_number, class: "form-control custom-input", placeholder: "+91 98765 43210" %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :registered_poc, "Registered Point of Contact (POC)", class: "form-label-custom" %>
              <%= form.text_field :registered_poc, class: "form-control custom-input", placeholder: "Full Name of POC" %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :owner_name, "Director / Owner Name", class: "form-label-custom" %>
              <%= form.text_field :owner_name, class: "form-control custom-input", placeholder: "Full Name of Director/Owner" %>
            </div>
          </div>
          <div class="col-12">
            <div class="form-group">
              <%= form.label :address, "Physical Office / Campus Address", class: "form-label-custom" %>
              <%= form.text_area :address, rows: 2, class: "form-control custom-input", placeholder: "Complete building address..." %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 3: SUBSCRIPTION & BILLING -->
    <div class="glass-form-card">
      <div class="glass-form-card-header">
        <i class="bi bi-credit-card text-primary fs-5"></i>
        <h6 class="form-section-title">Subscription & Billing Terms</h6>
      </div>
      <div class="glass-form-card-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <div class="form-group">
              <%= form.label :service_started_on, "Service Start Date", class: "form-label-custom" %>
              <%= form.date_field :service_started_on, class: "form-control custom-input" %>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="form-group">
              <%= form.label :expiry_date, "Subscription Expiry Date", class: "form-label-custom" %>
              <%= form.date_field :expiry_date, class: "form-control custom-input" %>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="form-group">
              <%= form.label :age_of_service, "Age of Service (Months/Years)", class: "form-label-custom" %>
              <%= form.number_field :age_of_service, class: "form-control custom-input" %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :billing_type, "Billing Cycle / Plan Type", class: "form-label-custom" %>
              <%= form.text_field :billing_type, class: "form-control custom-input", placeholder: "e.g. Monthly, Annual Pro, Lifetime" %>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-group">
              <%= form.label :other_details, "Additional Administrative Notes", class: "form-label-custom" %>
              <%= form.text_area :other_details, rows: 2, class: "form-control custom-input", placeholder: "Internal notes or billing remarks..." %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ACTION FOOTER BAR -->
    <div class="d-flex align-items-center justify-content-end gap-3 pt-2 pb-4">
      <%= link_to "Cancel", institute_admin_settings_path, class: "btn btn-outline-secondary px-4 rounded-3 py-2.5 fw-semibold" %>
      <%= form.submit "Save Settings", class: "btn btn-save-settings d-inline-flex align-items-center gap-2" %>
    </div>
  <% end %>
</div>

<script>
  document.getElementById('logo_upload')?.addEventListener('change', function() {
    const file = this.files[0];
    const container = document.getElementById('logo_preview_container');
    const preview = document.getElementById('logo_preview');
    if (file) {
      preview.src = URL.createObjectURL(file);
      container.style.display = 'block';
    } else {
      container.style.display = 'none';
    }
  });
</script>