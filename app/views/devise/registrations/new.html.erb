<div class="registration-wrapper" style="background: linear-gradient(135deg, #0a0f0d 0%, #1a3d2e 50%, #0a0f0d 100%) !important;">
  <!-- Animated Background -->
  <div class="animated-bg">
    <div class="geometric-shape shape-1"></div>
    <div class="geometric-shape shape-2"></div>
    <div class="geometric-shape shape-3"></div>
    <div class="geometric-shape shape-4"></div>
    <div class="light-beam beam-1"></div>
    <div class="light-beam beam-2"></div>
    <div class="particle particle-1"></div>
    <div class="particle particle-2"></div>
    <div class="particle particle-3"></div>
    <div class="particle particle-4"></div>
    <div class="particle particle-5"></div>
    <div class="particle particle-6"></div>
  </div>

  <div class="container">
    <div class="row justify-content-center min-vh-100 align-items-center py-5">
      <div class="col-12 col-md-10 col-lg-8 col-xl-7">
        <!-- Header Section -->
        <div class="registration-header mb-4 d-flex justify-content-center">
          <h1 class="registration-title d-flex align-items-center">
            <div class="logo-badge me-3">
              <i class="bi bi-person-plus-fill"></i>
            </div>
            <span>Join <span class="gradient-text">BeYa</span></span>
          </h1>
        </div>

        <div class="registration-card">
          <div class="card-glow"></div>

          <div class="card-body p-4 p-md-5">
            <%= render "shared/error_messages", resource: resource %>
            
            <div class="info-banner">
              <div class="info-icon">
                <i class="bi bi-shield-check"></i>
              </div>
              <div class="info-content">
                <strong>Account Approval Required</strong>
                <p>All new registrations are reviewed before access is granted for security.</p>
              </div>
            </div>

            <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
              <!-- Personal Information Section -->
              <div class="form-section">
                <h5 class="section-title">
                  <i class="bi bi-person-circle"></i>
                  Personal Information
                </h5>
                
                <div class="form-floating mb-3">
                  <div class="input-icon">
                    <i class="bi bi-person"></i>
                  </div>
                  <%= f.text_field :first_name, 
                      class: "form-control icon-input #{resource.errors[:first_name].any? ? 'is-invalid' : ''}", 
                      placeholder: "Name",
                      required: true %>
                  <%= f.label :first_name, "Full Name" %>
                  <% if resource.errors[:first_name].any? %>
                    <div class="invalid-feedback"><%= resource.errors[:first_name].first %></div>
                  <% end %>
                </div>

                <div class="form-floating mb-3">
                  <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                  </div>
                  <%= f.email_field :email, 
                      class: "form-control icon-input #{resource.errors[:email].any? ? 'is-invalid' : ''}", 
                      placeholder: "Email" %>
                  <%= f.label :email, "Email Address" %>
                  <% if resource.errors[:email].any? %>
                    <div class="invalid-feedback"><%= resource.errors[:email].first %></div>
                  <% end %>
                </div>
              </div>

              <!-- Contact & Location Section -->
              <div class="form-section" data-controller="sections">
                <h5 class="section-title">
                  <i class="bi bi-geo-alt"></i>
                  Contact & Location
                </h5>
                
                <%= f.fields_for :participant do |p| %>
                  <div class="mb-3">
                    <div class="input-group">
                      <span class="input-group-text phone-prefix">
                        <i class="bi bi-telephone"></i>
                        <span>+91</span>
                      </span>
                      <div class="form-floating flex-grow-1">
                        <%= p.text_field :phone_number, 
                            class: "form-control #{p.object.errors[:phone_number].any? ? 'is-invalid' : ''}", 
                            placeholder: "Phone Number" %>
                        <%= p.label :phone_number, "Phone Number" %>
                        <% if p.object.errors[:phone_number].any? %>
                          <div class="invalid-feedback">
                            <%= p.object.errors[:phone_number].first %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                    <small class="form-hint">
                      <i class="bi bi-info-circle"></i>
                      Enter 10 digits without country code. At least one of Email or Phone is required.
                    </small>
                  </div>

                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-calendar-event"></i>
                    </div>
                    <%= p.date_field :date_of_birth, 
                        class: "form-control icon-input #{p.object.errors[:date_of_birth].any? ? 'is-invalid' : ''}", 
                        placeholder: "Date of Birth",
                        required: true %>
                    <%= p.label :date_of_birth, "Date of Birth" %>
                    <% if p.object.errors[:date_of_birth].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:date_of_birth].first %></div>
                    <% end %>
                  </div>

                  <%# ── Address Line 1 ── %>
                  <div class="form-floating mb-1">
                    <div class="input-icon">
                      <i class="bi bi-house-door"></i>
                    </div>
                    <%= p.text_field :address_line1,
                        class: "form-control icon-input #{p.object.errors[:address_line1].any? ? 'is-invalid' : ''}",
                        placeholder: "Address Line 1",
                        required: true %>
                    <%= p.label :address_line1, "Address Line 1" %>
                    <% if p.object.errors[:address_line1].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:address_line1].first %></div>
                    <% end %>
                  </div>
                  <small class="form-hint mb-3"><i class="bi bi-info-circle"></i> House / Flat No., Building Name</small>

                  <%# ── Address Line 2 ── %>
                  <div class="form-floating mb-1">
                    <div class="input-icon">
                      <i class="bi bi-signpost-split"></i>
                    </div>
                    <%= p.text_field :address_line2,
                        class: "form-control icon-input",
                        placeholder: "Address Line 2" %>
                    <%= p.label :address_line2, "Address Line 2 (Optional)" %>
                  </div>
                  <small class="form-hint mb-3"><i class="bi bi-info-circle"></i> Street, Locality, Area</small>

                  <%# ── Place / Town ── %>
                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-geo-alt"></i>
                    </div>
                    <%= p.text_field :place,
                        class: "form-control icon-input #{p.object.errors[:place].any? ? 'is-invalid' : ''}",
                        placeholder: "Place",
                        required: true %>
                    <%= p.label :place, "Place / Town / Village" %>
                    <% if p.object.errors[:place].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:place].first %></div>
                    <% end %>
                  </div>

                  <%# ── PIN Code + State ── %>
                  <div class="row g-3 mb-3">
                    <div class="col-md-6">
                      <div class="form-floating position-relative">
                        <div class="input-icon">
                          <i class="bi bi-mailbox"></i>
                        </div>
                        <%= p.text_field :pin_code,
                            class: "form-control icon-input #{p.object.errors[:pin_code].any? ? 'is-invalid' : ''}",
                            placeholder: "PIN Code",
                            id: "reg_pin_code",
                            maxlength: "6",
                            inputmode: "numeric",
                            required: true %>
                        <%= p.label :pin_code, "PIN Code" %>
                        <span id="pin-spinner" class="d-none" style="position:absolute;right:12px;top:18px;z-index:5;">
                          <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                        </span>
                        <% if p.object.errors[:pin_code].any? %>
                          <div class="invalid-feedback"><%= p.object.errors[:pin_code].first %></div>
                        <% end %>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-floating">
                        <div class="input-icon">
                          <i class="bi bi-map"></i>
                        </div>
                        <%= p.select :state,
                            options_for_select(["Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"].map { |s| [s, s] }, p.object.state.presence || "Kerala"),
                            { include_blank: "Select State" },
                            { class: "form-select icon-input #{p.object.errors[:state].any? ? 'is-invalid' : ''}",
                              id: "reg_state",
                              required: true } %>
                        <%= p.label :state, "State" %>
                        <% if p.object.errors[:state].any? %>
                          <div class="invalid-feedback"><%= p.object.errors[:state].first %></div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <%# ── District ── %>
                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-geo"></i>
                    </div>
                    <%= p.select :district,
                        options_for_select(p.object.district.present? ? [[p.object.district, p.object.district]] : []),
                        { include_blank: "Select District" },
                        { class: "form-select icon-input #{p.object.errors[:district].any? ? 'is-invalid' : ''}",
                          id: "reg_district",
                          data: { current: p.object.district.to_s },
                          required: true } %>
                    <%= p.label :district, "District" %>
                    <% if p.object.errors[:district].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:district].first %></div>
                    <% end %>
                  </div>

                  <!-- Academic Information Section -->
                  <h5 class="section-title mt-4">
                    <i class="bi bi-building"></i>
                    Academic Information
                  </h5>

                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-person-badge"></i>
                    </div>
                    <%= p.select :participant_type,
                        [['Student', 'student'], ['Guardian', 'guardian'], ['Employee', 'employee']],
                        { prompt: "Select Type" },
                        { class: "form-select icon-input #{p.object.errors[:participant_type].any? ? 'is-invalid' : ''}", required: true } %>
                    <%= p.label :participant_type, "Participant Type" %>
                    <% if p.object.errors[:participant_type].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:participant_type].first %></div>
                    <% end %>
                  </div>

                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-bank"></i>
                    </div>
                    <% if @institutes.any? %>
                      <%= p.select :institute_id, 
                          @institutes.map { |i| [i.name, i.id] }, 
                          { prompt: "Select Institution" },
                          { class: "form-select icon-input #{p.object.errors[:institute_id].any? ? 'is-invalid' : ''}", 
                            required: true,
                            data: { 
                              sections_target: "instituteSelect",
                              action: "change->sections#fetchSections"
                            }
                          } %>
                      <%= p.label :institute_id, "Institution" %>
                      <% if p.object.errors[:institute_id].any? %>
                        <div class="invalid-feedback"><%= p.object.errors[:institute_id].first %></div>
                      <% end %>
                    <% else %>
                      <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        No institutions are currently available for registration. Please contact the administrator.
                      </div>
                    <% end %>
                  </div>

                  <div class="form-floating mb-3">
                    <div class="input-icon">
                      <i class="bi bi-grid-3x3"></i>
                    </div>
                    <%= p.select :section_id, 
                        [], 
                        { prompt: "Select Section" },
                        { class: "form-select icon-input #{p.object.errors[:section_id].any? ? 'is-invalid' : ''}", 
                          data: { sections_target: "sectionSelect",
                                  preselected_section_id: p.object.section_id } } %>
                    <%= p.label :section_id, "Section" %>
                    <% if p.object.errors[:section_id].any? %>
                      <div class="invalid-feedback"><%= p.object.errors[:section_id].first %></div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Security Section -->
              <div class="form-section">
                <h5 class="section-title">
                  <i class="bi bi-shield-lock"></i>
                  Security
                </h5>
                
                <div class="form-floating position-relative <%= resource.errors[:password].any? ? 'mb-1' : 'mb-3' %>">
                  <div class="input-icon">
                    <i class="bi bi-lock"></i>
                  </div>
                  <%= f.password_field :password,
                      class: "form-control icon-input #{resource.errors[:password].any? ? 'is-invalid' : ''}",
                      placeholder: "Password",
                      id: "registration-password",
                      required: true %>
                  <button type="button" class="password-toggle" onclick="toggleRegistrationPassword('registration-password', 'toggle-icon-1')">
                    <i class="bi bi-eye-fill" id="toggle-icon-1"></i>
                  </button>
                  <%= f.label :password, "Password" %>
                  <% if resource.errors[:password].any? %>
                    <div class="invalid-feedback"><%= resource.errors[:password].first %></div>
                  <% end %>
                </div>
                <% if @minimum_password_length %>
                  <small class="form-hint mb-3">
                    <i class="bi bi-info-circle"></i>
                    Minimum <%= @minimum_password_length %> characters required
                  </small>
                <% end %>

                <div class="form-floating mb-4 position-relative">
                  <div class="input-icon">
                    <i class="bi bi-lock-fill"></i>
                  </div>
                  <%= f.password_field :password_confirmation, 
                      class: "form-control icon-input #{resource.errors[:password_confirmation].any? ? 'is-invalid' : ''}", 
                      placeholder: "Confirm Password",
                      id: "registration-password-confirmation",
                      required: true %>
                  <button type="button" class="password-toggle" onclick="toggleRegistrationPassword('registration-password-confirmation', 'toggle-icon-2')">
                    <i class="bi bi-eye-fill" id="toggle-icon-2"></i>
                  </button>
                  <%= f.label :password_confirmation, "Confirm Password" %>
                  <% if resource.errors[:password_confirmation].any? %>
                    <div class="invalid-feedback"><%= resource.errors[:password_confirmation].first %></div>
                  <% end %>
                </div>
              </div>

              <div class="form-actions">
                <%= f.submit "Create Account", class: "btn-register" %>
                <%= link_to new_user_session_path, class: "btn-login" do %>
                  <i class="bi bi-arrow-left"></i>
                  Already have an account? Login
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleRegistrationPassword(fieldId, iconId) {
  const passwordField = document.getElementById(fieldId);
  const toggleIcon = document.getElementById(iconId);
  
  if (passwordField.type === 'password') {
    passwordField.type = 'text';
    toggleIcon.classList.remove('bi-eye-fill');
    toggleIcon.classList.add('bi-eye-slash-fill');
  } else {
    passwordField.type = 'password';
    toggleIcon.classList.remove('bi-eye-slash-fill');
    toggleIcon.classList.add('bi-eye-fill');
  }
}

// Use event delegation — survives Turbo DOM replacements
document.addEventListener('change', function(e) {
  if (e.target.matches('select[name="user[participant_attributes][participant_type]"]')) {
    var sectionSelect = document.querySelector('select[name="user[participant_attributes][section_id]"]');
    if (!sectionSelect) return;
    var sectionField = sectionSelect.closest('.form-floating');
    if (!sectionField) return;
    sectionField.style.display = (e.target.value === 'guardian') ? 'none' : 'block';
  }
});
// Run on page load for initial state
(function() {
  var pt = document.querySelector('select[name="user[participant_attributes][participant_type]"]');
  if (pt) pt.dispatchEvent(new Event('change', {bubbles: true}));
})();
</script>

